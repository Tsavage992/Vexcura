<link rel="stylesheet" href="/s-13vep8.css"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Quiz","name":"Psychosocial Integrity NCLEX practice questions","url":"https://nclexsim.com/nclex-practice-questions/psychosocial-integrity","about":{"@type":"Thing","name":"NCLEX-RN"},"educationalLevel":"Nursing licensure exam preparation","inLanguage":"en-US","isAccessibleForFree":true,"hasPart":[{"@type":"Question","eduQuestionType":"Multiple choice","text":"A client with schizophrenia stands in the corner staring and doesn't respond to questions. What should the nurse do?","url":"https://nclexsim.com/nclex-questions/schizophrenia-stands-corner-staring-doesn-t-respond-psy4-018","acceptedAnswer":{"@type":"Answer","text":"Stay with the client, speak simply, and check physical needs","answerExplanation":{"@type":"Comment","text":"For a withdrawn or catatonic client, the nurse offers presence, uses short simple statements, and makes sure basic needs like nutrition, hydration, and toileting are met."}},"suggestedAnswer":[{"@type":"Answer","text":"Tell the client to stop acting strange"},{"@type":"Answer","text":"Leave the client alone until they talk"},{"@type":"Answer","text":"Demand an answer"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"An older client lives alone, has lost weight, and the home is cluttered with spoiled food. The client is alert and oriented. What should the nurse do?","url":"https://nclexsim.com/nclex-questions/older-lives-alone-lost-weight-home-cluttered-psy4-021","acceptedAnswer":{"@type":"Answer","text":"Assess the client's ability to care for self and refer to adult protective services or social services for possible self-neglect","answerExplanation":{"@type":"Comment","text":"Self-neglect is a form of elder mistreatment that can be reported. The nurse assesses safety and connects the client with resources while respecting autonomy."}},"suggestedAnswer":[{"@type":"Answer","text":"Ignore it because the client is competent"},{"@type":"Answer","text":"Force the client into a nursing home"},{"@type":"Answer","text":"Clean the house without asking"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"A client describes feeling detached from their body, as if watching themselves from outside. Which symptom is this?","url":"https://nclexsim.com/nclex-questions/describes-feeling-detached-body-if-watching-themselves-psy4-019","acceptedAnswer":{"@type":"Answer","text":"Depersonalization","answerExplanation":{"@type":"Comment","text":"Depersonalization is a sense of detachment from one's body or thoughts. It can occur with severe anxiety, trauma, or dissociative disorders."}},"suggestedAnswer":[{"@type":"Answer","text":"Delusion of grandeur"},{"@type":"Answer","text":"Hallucination"},{"@type":"Answer","text":"Flight of ideas"}]},{"@type":"Question","eduQuestionType":"Checkbox","text":"Which communication techniques are therapeutic? Select all that apply.","url":"https://nclexsim.com/nclex-questions/communication-techniques-therapeutic-select-all-apply-psy4-016","acceptedAnswer":[{"@type":"Answer","text":"Offering self, such as \"I'll stay with you\"","answerExplanation":{"@type":"Comment","text":"Open-ended questions, restating, and offering self encourage communication. Giving approval or disapproval and \"why\" questions can block communication or put clients on the defensive."}},{"@type":"Answer","text":"Restating the client's message","answerExplanation":{"@type":"Comment","text":"Open-ended questions, restating, and offering self encourage communication. Giving approval or disapproval and \"why\" questions can block communication or put clients on the defensive."}},{"@type":"Answer","text":"Using open-ended questions","answerExplanation":{"@type":"Comment","text":"Open-ended questions, restating, and offering self encourage communication. Giving approval or disapproval and \"why\" questions can block communication or put clients on the defensive."}}],"suggestedAnswer":[{"@type":"Answer","text":"Asking \"why\" questions to understand behavior"},{"@type":"Answer","text":"Giving approval, such as \"That's the right thing to do\""}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"A client has trouble coping after a job loss. Which action best supports healthy coping?","url":"https://nclexsim.com/nclex-questions/trouble-coping-job-loss-action-supports-healthy-psy4-020","acceptedAnswer":{"@type":"Answer","text":"Help the client identify supports and problem-solving steps","answerExplanation":{"@type":"Comment","text":"Supporting problem-solving, identifying strengths and supports, and exploring feelings promote adaptive coping."}},"suggestedAnswer":[{"@type":"Answer","text":"Tell the client not to worry"},{"@type":"Answer","text":"Tell the client to avoid talking about it"},{"@type":"Answer","text":"Encourage drinking alcohol to relax"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which finding in a young child may indicate sexual abuse?","url":"https://nclexsim.com/nclex-questions/finding-young-child-may-indicate-sexual-abuse-psy4-009","acceptedAnswer":{"@type":"Answer","text":"Age-inappropriate sexual knowledge or behavior","answerExplanation":{"@type":"Comment","text":"Sexual knowledge or behavior beyond the child's developmental level, genital injuries, and sudden behavior changes are concerning signs that warrant further evaluation and reporting."}},"suggestedAnswer":[{"@type":"Answer","text":"A scraped knee from a fall"},{"@type":"Answer","text":"Fear of the dark"},{"@type":"Answer","text":"Interest in playing doctor with a toy kit"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"How do most school-age children (about 9 to 10 years) understand death?","url":"https://nclexsim.com/nclex-questions/school-age-children-9-10-years-understand-death-psy4-012","acceptedAnswer":{"@type":"Answer","text":"Death is permanent and happens to everyone","answerExplanation":{"@type":"Comment","text":"By about age 9 or 10, most children understand that death is final, universal, and has causes."}},"suggestedAnswer":[{"@type":"Answer","text":"Death is temporary like sleep"},{"@type":"Answer","text":"Death only happens to bad people"},{"@type":"Answer","text":"They have no concept of death"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"A client recovering from a myocardial infarction asks when it's safe to resume sexual activity. Which response reflects current guidance?","url":"https://nclexsim.com/nclex-questions/recovering-myocardial-infarction-asks-s-safe-resume-psy4-013","acceptedAnswer":{"@type":"Answer","text":"It's generally reasonable once you can do mild to moderate activity, like climbing two flights of stairs, without symptoms","answerExplanation":{"@type":"Comment","text":"For uncomplicated MI, sexual activity is often reasonable about a week or more later if the client can do mild to moderate activity (3 to 5 METs) without symptoms. The nurse addresses sexuality openly as part of care."}},"suggestedAnswer":[{"@type":"Answer","text":"You can resume as soon as you get home"},{"@type":"Answer","text":"You should never have sex again"},{"@type":"Answer","text":"Ask your family instead"}]}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://nclexsim.com/"},{"@type":"ListItem","position":2,"name":"Practice questions","item":"https://nclexsim.com/nclex-practice-questions"},{"@type":"ListItem","position":3,"name":"Psychosocial Integrity","item":"https://nclexsim.com/nclex-practice-questions/psychosocial-integrity"}]}</script></head><body><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><style>@property --vxa{syntax:"<color>";inherits:true;initial-value:#4b4f86}@property --vxb{syntax:"<color