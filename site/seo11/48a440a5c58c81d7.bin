<title>NCLEX Pass Guarantee: Your Registration Fee Back (Terms)</title><meta name="description" content="Vexcura's NCLEX pass guarantee: meet every condition, don't pass your first attempt after signing, and get your registration fee back, up to $200. Full terms."><link rel="canonical" href="https://nclexsim.com/nclex-pass-guarantee">
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1"><meta name="theme-color" content="#103a4f">
<meta property="og:type" content="website"><meta property="og:locale" content="en_US"><meta property="og:site_name" content="Vexcura"><meta property="og:title" content="NCLEX Pass Guarantee: Your Registration Fee Back (Terms)"><meta property="og:description" content="Vexcura's NCLEX pass guarantee: meet every condition, don't pass your first attempt after signing, and get your registration fee back, up to $200. Full terms."><meta property="og:url" content="https://nclexsim.com/nclex-pass-guarantee"><meta property="og:image" content="https://nclexsim.com/og/testday.png"><meta property="og:image:type" content="image/png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="NCLEX Pass Guarantee: Your Registration Fee Back (Terms)">
