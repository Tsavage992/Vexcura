   <script>(function(){var s=document.querySelectorAll(".hm-shot"),i=0,t,run=!matchMedia("(prefers-reduced-motion:reduce)").matches,b=document.getElementById("hmpp");if(!s.length||!b)return;function go(n){s[i].classList.remove("on");i=(n+s.length)%s.length;s[i].classList.add("on")}function tick(){clearInterval(t);if(run)t=setInterval(function(){go(i+1)},5000);b.setAttribute("aria-label",run?"Pause slides":"Play slides");b.dataset.s=run?"1":"0"}document.getElementById("hmpv").onclick=function(){go(i-1);tick()};document.getElementById("hmnx").onclick=function(){go(i+1);tick()};b.onclick=function(){run=!run;tick()};tick()})();</script>
   <p class="ask-try" id="askhint"><span>Try:</span> <button type="button" class="chip" data-q="Antidote for heparin">Antidote for heparin</button><button type="button" class="chip" data-q="Normal potassium level">Normal potassium level</button><button type="button" class="chip" data-q="How do I read an ABG?">How do I read an ABG?</button><button type="button" class="chip" data-q="Which client do I see first?">Which client do I see first?</button><button type="button" class="chip" data-q="What is the Next Gen NCLEX?">What is the Next Gen NCLEX?</button><button type="button" class="chip" data-q="Free NCLEX practice exam">Free NCLEX practice exam</button></p>
   <p class="hm-go"><a class="btn" href="/app#signup" data-cta="home-hero">Create your free account</a><a class="arw" href="/for-nursing-schools" data-cta="home-schools">Vexcura for nursing schools<span aria-hidden="true"> &rarr;</span></a></p>
   <p class="hm-free-l"><b>Free for students and instructors, and it always will be.</b> <a href="#free" data-cta="home-free-why">Why it's free</a></p>
   <p class="hm-sub">AI answers are written only from Vexcura's own cited pages, NIH sources (MedlinePlus, StatPearls and practice-guideline abstracts in PubMed) and FDA drug labels. Every answer links to its source. No medication doses.</p>
  </div><a class="hm-new" href="/practice-charting-at-home" data-cta="home-new-pill"><b>New</b>Practice charting at home<span aria-hidden="true">›</span></a></div></section>

  <section class="hm-tasks hm-w" aria-labelledby="hmt"><div class="hm-one"><p class="hm-k">One place</p><h2 id="hmt">Stop studying from ten tabs.</h2><p>Practice questions, charting, lab values and study guides, connected in one place. Built on trusted nursing sources like the NCSBN test plan and the American Heart Association, and every answer shows where it came from.</p></div><div class="hm-tgrid">
   <a class="hm-task" href="/free-nclex-practice-exam"><b>Take a free NCLEX practice exam</b><span>85 to 150 adaptive items</span></a><a class="hm-task" href="/nclex-practice-questions"><b>Practice questions</b><span>All 8 NCLEX categories</span></a><a class="hm-task" href="/nclex-lab-values"><b>Lab values</b><span>Normal ranges and why they matter</span></a><a class="hm-task" href="/nclex-study-guides"><b>Study library</b><span>Free printable guides</span></a><a class="hm-task" href="/next-generation-nclex"><b>Next Generation NCLEX</b><span>Item types and case studies</span></a><a class="hm-task" href="/academic-ehr-for-nursing-students"><b>Practice charting</b><span>An Epic-style academic EHR</span></a>
  </div></section>

  <section class="hm-freep hm-w" id="free" aria-labelledby="hmf"><div class="hm-freep-in">
   <p class="hm-k">Our promise</p><h2 id="hmf">Free for students and instructors. Always.</h2>
   <p class="hm-freep-lead">You will never pay to study or teach on Vexcura. Schools and healthcare facilities pay for it, the same way a hospital pays for the charting system its nurses use.</p>
   <ul class="hm-freep-g"><li><b>No card</b><span>We never ask for a credit card, and there is nothing to cancel.</span></li><li><b>No trial clock</b><span>Your account does not run out after a week or a semester.</span></li><li><b>No paid upgrade</b><span>Students and instructors get the whole app. There is no premium version.</span></li><li><b>No school needed</b><span>Sign up on your own. Your school does not have to be a customer.</span></li></ul>
   <p class="hm-go"><a class="btn" href="/app#signup" data-cta="home-free">Create your free account</a><a class="arw" href="/for-nursing-schools#pricing" data-cta="home-free-schools">How schools pay<span aria-hidden="true"> &rarr;</span></a></p>
  </div></section>

  <section class="hm-rate" aria-labelledby="hmr"><div class="hm-w">
   <div class="hm-rate-top"><p class="hm-rate-n" aria-hidden="true">86.7%</p><div><p class="hm-k">The national NCLEX-RN first-time pass rate, 2025</p><h2 id="hmr">25,644 new nursing graduates didn't pass the NCLEX-RN on their first try last year.</h2><p>In 2025, 86.7% of first-time, U.S.-educated candidates passed. The rest finished nursing school and still couldn't start work as RNs, and a retake means more months of waiting and studying.</p></div></div>
   <h3>What we're doing about it</h3>
   <div class="hm-fix">
    <div><b>Practice is free.</b><p>Every nursing student gets the full practice exam and study tools at no cost, so price is never the reason someone walks in unprepared.</p></div>
    <div><b>Practice matches the real exam.</b><p>An adaptive exam of 85 to 150 items on a five-hour clock, with Next Generation NCLEX case studies and the same stopping rules.</p></div>
    <div><b>Weak spots show up early.</b><p>Results break down by all 8 client needs categories, then drills target exactly those topics.</p></div>
    <div><b>Schools can step in sooner.</b><p>Instructors see where each student stands and can assign remediation from the ATI, HESI, Kaplan or UWorld scores they already have.</p></div>
   </div>
   <p class="hm-src">Source: NCSBN, 2025 NCLEX Examination Statistics: 167,272 of 192,916 first-time, U.S.-educated NCLEX-RN candidates passed (86.7%). Vexcura is not affiliated with NCSBN.</p>
  </div></section>

  <section class="hm-hc hm-w" aria-labelledby="hmhc"><div class="hm-hc-g">
   <div><p class="hm-k">New: home practice patients</p><h2 id="hmhc">Practice charting at home.</h2><p>Take vital signs on family and friends who say it's OK, then chart them in the same Epic-style EHR you use for school cases.</p>
    <ul class="hm-hc-l"><li><b>Real charting.</b> Flowsheets, notes, a care plan and an SBAR handoff.</li><li><b>Instant feedback.</b> Each reading is checked against common ranges and the AHA blood pressure categories as you save it.</li><li><b>Nickname only, with their OK.</b> “Mom” or “Roommate” and an age range. No names, birthdays, medications or diagnoses.</li></ul>
    <div class="hm-hc-b"><a class="btn" href="/app#ehr" data-cta="home-hc-start">Start charting</a><a class="btn alt" href="/practice-charting-at-home" data-cta="home-hc-how">See how it works</a></div></div>
   <div class="hc-card" role="img" aria-label="Example of a home practice patient in the Vexcura EHR: Mom, parent, 50s, with a blood pressure of 128/78 flagged as AHA Elevated">
    <div class="hc-top"><span class="hc-av" aria-hidden="true">M</span><div><b>Mom</b><small>Parent · 50s · Home practice</small></div><span class="hc-tag">Home</span></div>
    <div class="hc-v"><div><small>BP</small><b>128/78</b></div><div><small>HR</small><b>72</b></div><div><small>RR</small><b>16</b></div><div><small>SpO₂</small><b>98%</b></div></div>
    <p class="hc-f">128/78 is AHA Elevated (120–129 and under 80).</p>
    <div class="hc-t"><span>Summary</span><span>Flowsheet</span><span>Notes</span><span>Care plan</span><span>Handoff</span></div></div>
  </div></section>

  <section class="hm-stack hm-w" aria-label="What Vexcura does">
   <article><div><p class="hm-k">Practice exam</p><h2>Sit the whole NCLEX&#8209;RN before test day.</h2><p>An adaptive practice exam of 85 to 150 items on a five-hour clock, with Next Generation NCLEX case studies and the same stopping rules as the real exam.</p><a class="arw" href="/free-nclex-practice-exam">Learn more<span aria-hidden="true"> &rarr;</span></a></div><figure class="hm-fimg"><img src="/img/exam-results-1600.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="A Vexcura practice exam results screen with a pass-likelihood estimate"></figure></article>
   <article><div><p class="hm-k">Practice EHR</p><h2>Chart in an Epic-style EHR before your first clinical.</h2><p>My Chart, a MAR on a time ruler, flowsheets, orders, LDAs, care plans and handoff, all on made-up practice patients.</p><a class="arw" href="/academic-ehr-for-nursing-students">Learn more<span aria-hidden="true"> &rarr;</span></a></div><figure class="hm-fimg"><img src="/img/ehr-grid-1600.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="Vital signs charted in a flowsheet in Vexcura's practice EHR"></figure></article>
   <article><div><p class="hm-k">Simulations</p><h2>Practice on patients who get worse if you wait.</h2><p>Deteriorating-patient drills, telemetry, ACLS megacodes and SBAR to a simulated provider, with a debrief scored by competency.</p><a class="arw" href="/nursing-simulation-scenarios">Learn more<span aria-hidden="true"> &rarr;</span></a></div><figure class="hm-fimg"><img src="/img/drills-run-1600.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="A deteriorating-patient drill running in Vexcura"></figure></article>
  </section>

  <section class="hm-sw hm-w" aria-labelledby="hmsw"><div class="hm-ic"><svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="12" width="40" height="30" rx="3"/><path d="M6 20h40M14 30h6l3-5 4 10 3-5h8"/><rect x="38" y="28" width="20" height="28" rx="3"/><path d="M44 50h8"/><path d="M18 50h14M25 42v8"/></svg></div><div>
   <h2 id="hmsw">Our software</h2><p>One platform a nursing program can run on: the academic EHR, a bank of 1,220 cited NCLEX-RN questions with 8 NGN case studies, clinical simulations, and the tools instructors use for clinical days, grading and board compliance.</p>
   <a class="arw" href="/software">Learn more about our software<span aria-hidden="true"> &rarr;</span></a></div></section>

  <section class="hm-co hm-w" aria-labelledby="hmco"><div class="hm-hd"><h2 id="hmco">Who's behind Vexcura</h2><a class="arw" href="/about">About us<span aria-hidden="true"> &rarr;</span></a></div>
   <div class="hm-co-g">
    <div class="hm-fdr"><div class="hm-av" aria-hidden="true">TS</div><div><h3>Tyler Savage, RN, CRS, LNC</h3><p class="hm-k">Founder</p><p>A registered nurse with more than a decade at the bedside in medical-surgical, step-down, long-term acute care and rehabilitation units in Georgia and Tennessee. Charge nurse, house supervisor, preceptor and safety officer, on code and rapid response teams. He has charted in Epic, Cerner (Oracle Health), MEDITECH and ProTouch, and holds ACLS, BLS and NIH Stroke Scale certifications.</p></div></div>
    <dl class="hm-facts">
     <div><dt>Company</dt><dd>Vexcura LLC, a Georgia limited liability company</dd></div>
     <div><dt>Headquarters</dt><dd>27 General Cleburne St.<br>Ringgold, GA 30736</dd></div>
     <div><dt>Phone</dt><dd><a href="tel:+17626772802">(762) 677-2802</a></dd></div>
    </dl>
   </div>
   <h3 class="hm-tech-h">The technology</h3>
   <div class="hm-tech">
    <div><b>A worldwide network</b><p>Vexcura runs on Cloudflare's global network, so each page loads from a data center near the student.</p></div>
    <div><b>Encrypted in transit</b><p>Every connection to vexcura.com uses HTTPS, and sign-in cookies are secure and HTTP-only.</p></div>
    <div><b>Records kept like a hospital's</b><p>Changes to charts and school records keep an audit trail, and mistakes are marked "in error" instead of deleted.</p></div>
    <div><b>Built on Starlink</b><p>Vexcura is built and run from our office in Ringgold, Georgia, which is connected by Starlink satellite internet.</p></div>
   </div>
   <p class="hm-links"><a class="arw" href="/status">Live system status<span aria-hidden="true"> &rarr;</span></a><a class="arw" href="/about">Our story<span aria-hidden="true"> &rarr;</span></a></p>
  </section>

  <section class="hm-sec hm-w" aria-labelledby="hmlib"><div class="hm-hd"><h2 id="hmlib">From the study library</h2><a class="arw" href="/nclex-study-guides">See every guide<span aria-hidden="true"> &rarr;</span></a></div>
   <div class="hm-cards"><article class="hm-card"><a href="/study-guides/abg-interpretation" tabindex="-1" aria-hidden="true"><div class="hm-cv" style="--cv:#1d5670" aria-hidden="true"><span>Study guide</span><b>ABG interpretation</b><i>vexcura.com</i></div></a><h3><a href="/study-guides/abg-interpretation">ABG interpretation</a></h3><p>Read any blood gas in four steps, with compensation and the patterns the NCLEX likes to test.</p><a class="arw" href="/study-guides/abg-interpretation">Read the guide<span aria-hidden="true"> &rarr;</span></a></article><article class="hm-card"><a href="/study-guides/electrolyte-imbalances" tabindex="-1" aria-hidden="true"><div class="hm-cv" style="--cv:#7a3b52" aria-hidden="true"><span>Study guide</span><b>Electrolyte imbalances</b><i>vexcura.com</i></div></a><h3><a href="/study-guides/electrolyte-imbalances">Electrolyte imbalances</a></h3><p>Sodium, potassium, calcium and magnesium: what each imbalance looks like and what the nurse does first.</p><a class="arw" href="/study-guides/electrolyte-imbalances">Read the guide<span aria-hidden="true"> &rarr;</span></a></article><article class="hm-card"><a href="/study-guides/prioritization-and-delegation" tabindex="-1" aria-hidden="true"><div class="hm-cv" style="--cv:#3d5a3a" aria-hidden="true"><span>Study guide</span><b>Prioritization and delegation</b><i>vexcura.com</i></div></a><h3><a href="/study-guides/prioritization-and-delegation">Prioritization and delegation</a></h3><p>Who you see first, and who can safely do what: the rules behind the hardest questions on the exam.</p><a class="arw" href="/study-guides/prioritization-and-delegation">Read the guide<span aria-hidden="true"> &rarr;</span></a></article></div></section>

  <section class="hm-sec hm-w" aria-labelledby="hmq"><div class="hm-hd"><h2 id="hmq">Practice questions</h2><a class="arw" href="/nclex-practice-questions">All 8 categories<span aria-hidden="true"> &rarr;</span></a></div>
   <div class="hm-cards"><article class="hm-qc"><div class="hm-bar" aria-hidden="true"><i style="width:84%"></i></div><p class="hm-k">15&ndash;21% of the NCLEX-RN</p><h3><a href="/nclex-practice-questions/management-of-care">Management of Care</a></h3><a class="arw" href="/nclex-practice-questions/management-of-care">Practice free questions<span aria-hidden="true"> &rarr;</span></a></article><article class="hm-qc"><div class="hm-bar" aria-hidden="true"><i style="width:76%"></i></div><p class="hm-k">13&ndash;19% of the NCLEX-RN</p><h3><a href="/nclex-practice-questions/pharmacology">Pharmacological and Parenteral Therapies</a></h3><a class="arw" href="/nclex-practice-questions/pharmacology">Practice free questions<span aria-hidden="true"> &rarr;</span></a></article><article class="hm-qc"><div class="hm-bar" aria-hidden="true"><i style="width:68%"></i></div><p class="hm-k">11&ndash;17% of the NCLEX-RN</p><h3><a href="/nclex-practice-questions/physiological-adaptation">Physiological Adaptation</a></h3><a class="arw" href="/nclex-practice-questions/physiological-adaptation">Practice free questions<span aria-hidden="true"> &rarr;</span></a></article></div></section>

  <section class="hm-sec hm-w" aria-labelledby="hmn"><div class="hm-hd"><h2 id="hmn">What's new</h2></div>
   <div class="hm-list"><article class="hm-news"><p class="hm-k"><time>November 2026</time></p><h3><a href="/for-nursing-students">Every nursing student can use Vexcura free</a></h3><p>Sign up with a name, email and password. The full practice exam, the academic EHR, simulations and the study tools come with the account, with or without a school.</p><a class="arw" href="/for-nursing-students">Learn more<span aria-hidden="true"> &rarr;</span></a></article><article class="hm-news"><p class="hm-k"><time>November 2026</time></p><h3><a href="/academic-ehr-for-nursing-students">Print the complete chart</a></h3><p>Students and instructors can print or download a patient's whole chart, from admission to the latest entry, for programs that grade on paper.</p><a class="arw" href="/academic-ehr-for-nursing-students">Learn more<span aria-hidden="true"> &rarr;</span></a></article><article class="hm-news"><p class="hm-k"><time>November 2026</time></p><h3><a href="/academic-ehr-for-nursing-students">Photos in the chart, with identifying details removed</a></h3><p>A media activity lets students add practice photos to the chart. Location data is stripped, and a redaction tool lets students cover anything identifying.</p><a class="arw" href="/academic-ehr-for-nursing-students">Learn more<span aria-hidden="true"> &rarr;</span></a></article></div></section>

  <section class="hm-promo hm-w" aria-labelledby="hmp"><div class="hm-book" aria-hidden="true"><div class="hm-bk b3"></div><div class="hm-bk b2"></div><div class="hm-bk b1"><span>Vexcura</span><b>Study guide library</b><i>Free &middot; printable &middot; cited</i></div></div><div>
   <h2 id="hmp">The free study guide library</h2><p class="hm-k">24 printable guides &middot; new guides most days</p>
   <p>One-page sheets and longer guides for every stage of nursing school, from lab values to shock. Each one lists its sources and the date it was last reviewed, and none of them need an account.</p>
   <p class="hm-links"><a class="arw" href="/nclex-study-guides">Browse the library<span aria-hidden="true"> &rarr;</span></a><a class="arw" href="/question-of-the-day">Try today's question<span aria-hidden="true"> &rarr;</span></a></p></div></section>
  </div><script>(function(){var f=document.getElementById("ask");if(!f)return;var q=document.getElementById("askq"),out=document.getElementById("askout"),mic=document.getElementById("askmic"),IX=null,L=null,ver="2026-11-18";
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function load(){if(L)return L;L=fetch("/ask-index.json?v="+ver).then(function(r){return r.json()}).then(function(j){IX=j.map(function(d){d._t=norm(d.t);d._x=norm((d.x||"")+" "+(d.p||""));return d});return IX});return L}
var SYN={k:"potassium",na:"sodium",ca:"calcium",mg:"magnesium",cl:"chloride",abg:"abg arterial",abgs:"abg arterial",bp:"blood pressure",ngn:"next generation",nextgen:"next generation",gen:"generation",med:"medication",meds:"medication",dka:"diabetic ketoacidosis",mi:"myocardial infarction",chf:"heart failure",uap:"assistive personnel",prioritize:"prioritization",prioritise:"prioritization",priority:"prioritization",first:"prioritization",delegate:"delegation",antidote:"antidote reversal",reverse:"reversal",hgb:"hemoglobin",hct:"hematocrit",wbc:"white blood cells",plt:"platelets",inr:"inr warfarin",ptt:"aptt heparin",sata:"select all that apply",cat:"adaptive",test:"exam",practice:"practice",dosage:"dosage calculation",calc:"calculation",math:"calculation",price:"pricing cost",cost:"pricing price",pay:"pricing",home:"home online",ekg:"ecg telemetry rhythm",ecg:"ekg telemetry rhythm",sepsis:"sepsis shock",lasix:"furosemide",coumadin:"warfarin"};
var REPL={first:1,priority:1,prioritize:1,prioritise:1};var STOP={a:1,an:1,the:1,is:1,are:1,of:1,"for":1,to:1,"in":1,on:1,and:1,or:1,what:1,how:1,"do":1,i:1,my:1,me:1,you:1,your:1,does:1,can:1,which:1,who:1,when:1,why:1,"with":1,about:1,at:1,be:1,should:1,nurse:1,nursing:1,nclex:1,rn:1,level:1,levels:1,normal:1,see:1,read:1,get:1,whats:1,"what's":1};
function norm(s){return " "+String(s).toLowerCase().replace(/[’']/g,"").replace(/[^a-z0-9.+-]+/g," ")+" "}
function stem(w){return w.length>4?w.replace(/(ing|ed|es|s)$/,""):w}
function terms(s){var o=[],seen={};norm(s).trim().split(/\s+/).forEach(function(w){if(!w||STOP[w]||seen[w])return;seen[w]=1;o.push((SYN[w]?(REPL[w]?SYN[w]:SYN[w]+" "+w):w).split(" ").filter(Boolean))});return o}
function has(h,w){if(h.indexOf(" "+w+" ")>=0||h.indexOf(" "+w+"s ")>=0||h.indexOf(" "+w+"es ")>=0||(w.length>3&&/s$/.test(w)&&h.indexOf(" "+w.slice(0,-1)+" ")>=0))return 2;var s=stem(w);return s.length>=3&&h.indexOf(" "+s)>=0?1:0}
function search(s){var G=terms(s);if(!G.length)return[];var r=[];IX.forEach(function(d){var sc=0,m=0,ex=0;G.forEach(function(g){var best=0,hit=0;g.forEach(function(w,j){var a=has(d._t,w),b=has(d._x,w);if(a||b)hit=1;if(a===2&&j===g.length-1)ex=1;best=Math.max(best,(a*3+b)*(j===g.length-1?1.5:1))});m+=hit;sc+=best});
 if(!m||m<Math.ceil(G.length*0.5))return;if(d.k==="lab"&&ex)sc+=6;if(d.k==="page")sc+=1;if(d.k==="q")sc-=0.5;sc=sc*(m/G.length)*(m/G.length);r.push([sc,d])});r.sort(function(a,b){return b[0]-a[0]});return r.slice(0,7).map(function(x){return x[1]})}
function card(d){var k={q:"From a Vexcura practice question",lab:"From NCLEX lab values",guide:"Study guide",page:"Vexcura",sec:"Vexcura"}[d.k]||"Vexcura";
 if(d.k==="q")return '<div class="ans-card"><p class="ans-k">'+k+' · '+esc(d.c)+'</p><h3>'+esc(d.t)+'</h3><p class="ans-a">'+esc(d.a)+'</p><p>'+esc(d.r)+'</p><p class="ans-src">'+(d.s?"Source: "+esc(d.s)+" · ":"")+'<a href="'+d.u+'" data-cta="ask-answer">Try the full question</a></p></div>';
 if(d.k==="lab")return '<div class="ans-card"><p class="ans-k">'+k+'</p><h3>'+esc(d.t)+': '+esc(d.a)+'</h3><p>'+esc(d.r)+'</p><p class="ans-src">Typical adult range; follow your lab\'s reference range. <a href="'+d.u+'" data-cta="ask-answer">All lab values</a></p></div>';
 return '<div class="ans-card"><p class="ans-k">'+k+'</p><h3><a href="'+d.u+'" data-cta="ask-answer">'+esc(d.t)+'</a></h3><p>'+esc(d.x||"")+'</p></div>'}
var AIT=0;function ai(s,cx){var my=++AIT;out.insertAdjacentHTML("afterbegin",'<div class="ai-card" id="aicard" aria-live="polite"><p class="ans-k">Vexcura AI</p><p class="ai-wait">Reading Vexcura’s sources<span>.</span><span>.</span><span>.</span></p></div>');
 var done=function(html){if(my!==AIT)return;var c=document.getElementById("aicard");if(!c)return;if(!html){c.remove();return}c.outerHTML=html};
 fetch("/api/ask/ai",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({q:s,pq:cx&&cx.pq||"",pa:cx&&cx.pa||""})}).then(function(r){return r.json()}).then(function(j){
  if(j&&j.found&&j.answer){var h='<div class="ai-card" id="aicard"><p class="ans-k">Vexcura AI</p><p class="ai-a">'+esc(j.answer)+'</p>';
   if(j.sources&&j.sources.length)h+='<p class="ai-src">Sources: '+j.sources.map(function(x){return '<a href="'+esc(x.u)+'"'+(x.ext?' target="_blank" rel="noopener nofollow"':'')+' data-cta="ask-ai-source">'+esc(x.t)+'</a>'}).join(" · ")+'</p>';
   if(j.follow&&j.follow.length)h+='<p class="ai-f">'+j.follow.map(function(x){return '<button type="button" class="ai-fb" data-f="'+esc(x)+'">'+esc(x)+'</button>'}).join("")+'</p>';
   if(j.more&&j.more.length)h+='<p class="ai-more">Keep studying on Vexcura: '+j.more.map(function(x){return '<a href="'+esc(x.u)+'" data-cta="ask-ai-more">'+esc(x.t.length>58?x.t.slice(0,55).replace(/\s+\S*$/,"")+"…":x.t)+'</a>'}).join(" · ")+'</p>';
   h+='<p class="ai-lab">AI-generated from Vexcura’s cited pages, NIH sources (MedlinePlus, StatPearls, PubMed guideline abstracts) and FDA drug labels. It can be wrong: check the sources before you rely on it. Not medical advice. Vexcura isn’t affiliated with or endorsed by NIH or the FDA.</p></div>';done(h);
   var c=document.getElementById("aicard");if(c)c.querySelectorAll(".ai-fb").forEach(function(b){b.addEventListener("click",function(){var t=b.getAttribute("data-f");q.value=t;show(t,"follow",{pq:s,pa:j.answer})})})}
  else if(j&&j.note&&j.answer){done('<div class="ai-card ai-note" id="aicard"><p class="ans-k">Vexcura AI</p><p class="ai-a">'+esc(j.answer)+'</p></div>')}
  else done("")})["catch"](function(){done("")})}
function show(s,from,cx){s=String(s||"").trim().slice(0,160);if(!s){out.innerHTML="";return}out.innerHTML='<p class="ans-src">Looking…</p>';load().then(function(){var R=search(s),h="";
 if(!R.length){h='<div class="ans-card"><p class="ans-k">No match yet</p><h3>We don\'t have a page on that yet.</h3><p>Try fewer words, or start with one of these: <a href="/nclex-practice-questions">practice questions</a>, <a href="/nclex-study-guides">study guides</a> or <a href="/nclex-lab-values">lab values</a>. Your question has been noted so we can add it.</p></div>'}
 else{h=card(R[0]);if(R.length>1)h+='<ul class="ans-list">'+R.slice(1).map(function(d){return '<li><a href="'+d.u+'" data-cta="ask-result">'+esc(d.k==="q"?d.t:d.t)+'</a><span>'+esc(d.k==="q"?"Practice question · "+d.c:d.k==="lab"?"Lab value · "+d.a:d.k==="guide"?"Study guide":(d.p?d.p:"Vexcura"))+'</span></li>'}).join("")+'</ul>'}
 h+='<p class="ans-cta">Want the full adaptive practice exam, drills and the academic EHR? <a href="/app#signup" data-cta="ask-signup">Create your free account</a>.</p>';out.innerHTML=h;ai(s,cx);
 try{history.replaceState(null,"","/?q="+encodeURIComponent(s))}catch(e){}
 try{var b=JSON.stringify({q:s,n:R.length,top:R[0]?R[0].u:"",via:from||"type"});if(navigator.sendBeacon)navigator.sendBeacon("/api/ask/log",new Blob([b],{type:"application/json"}))}catch(e){}})["catch"](function(){out.innerHTML='<p class="ans-src">Search is unavailable right now. Try <a href="/nclex-practice-questions">practice questions</a>.</p>'})}
f.addEventListener("submit",function(e){e.preventDefault();show(q.value,"type")});q.addEventListener("focus",load,{once:true});
document.querySelectorAll(".ask-try .chip").forEach(function(b){b.addEventListener("click",function(){q.value=b.getAttribute("data-q");show(q.value,"chip")})});
var SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(SR&&mic){mic.hidden=false;var rec=null;mic.addEventListener("click",function(){if(rec){rec.stop();return}rec=new SR();rec.lang="en-US";rec.interimResults=true;mic.classList.add("on");mic.setAttribute("aria-label","Listening. Tap to stop");
 rec.onresult=function(e){var t="";for(var i=0;i<e.results.length;i++)t+=e.results[i][0].transcript;q.value=t;if(e.results[e.results.length-1].isFinal)show(t,"voice")};rec.onend=function(){mic.classList.remove("on");mic.setAttribute("aria-label","Ask with your voice");rec=null};rec.onerror=rec.onend;rec.start()})}
var p=new URLSearchParams(location.search).get("q");if(p){q.value=p;show(p,"link")}})();</script><script>(function(){try{if(!("IntersectionObserver" in window)||matchMedia("(prefers-reduced-motion:reduce)").matches)return;var e=document.querySelectorAll(".hm-tasks,.hm-freep,.hm-rate,.hm-hc-g,.hm-stack article,.hm-sw,.hm-co,.hm-sec,.hm-promo"),o=new IntersectionObserver(function(x){x.forEach(function(i){if(i.isIntersecting){i.target.classList.add("in");o.unobserve(i.target)}})},{rootMargin:"0px 0px -8% 0px"});e.forEach(function(n){if(n.getBoundingClientRect().top>innerHeight){n.classList.add("hm-rv");o.observe(n)}})}catch(e){}})();</script><section class="band vxs-band"><div class="vxs-bg" data-vxs-i="0" aria-hidden="true"></div><div class="vxs-sh" aria-hidden="true"></div><div class="w"><h2>For nursing programs</h2><p>License Vexcura for your cohorts and faculty: the clinical instructor workspace, attendance and badge sign-in, LMS grade sync and school sign-in, NCLEX remediation from the scores you already have, and board-compliance records. Every plan includes everything, and you can try it with one cohort for a semester, free.</p><div class="cta"><a class="btn" href="/for-nursing-schools" data-cta="home-band">Vexcura for nursing schools</a><a class="btn alt" href="/for-nursing-schools#pricing">Pricing</a></div></div></section></main><footer class="foot mktf"><div class="w">
   <div class="mktf-top">
