   <h1 id="hmh">Hello, future nurse.</h1><script>(function(){try{var o=JSON.parse(localStorage.getItem("vx.hi")||"null"),n=o&&typeof o.n==="string"?o.n.replace(/[<>]/g,"").trim().slice(0,80):"";if(!n)return;var h=document.getElementById("hmh"),a=document.createElement("abbr");a.title="Student Nurse";a.textContent="SN";h.textContent="Hello, "+n+", ";h.appendChild(a);h.appendChild(document.createTextNode("."));h.classList.add("hm-hi");document.addEventListener("DOMContentLoaded",function(){var b=document.querySelector("a[data-cta=home-hero]");if(b){b.href="/app";b.textContent="Open my Vexcura";b.setAttribute("data-cta","home-hero-back")}})}catch(e){}})()</script>
   <p class="hm-lead">Everything nursing school throws at you, in one place.</p>
   <div class="hm-stage">
