<link rel="stylesheet" href="/s-yiqru.css"><style>
.hm{--hm-w:920px}.hm-w{max-width:var(--hm-w);margin:0 auto;padding:0 max(20px,env(safe-area-inset-left))}
.hm a.arw{font-weight:600;text-decoration:none;color:var(--accent);white-space:nowrap}.hm a.arw:hover span{margin-left:3px}.hm a.arw span{transition:margin .15s}
.hm a.arw:hover{text-decoration:underline;text-underline-offset:3px}
.hm-hero{text-align:center;padding:84px 0 64px}.hm-hero h1{font:400 clamp(40px,7vw,68px)/1.05 var(--fh);margin:0 auto 22px;max-width:14ch;letter-spacing:-.005em}
.hm-lead{font-size:clamp(18px,2.2vw,21px);line-height:1.55;color:var(--muted);max-width:40em;margin:0 auto 28px}
.hm-free-l{margin:16px 0 0;font-size:16px;color:var(--ink)}.hm-free-l a{margin-left:8px;color:inherit;text-underline-offset:3px}
.hm-freep{margin-top:104px}.hm-freep-in{border-radius:40px;padding:84px 56px 72px;text-align:center;background:radial-gradient(70% 90% at 0% 0%,rgba(243,196,108,.34),transparent 70%),radial-gradient(60% 80% at 100% 100%,rgba(233,128,106,.26),transparent 70%),#fbf6ee;border:1px solid rgba(16,40,56,.08)}
.hm-freep h2{font:400 clamp(34px,5.4vw,68px)/1.04 var(--fh);letter-spacing:-.02em;margin:8px auto 18px;max-width:16ch}.hm-freep-lead{font-size:19px;max-width:56ch;margin:0 auto 40px;color:var(--ink)}
.hm-freep-g{list-style:none;margin:0 0 40px;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;text-align:left}.hm-freep-g li{background:#fff;border:1px solid rgba(16,40,56,.08);border-radius:22px;padding:22px 22px 20px}.hm-freep-g b{display:block;font:400 24px/1.15 var(--fh);margin-bottom:8px}.hm-freep-g span{color:var(--muted);font-size:15.5px;line-height:1.45}
@media (max-width:980px){.hm-freep-g{grid-template-columns:1fr 1fr}}@media (max-width:620px){.hm-freep{margin-top:64px}.hm-freep-in{padding:48px 22px 40px;border-radius:28px}.hm-freep-g{grid-template-columns:1fr}.hm-freep-lead{font-size:17px}}
.hm-go{display:flex;gap:14px 26px;justify-content:center;align-items:center;flex-wrap:wrap;margin:0}.hm-go .btn{padding:13px 22px;font-size:17px;border-radius:999px}
.hm-sub{margin:22px 0 0;color:var(--muted);font-size:15.5px}
.hm-stack{display:grid;gap:0;border-top:1px solid var(--line)}.hm-stack article{padding:38px 0;border-bottom:1px solid var(--line)}
.hm-stack h2{font:400 clamp(27px,3.6vw,38px)/1.15 var(--fh);margin:0 0 10px;max-width:24ch}.hm-stack p{margin:0 0 12px;color:var(--muted);max-width:60ch}
.hm-sw{display:grid;grid-template-columns:auto 1fr;gap:26px;align-items:start;padding-top:64px;padding-bottom:20px}.hm-ic{width:92px;height:92px;border-radius:50%;background:var(--sunk);display:grid;place-items:center;color:var(--accent)}
.hm-sw h2,.hm-hd h2,.hm-promo h2{font:400 clamp(28px,3.6vw,36px)/1.15 var(--fh);margin:0 0 10px}.hm-sw p{margin:0 0 12px;max-width:62ch}
.hm-sec{padding-top:64px}.hm-hd{display:flex;justify-content:space-between;align-items:baseline;gap:8px 20px;flex-wrap:wrap;margin-bottom:22px;border-bottom:1px solid var(--line);padding-bottom:10px}.hm-hd h2{margin:0}
.hm-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
.hm-card h3,.hm-qc h3,.hm-news h3{font:400 22px/1.25 var(--fh);margin:12px 0 6px}.hm-card h3 a,.hm-qc h3 a,.hm-news h3 a{color:var(--ink);text-decoration:none}.hm-card h3 a:hover,.hm-qc h3 a:hover,.hm-news h3 a:hover{text-decoration:underline}
.hm-card p,.hm-news p{color:var(--muted);font-size:15.5px;margin:0 0 10px}
.hm-cv{aspect-ratio:4/3;border-radius:10px;background:linear-gradient(150deg,var(--cv),color-mix(in srgb,var(--cv) 62%,#000));color:#fff;padding:18px 18px 14px;display:flex;flex-direction:column;position:relative;overflow:hidden}
.hm-cv:after{content:"";position:absolute;right:-30px;bottom:-40px;width:150px;height:150px;border-radius:50%;border:22px solid rgba(255,255,255,.08)}
.hm-cv span{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.8}.hm-cv b{font:400 26px/1.15 var(--fh);margin-top:auto;max-width:12ch}.hm-cv i{font-style:normal;font-size:12.5px;opacity:.7;margin-top:10px}
.hm-qc{border:1px solid var(--line);border-radius:10px;padding:18px 18px 16px;background:var(--surface)}.hm-bar{height:8px;border-radius:4px;background:var(--sunk);overflow:hidden}.hm-bar i{display:block;height:100%;background:var(--accent);border-radius:4px}
.hm-k{font-size:13.5px;letter-spacing:.04em;color:var(--muted);margin:10px 0 0}
.hm-list{display:grid;gap:0}.hm-news{padding:20px 0;border-bottom:1px solid var(--line)}.hm-news:first-child{padding-top:0}.hm-news .hm-k{margin:0}
.hm-promo{display:grid;grid-template-columns:240px 1fr;gap:40px;align-items:center;padding-top:72px;padding-bottom:24px}.hm-promo p{max-width:58ch}.hm-promo .hm-k{margin:0 0 10px}
.hm-links{display:flex;gap:10px 28px;flex-wrap:wrap}
.hm-book{position:relative;height:300px}.hm-bk{position:absolute;width:190px;height:260px;border-radius:4px 10px 10px 4px;box-shadow:0 18px 40px -18px rgba(0,0,0,.45)}
.hm-bk.b3{left:44px;top:0;background:#c9a24f}.hm-bk.b2{left:22px;top:14px;background:#7a3b52}.hm-bk.b1{left:0;top:30px;background:linear-gradient(160deg,#1d5670,#103a4f);color:#fff;padding:22px 18px;display:flex;flex-direction:column}
.hm-bk.b1 span{font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.75}.hm-bk.b1 b{font:400 27px/1.12 var(--fh);margin-top:auto}.hm-bk.b1 i{font-style:normal;font-size:12.5px;opacity:.75;margin-top:10px}
.hm-ask{position:relative;isolation:isolate}.hm-art{position:absolute;left:0;right:0;top:0;height:560px;z-index:-1;pointer-events:none;overflow:hidden}.hm-art svg{display:block;width:100%;height:100%}
.hm-art .hm-dawn{animation:hmDawn 7s ease-out .3s both}@keyframes hmDawn{from{opacity:.9}to{opacity:0}}
.hm-art .hm-sun{animation:hmRise 7.5s cubic-bezier(.2,.7,.2,1) .2s both}@keyframes hmRise{from{transform:translateY(170px)}to{transform:none}}
.hm-art .hm-glow{transform-box:fill-box;transform-origin:center;animation:hmGlow 9s ease-in-out 7.5s infinite}@keyframes hmGlow{50%{transform:scale(1.08);opacity:.85}}
.hm-art .hm-win .w{fill:#f6d58e;animation:hmLights 6.5s ease-in 1.5s both}.hm-art .hm-win .w:nth-child(3n){animation-delay:2.6s}.hm-art .hm-win .w:nth-child(4n){animation-delay:3.4s}@keyframes hmLights{to{fill:#d6e5eb}}
.hm-art .hm-beacon{animation:hmBeacon 2.4s ease-in-out infinite}@keyframes hmBeacon{50%{opacity:.15}}
.hm-art .hm-c1{animation:hmDrift 70s ease-in-out infinite alternate}.hm-art .hm-c2{animation:hmDrift 90s ease-in-out -30s infinite alternate-reverse}.hm-art .hm-c3{animation:hmDrift 55s ease-in-out -10s infinite alternate}@keyframes hmDrift{to{transform:translateX(160px)}}
.hm-art .hm-birds{animation:hmFly 38s linear 2s infinite}@keyframes hmFly{0%{transform:translate(260px,40px);opacity:0}8%{opacity:.6}70%{opacity:.6}100%{transform:translate(-900px,-70px);opacity:0}}
.hm-art .hm-b{transform-box:fill-box;transform-origin:center;animation:hmFlap .7s ease-in-out infinite alternate}.hm-art .hm-b.b2{animation-delay:-.3s}.hm-art .hm-b.b3{animation-delay:-.5s}@keyframes hmFlap{to{transform:scaleY(.35)}}
.hm-art .hm-car{animation:hmDrive 26s linear 4s infinite}@keyframes hmDrive{from{transform:translateX(0)}to{transform:translateX(1720px)}}
@media (prefers-reduced-motion:reduce){.hm-art *{animation:none!important}.hm-art .hm-dawn{opacity:0}.hm-art .hm-win .w{fill:#d6e5eb}.hm-art .hm-car{display:none}}
.hm-ask .chip{background:rgba(255,255,255,.92)}.hm-ask .ask{background:#fff}.hm-ask .hm-lead{color:#3c5661}
@media (prefers-color-scheme:dark){.hm-art{opacity:.18}.hm-ask .ask{background:var(--surface)}.hm-ask .chip{background:var(--bg)}.hm-ask .hm-lead{color:var(--muted)}}
@media (max-width:760px){.hm-art{height:470px}}@media (max-width:600px){.hm-art{height:430px}}
.hm-v2.hm-ask{padding:12px 16px 0}.hm-pan{position:relative;border-radius:40px;padding:64px 0 84px;background:radial-gradient(55% 46% at 50% 0%,rgba(243,196,108,.30),transparent 70%),radial-gradient(42% 44% at 8% 6%,rgba(29,86,112,.20),transparent 70%),radial-gradient(40% 40% at 94% 12%,rgba(233,128,106,.16),transparent 70%),linear-gradient(180deg,#f4f7f8,#e4eaed)}
.hm-v2 h1{font-size:clamp(46px,8.2vw,112px);line-height:1;letter-spacing:-.025em;margin:0 0 18px}.hm-v2 .hm-lead{font-size:clamp(18px,2vw,24px);margin-bottom:0}
.hm-stage{position:relative;width:min(1180px,calc(100vw - 72px));left:50%;transform:translateX(-50%);margin:40px 0 0;aspect-ratio:16/9;border-radius:34px;overflow:hidden;background:radial-gradient(70% 80% at 85% 100%,rgba(233,128,106,.55),transparent 70%),radial-gradient(50% 60% at 100% 60%,rgba(243,196,108,.35),transparent 70%),linear-gradient(140deg,#1b2a5c 0%,#103a4f 55%,#3d3358 100%);box-shadow:0 50px 90px -40px rgba(11,39,53,.55),0 0 0 1px rgba(11,39,53,.08)}
.hm-stage .ask{position:absolute;z-index:3;left:14px;right:14px;top:14px;max-width:none;margin:0;border:0;padding:8px 8px 8px 26px;box-shadow:0 14px 40px -14px rgba(0,0,0,.45)}.hm-stage .ask input{font-size:19px;padding:14px 4px}
.hm-shots{position:absolute;inset:0}.hm-shot{position:absolute;inset:0;margin:0;opacity:0;transition:opacity .9s ease}.hm-shot.on{opacity:1}.hm-shot img{position:absolute;left:8%;width:84%;top:118px;height:auto;display:block;border-radius:14px 14px 0 0;box-shadow:0 30px 80px -20px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.12)}
.hm-shot img.hm-ph{left:auto;right:5%;top:150px;width:19%;z-index:1;border-radius:26px;border:7px solid #0b1620;background:#0b1620;box-shadow:0 26px 60px -14px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.16);box-sizing:border-box}
.hm-shot.on img{animation:hmKen 1.1s cubic-bezier(.2,.7,.2,1) both}@keyframes hmKen{from{transform:translateY(36px)}to{transform:none}}
.hm-shot:after{content:"";position:absolute;left:0;right:0;bottom:0;height:24%;background:linear-gradient(180deg,rgba(11,25,40,0),rgba(11,25,40,.82))}
.hm-shot figcaption{position:absolute;z-index:2;left:22px;bottom:20px;background:rgba(255,255,255,.94);color:#102838;border-radius:999px;padding:8px 16px;font-size:15px;font-weight:600}
.hm-stage:has(.ask-out:not(:empty)){aspect-ratio:auto;background:var(--surface);width:auto;left:auto;transform:none;padding:14px 14px 20px;overflow:visible}.hm-stage:has(.ask-out:not(:empty)) .ask{position:static;border:1.5px solid var(--line)}.hm-stage:has(.ask-out:not(:empty)) .hm-shots{display:none}.hm-stage .ask-out{max-width:none;padding:0 10px}
.hm-ctl{display:flex;gap:10px;justify-content:center;margin:26px 0 6px}.hm-ctl button{width:48px;height:48px;border-radius:50%;border:0;background:rgba(11,39,53,.08);color:#102838;display:grid;place-items:center;cursor:pointer}.hm-ctl button:hover{background:rgba(11,39,53,.16)}#hmpp .pl{display:none}#hmpp[data-s="0"] .pl{display:block}#hmpp[data-s="0"] .pa{display:none}#hmpp span{display:grid}
.hm-new{position:absolute;left:28px;bottom:24px;display:inline-flex;align-items:center;gap:10px;background:#fff;color:#102838;text-decoration:none;border-radius:999px;padding:8px 16px 8px 8px;font-weight:600;font-size:15.5px;box-shadow:0 6px 20px -10px rgba(0,0,0,.4)}.hm-new b{background:#102838;color:#fff;border-radius:999px;padding:4px 11px;font-size:13px}.hm-new:hover{box-shadow:0 8px 24px -8px rgba(0,0,0,.45)}
@media (prefers-reduced-motion:reduce){.hm-shot,.hm-shot.on img{transition:none;animation:none}}
@media (prefers-color-scheme:dark){.hm-pan{background:linear-gradient(180deg,#12222b,#0c1a21)}.hm-ctl button{background:rgba(255,255,255,.1);color:#fff}}
@media (max-width:760px){.hm-v2.hm-ask{padding:8px 8px 0}.hm-pan{border-radius:28px;padding:44px 0 28px}.hm-stage{width:calc(100vw - 32px);aspect-ratio:4/4.2;border-radius:24px;margin-top:28px}.hm-shot img{left:6%;width:185%;max-width:none;top:88px}.hm-shot img.hm-ph{left:auto;right:5%;width:40%;top:104px;border-width:5px;border-radius:20px}.hm-shot figcaption{right:22px;width:max-content;max-width:calc(100% - 44px);font-size:13.5px;border-radius:16px;text-align:left}.hm-stage .ask{left:10px;right:10px;top:10px;padding-left:18px}.hm-stage .ask input{font-size:16.5px;padding:11px 4px}.hm-new{position:static;margin:22px auto 0;display:flex;width:max-content}.hm-pan{text-align:center}}
.hm-one{text-align:center;max-width:760px;margin:0 auto 26px}.hm-one .hm-k{margin:0;text-transform:uppercase;letter-spacing:.08em;font-size:13px;color:#1d5670}.hm-one h2{font:400 clamp(26px,3.4vw,36px)/1.2 var(--fh);margin:6px 0 10px}.hm-one p{margin:0}
.hm-hc{padding-top:64px}.hm-hc-g{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}.hm-hc h2{font:400 clamp(26px,3.4vw,36px)/1.2 var(--fh);margin:6px 0 12px}.hm-hc .hm-k{margin:0;text-transform:uppercase;letter-spacing:.08em;font-size:13px;color:#1d5670}.hm-hc-l{list-style:none;padding:0;margin:18px 0 22px;display:grid;gap:10px}.hm-hc-l li{padding-left:28px;position:relative}.hm-hc-l li:before{content:"";position:absolute;left:4px;top:.45em;width:12px;height:12px;border-radius:50%;background:#e0a82e}.hm-hc-b{display:flex;flex-wrap:wrap;gap:12px}
.hc-card{max-width:420px;width:100%;justify-self:center;border:1px solid var(--line,#d9e2e8);border-radius:14px;background:#fff;box-shadow:0 10px 30px rgba(16,58,79,.12);padding:16px 18px;font-size:15px}.hc-top{display:flex;align-items:center;gap:12px}.hc-top b{display:block;font-size:17px}.hc-top small{color:var(--muted,#5b6b75);font-size:14px}.hc-av{width:44px;height:44px;flex:none;border-radius:50%;background:#1d5670;color:#fff;display:grid;place-items:center;font-weight:700}.hc-tag{margin-left:auto;background:#fdf3dc;color:#7a5400;border-radius:999px;padding:4px 10px;font-size:14px}
.hc-v{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0 10px}.hc-v div{background:#f3f7f9;border-radius:10px;padding:8px}.hc-v small{display:block;color:var(--muted,#5b6b75);font-size:14px}.hc-v b{font-size:18px}.hc-f{margin:0 0 12px;padding:8px 10px;border-left:4px solid #e0a82e;background:#fffaf0;font-size:14.5px}.hc-t{display:flex;flex-wrap:wrap;gap:6px}.hc-t span{font-size:14px;border:1px solid var(--line,#d9e2e8);border-radius:999px;padding:4px 10px;color:#1d5670}
@media (max-width:860px){.hm-hc-g{grid-template-columns:1fr}}
.hm-rate{background:linear-gradient(160deg,#103a4f,#1d5670);color:#fff;margin-top:56px;padding:64px 0 56px}.hm-rate h2{font:400 clamp(26px,3.4vw,36px)/1.2 var(--fh);margin:6px 0 12px;color:#fff}.hm-rate p{color:rgba(255,255,255,.86)}.hm-rate .hm-k{color:#f3c46c;margin:0;text-transform:uppercase;letter-spacing:.08em;font-size:13px}
.hm-rate-top{display:grid;grid-template-columns:auto 1fr;gap:20px 40px;align-items:center}.hm-rate .hm-rate-n{font:400 clamp(84px,13vw,150px)/.9 var(--fh);margin:0;color:#f3c46c;letter-spacing:-.02em}
.hm-rate h3{font:600 15px/1 inherit;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.7);margin:40px 0 14px}
.hm-fix{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.hm-fix>div{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:16px 16px 6px}.hm-fix b{color:#fff;font-size:16.5px}.hm-fix p{font-size:15px;margin:6px 0 10px}
.hm-src{font-size:13.5px;margin:22px 0 0;color:rgba(255,255,255,.62)!important}
.hm-co{padding-top:64px}.hm-co-g{display:grid;grid-template-columns:1.6fr 1fr;gap:28px;align-items:start}.hm-fdr{display:grid;grid-template-columns:auto 1fr;gap:18px}.hm-av{width:72px;height:72px;border-radius:50%;background:linear-gradient(150deg,#1d5670,#7a3b52);color:#fff;display:grid;place-items:center;font:400 26px var(--fh)}
.hm-fdr h3{font:400 23px/1.2 var(--fh);margin:4px 0 0}.hm-fdr .hm-k{margin:2px 0 8px}.hm-fdr p{max-width:62ch}
.hm-facts{margin:0;border:1px solid var(--line);border-radius:10px;padding:6px 18px;background:var(--surface)}.hm-facts div{display:grid;grid-template-columns:110px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.hm-facts div:last-child{border:0}.hm-facts dt{color:var(--muted);font-size:14px}.hm-facts dd{margin:0;font-size:15.5px}
.hm-tech-h{font:400 22px/1.2 var(--fh);margin:34px 0 12px}.hm-tech{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.hm-tech>div{border-top:3px solid var(--accent);padding-top:10px}.hm-tech b{font-size:16px}.hm-tech p{color:var(--muted);font-size:15px;margin:6px 0 0}
@media (max-width:860px){.hm-fix,.hm-tech{grid-template-columns:1fr 1fr}.hm-co-g{grid-template-columns:1fr}.hm-rate-top{grid-template-columns:1fr}}
@media (max-width:520px){.hm-fix,.hm-tech{grid-template-columns:1fr}}
.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.hm-ask{padding:76px 0 40px}.hm-ask h1{max-width:none}.hm-ask h1.hm-hi{font-size:clamp(32px,5.4vw,58px);overflow-wrap:anywhere}.hm-hero h1 abbr{text-decoration:none;cursor:help}.hm-ask .hm-lead{margin-bottom:26px}
.ask{display:flex;align-items:center;gap:4px;max-width:720px;margin:0 auto;background:var(--surface);border:1.5px solid var(--line);border-radius:999px;padding:6px 6px 6px 22px;box-shadow:0 10px 30px -18px rgba(0,0,0,.35);transition:border-color .15s,box-shadow .15s}
.ask:focus-within{border-color:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 18%,transparent),0 10px 30px -18px rgba(0,0,0,.35)}
.ask input{flex:1;min-width:0;border:0;background:transparent;font:inherit;font-size:18px;padding:12px 4px;color:var(--ink);outline:none}.ask input::-webkit-search-cancel-button{display:none}
.ask button{flex:none;width:48px;height:48px;border-radius:50%;border:0;display:grid;place-items:center;cursor:pointer;color:var(--ink);background:transparent}
.ask .ask-go{background:var(--accent);color:var(--accent-ink)}.ask .ask-mic:hover{background:var(--sunk)}.ask .ask-mic.on{background:#c43d3d;color:#fff;animation:askp 1.2s infinite}
@keyframes askp{50%{box-shadow:0 0 0 8px rgba(196,61,61,.18)}}
.ask-try{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:760px;margin:16px auto 0;color:var(--muted);font-size:14.5px;align-items:center}
.chip{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;padding:7px 13px;font:inherit;font-size:14.5px;cursor:pointer}.chip:hover{border-color:var(--accent);color:var(--accent)}
.ask-out{max-width:720px;margin:0 auto;text-align:left}.ask-out:not(:empty){margin-top:22px}
.ans-card{border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:10px;background:var(--surface);padding:18px 20px;margin-bottom:14px}
.ans-k{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 6px}.ans-card h3{font:400 23px/1.25 var(--fh);margin:0 0 8px}.ans-card p{margin:0 0 8px}
.ans-a{font-weight:600}.ans-src{font-size:14px;color:var(--muted)}
.ans-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.ans-list li{border-bottom:1px solid var(--line);padding:12px 2px}.ans-list a{font-weight:600;text-decoration:none;color:var(--ink)}.ans-list a:hover{color:var(--accent);text-decoration:underline}.ans-list span{display:block;font-size:14.5px;color:var(--muted);margin-top:2px}
.ans-cta{margin:14px 0 0;font-size:15.5px;color:var(--muted)}
.hm-ask .hm-go{margin-top:30px}
.hm-tasks{padding-top:56px;padding-bottom:12px}.hm-tgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.hm-task{display:block;border:1px solid var(--line);border-radius:10px;padding:16px 18px;text-decoration:none;color:var(--ink);background:var(--bg);transition:border-color .15s,transform .15s}.hm-task:hover{border-color:var(--accent);transform:translateY(-1px)}
.hm-task b{display:block;font-size:17px}.hm-task span{display:block;color:var(--muted);font-size:14.5px;margin-top:2px}
@media (max-width:760px){.hm-tgrid{grid-template-columns:1fr 1fr}.ask{padding-left:16px}.ask input{font-size:16.5px}}
@media (max-width:600px){.ask-try{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;padding:2px 2px 6px;scrollbar-width:none;-webkit-mask:linear-gradient(90deg,#000 88%,transparent)}.ask-try::-webkit-scrollbar{display:none}.chip,.ask-try span{flex:none}.hm-ask{padding-top:48px}}
@media (max-width:480px){.hm-tgrid{grid-template-columns:1fr}.ask button{width:44px;height:44px}}
@media (max-width:860px){.hm-cards{grid-template-columns:1fr 1fr}.hm-promo{grid-template-columns:1fr;gap:18px}.hm-book{height:290px;max-width:240px}}
@media (max-width:600px){.hm-hero{padding:56px 0 44px}.hm-cards{grid-template-columns:1fr}.hm-sw{grid-template-columns:1fr;gap:14px}.hm-ic{width:72px;height:72px}.hm-ic svg{width:48px;height:48px}.hm-stack article{padding:28px 0}}
.ai-card{border-radius:22px;padding:22px 24px 18px;margin:0 0 16px;color:#fff;background:radial-gradient(60% 90% at 100% 100%,rgba(233,128,106,.40),transparent 70%),linear-gradient(140deg,#1b2a5c,#103a4f 60%,#17475c);box-shadow:0 24px 50px -30px rgba(11,39,53,.7)}.ai-card .ans-k{color:#f3c46c;margin:0 0 8px;font-weight:600}.ai-a{font-size:19px;line-height:1.5;margin:0 0 10px;color:#fff}.ai-src{font-size:15px;margin:0;color:rgba(255,255,255,.8)}.ai-src a{color:#fff;font-weight:600}
.ai-more{font-size:15px;margin:10px 0 0;color:rgba(255,255,255,.8)}.ai-more a{color:#f3c46c;font-weight:600}
.ai-f{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0}.ai-fb{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.1);color:#fff;border-radius:999px;padding:8px 14px;font:inherit;font-size:14.5px;cursor:pointer;min-height:44px;text-align:left}.ai-fb:hover{background:rgba(255,255,255,.2)}.ai-lab{font-size:14px;color:rgba(255,255,255,.72);margin:14px 0 0}
.ai-note{background:#f4f7f8;color:var(--ink);box-shadow:none}.ai-note .ans-k{color:#1d5670}.ai-note .ai-a{color:var(--ink);font-size:17px;margin:0}
.ai-wait{margin:0;color:rgba(255,255,255,.85)}.ai-wait span{animation:aiDot 1.2s infinite both}.ai-wait span:nth-child(2){animation-delay:.2s}.ai-wait span:nth-child(3){animation-delay:.4s}@keyframes aiDot{0%,80%,100%{opacity:.2}40%{opacity:1}}
@media (prefers-reduced-motion:reduce){.ai-wait span{animation:none}}
/* v3: rest of the page in the hero's language (2026-11-18) */
.hm{--hm-w:1180px}.hm-v2 .hm-w{max-width:920px}.hm-one{max-width:820px}
.hm-hd h2,.hm-stack h2,.hm-hc h2,.hm-one h2,.hm-sw h2,.hm-promo h2,.hm-rate h2{font-size:clamp(30px,4vw,46px);line-height:1.1;letter-spacing:-.015em}
.hm .hm-k{text-transform:uppercase;letter-spacing:.1em;font-size:13px;font-weight:600;color:#1d5670;margin:0 0 10px}
.hm-sec,.hm-co{padding-top:112px}.hm-hd{border-bottom:0;padding-bottom:0;margin-bottom:30px;align-items:end}
.hm-tasks{padding-top:88px}.hm-tgrid{gap:16px}.hm-task{position:relative;border:0;border-radius:22px;padding:24px 56px 24px 26px;background:#f1f5f6;transition:background .2s,transform .2s,box-shadow .2s}.hm-task b{font-size:19px}.hm-task span{font-size:15.5px;margin-top:4px}
.hm-task:after{content:"→";position:absolute;right:22px;top:22px;width:34px;height:34px;border-radius:50%;background:#fff;display:grid;place-items:center;color:#103a4f;font-weight:700;transition:transform .2s,background .2s,color .2s}.hm-task:hover{background:#e6eef1;transform:translateY(-3px);box-shadow:0 18px 40px -26px rgba(16,58,79,.5)}.hm-task:hover:after{background:#103a4f;color:#fff;transform:translateX(3px)}
.hm-rate{margin:104px 16px 0;border-radius:40px;padding:96px 0 76px;background:radial-gradient(60% 70% at 100% 100%,rgba(233,128,106,.42),transparent 70%),radial-gradient(40% 50% at 100% 30%,rgba(243,196,108,.22),transparent 70%),linear-gradient(140deg,#1b2a5c 0%,#103a4f 55%,#17475c 100%)}
.hm-rate-top{gap:24px 64px}.hm-rate .hm-rate-n{font-size:clamp(96px,15vw,200px)}.hm-rate h3{margin-top:56px}.hm-fix{gap:16px}.hm-fix>div{border-radius:22px;padding:24px 24px 12px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16)}.hm-fix b{font-size:18px}.hm-rate .hm-k{color:#f3c46c}
.hm-hc{padding-top:0;margin-top:104px}.hm-hc-g{background:radial-gradient(50% 70% at 100% 0,rgba(243,196,108,.28),transparent 70%),linear-gradient(135deg,#eef4f6,#f6f1e8);border-radius:40px;padding:72px 64px;gap:56px}.hc-card{border-radius:24px;padding:22px 24px;max-width:460px;box-shadow:0 40px 80px -40px rgba(16,58,79,.45)}.hm-hc p,.hm-hc-l{font-size:17.5px}
.hm-stack{border:0;gap:24px;margin-top:104px}.hm-stack article{display:grid;grid-template-columns:1fr 1.3fr;gap:56px;align-items:center;border:0;background:#f4f7f8;border-radius:40px;padding:64px 0 64px 64px;overflow:hidden}.hm-stack article:nth-child(even){grid-template-columns:1.3fr 1fr;padding:64px 64px 64px 0}.hm-stack article:nth-child(even) .hm-fimg{order:-1}
.hm-stack p{font-size:17.5px}.hm-fimg{margin:0}.hm-fimg img{display:block;width:118%;max-width:none;height:auto;border-radius:16px 0 0 16px;box-shadow:0 40px 80px -30px rgba(16,58,79,.45),0 0 0 1px rgba(16,58,79,.08)}.hm-stack article:nth-child(even) .hm-fimg img{margin-left:-18%;border-radius:0 16px 16px 0}
.hm-stack article:nth-child(2){background:linear-gradient(135deg,#102838,#1d5670);color:#fff}.hm-stack article:nth-child(2) p{color:rgba(255,255,255,.84)}.hm-stack article:nth-child(2) .hm-k{color:#f3c46c}.hm-stack article:nth-child(2) a.arw{color:#f3c46c}
.hm-sw{margin-top:104px;padding:56px 64px;border-radius:40px;background:#f4f7f8;max-width:calc(var(--hm-w) - 40px)}.hm-sw p{font-size:17.5px;max-width:70ch}.hm-ic{background:#fff}
.hm-facts{border:0;border-radius:22px;background:#f4f7f8;padding:10px 24px}.hm-tech{gap:16px}.hm-tech>div{border-top:0;background:#f4f7f8;border-radius:22px;padding:22px 22px 14px}.hm-tech-h{font-size:28px;margin-top:56px}.hm-av{width:84px;height:84px}
.hm-cards{gap:20px}.hm-card{border-radius:22px;overflow:hidden}.hm-cv{border-radius:22px}.hm-qc{border:0;border-radius:22px;background:#f4f7f8;padding:24px}
.hm-promo{margin-top:112px;padding:64px;border-radius:40px;background:radial-gradient(50% 70% at 0 100%,rgba(233,128,106,.18),transparent 70%),linear-gradient(135deg,#eef4f6,#f6f1e8);max-width:calc(var(--hm-w) - 40px)}
.hm-rv{opacity:0;transform:translateY(34px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}.hm-rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.hm-rv{opacity:1;transform:none;transition:none}}
@media (prefers-color-scheme:dark){.hm-task,.hm-stack article,.hm-sw,.hm-facts,.hm-tech>div,.hm-qc{background:var(--surface)}.hm-hc-g,.hm-promo{background:var(--surface)}.hm-task:after,.hm-ic{background:var(--bg);color:var(--ink)}.hm .hm-k{color:var(--accent)}}
@media (max-width:900px){.hm-stack article,.hm-stack article:nth-child(even){grid-template-columns:1fr;padding:36px 28px 0;gap:28px;border-radius:28px}.hm-stack article:nth-child(even) .hm-fimg{order:0}.hm-fimg img,.hm-stack article:nth-child(even) .hm-fimg img{width:112%;margin-left:0;border-radius:14px 0 0 0}.hm-hc-g{padding:36px 24px;border-radius:28px}.hm-rate{margin:72px 8px 0;border-radius:28px;padding:56px 0 44px}.hm-sw,.hm-promo{padding:32px 24px;border-radius:28px;margin-left:12px;margin-right:12px}.hm-sec,.hm-co{padding-top:72px}.hm-stack,.hm-hc,.hm-sw,.hm-promo{margin-top:72px}.hm-tasks{padding-top:56px}}
