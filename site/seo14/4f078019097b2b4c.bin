<link rel="stylesheet" href="/s-13vep8.css"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://nclexsim.com/"},{"@type":"ListItem","position":2,"name":"Board compliance","item":"https://nclexsim.com/nursing-board-compliance"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Vexcura board compliance","description":"Board of nursing compliance for prelicensure nursing programs in Georgia, Tennessee and Alabama: 142 cited requirements checked against the program's own records, a program-generated self-report PDF, and a free read-only portal for boards.","url":"https://nclexsim.com/nursing-board-compliance","applicationCategory":"EducationalApplication","applicationSubCategory":"Nursing education","operatingSystem":"Any (web browser)","featureList":["Rule profiles for Georgia, Tennessee and Alabama ADN, BSN and PN programs","142 cited requirements","Met, At risk, Not met and Not enough data for each requirement","Requirement drill-downs with the rule, citation and verified date","Alerts for students short of planned clinical hours","Program-generated self-report PDF","School-controlled sharing of aggregate counts with the board","Free read-only board portal"],"audience":{"@type":"EducationalAudience","educationalRole":"teacher","audienceType":"Nursing schools, nursing faculty and clinical instructors"},"publisher":{"@id":"https://nclexsim.com/#org"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which states and programs does it cover?","acceptedAnswer":{"@type":"Answer","text":"Georgia, Tennessee and Alabama, for ADN, BSN and practical nursing (PN) programs: 142 cited requirements in all. Rules were verified on November 6, 2026."}},{"@type":"Question","name":"What does it check?","acceptedAnswer":{"@type":"Answer","text":"Clinical hours and clinical areas, simulation limits, faculty-to-student and preceptor ratios, faculty and preceptor qualifications, curriculum, the board's NCLEX first-time pass-rate standard, the annual report, records, student requirements and clinical sites, as each state's rules set them."}},{"@type":"Question","name":"Is this legal advice or a board determination?","acceptedAnswer":{"@type":"Answer","text":"No. It's a program-generated summary of your own records against each rule as Vexcura reads it. Confirm with your board; it isn't legal advice, and it isn't a determination of compliance."}},{"@type":"Question","name":"Who can share our summary with the board?","acceptedAnswer":{"@type":"Answer","text":"Only your school's program admin can turn sharing on or off, and Vexcura can't. Sharing sends aggregate counts only, with no student names or IDs, and every change is written to the audit log. You can turn it off at any time."}},{"@type":"Question","name":"Do boards of nursing pay?","acceptedAnswer":{"@type":"Answer","text":"No. Board portal accounts are free and read-only. Vexcura sets them up for board staff on request; there's no public sign-up."}},{"@type":"Question","name":"Does the PDF include student names?","acceptedAnswer":{"@type":"Answer","text":"Only if you choose. An \"Include student names\" box controls the student hour list and named alerts. Every page says the report is program-generated and isn't an official board document."}},{"@type":"Question","name":"Does Vexcura file our annual report?","acceptedAnswer":{"@type":"Answer","text":"No. You file with your board the way you do now. The workspace tracks the due date, and you mark the report submitted once it's filed."}},{"@type":"Question","name":"What does it cost?","acceptedAnswer":{"@type":"Answer","text":"Board compliance is included in every plan, and boards never pay. The school or facility licenses Vexcura: Per student $199 per student seat; Site 100 $15,000; Site 250 $30,000; Site 500 $50,000; Custom Custom quote, per year."}}]}</script></head><body><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><style>@property --vxa{syntax:"<color>";inherits:true;initial-value:#4b4f86}@property --vxb{syntax:"<color>";inherits:true;initial-value:#d77a6a}@property --vxc{syntax:"<color>";inherits:true;initial-value:#f8c27a}@property --vxrb{syntax:"<color>";inherits:true;initial-value:#f8c27a}@property --vxrc{syntax:"<color>";inherits:true;initial-value:#d77a6a}:root{--vxa:#4b4f86;--vxb:#d77a6a;--vxc:#f8c27a;--vxrb:#f8c27a;--vxrc:#d77a6a;transition:--vxa 4s ease,--vxb 4s ease,--vxc 4s ease,--vxrb 4s ease,--vxrc 4s ease}html[data-vxscene="dawn"]{--vxa:#7e6a8e;--vxb:#d9826f;--vxc:#eaa874;--vxrb:#fbd3c0;--vxrc:#f2a98e}html[data-vxscene="morning"]{--vxa:#1d5670;--vxb:#3f8fae;--vxc:#e2a648;--vxrb:#bfe3f1;--vxrc:#ffe2a0}html[data-vxscene="midday"]{--vxa:#1d5670;--vxb:#2f85a8;--vxc:#56acd3;--vxrb:#a9dcf1;--vxrc:#6fbfe6}html[data-vxscene="afternoon"]{--vxa:#356f8f;--vxb:#c99a3e;--vxc:#b8642c;--vxrb:#f6e2bc;--vxrc:#e8b45a}html[data-vxscene="sunset"]{--vxa:#4b4f86;--vxb:#d77a6a;--vxc:#f8c27a;--vxrb:#f8c27a;--vxrc:#d77a6a}html[data-vxscene="night"]{--vxa:#1d3557;--vxb:#4b6a9a;--vxc:#d9b25a;--vxrb:#c9d6ea;--vxrc:#ffd77a}@media (prefers-reduced-motion:reduce){:root{transition:none}}</style><script>(function(){var h=new Date().getHours(),k=h<5?"night":h<8?"dawn":h<11?"morning":h<14?"midday":h<17?"afternoon":h<20?"sunset":"night";document.documentElement.setAttribute("data-vxscene",k)})()</script><defs><linearGradient id="sxrW" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:var(--vxa);stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxrWr" gradientUnits="userSpaceOnUse" 