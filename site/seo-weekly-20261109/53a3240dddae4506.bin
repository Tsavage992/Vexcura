<link rel="stylesheet" href="/s-18v2lq.css"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Quiz","name":"Safety and Infection Prevention and Control NCLEX practice questions","url":"https://nclexsim.com/nclex-practice-questions/safety-and-infection-control","about":{"@type":"Thing","name":"NCLEX-RN"},"educationalLevel":"Nursing licensure exam preparation","inLanguage":"en-US","isAccessibleForFree":true,"hasPart":[{"@type":"Question","eduQuestionType":"Multiple choice","text":"After caring for a client with Clostridioides difficile, how should the nurse clean their hands?","url":"https://nclexsim.com/nclex-questions/caring-clostridioides-difficile-clean-hands-sic-002","acceptedAnswer":{"@type":"Answer","text":"Wash with soap and water after removing gloves","answerExplanation":{"@type":"Comment","text":"C. difficile forms spores that alcohol does not kill. Soap and water with friction physically removes spores. Gloves never replace hand hygiene."}},"suggestedAnswer":[{"@type":"Answer","text":"Use alcohol rub before and after glove use"},{"@type":"Answer","text":"Wear two pairs of gloves and skip hand hygiene"},{"@type":"Answer","text":"Use an alcohol-based hand rub after removing gloves"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"A client reports allergies to bananas, avocados, and kiwi. What should the nurse ask about next?","url":"https://nclexsim.com/nclex-questions/reports-allergies-bananas-avocados-kiwi-ask-next-sic-018","acceptedAnswer":{"@type":"Answer","text":"Latex allergy","answerExplanation":{"@type":"Comment","text":"These foods cross-react with latex (latex-fruit syndrome). The nurse should screen for latex allergy and use latex-free equipment if present."}},"suggestedAnswer":[{"@type":"Answer","text":"Iodine allergy"},{"@type":"Answer","text":"Penicillin allergy"},{"@type":"Answer","text":"Egg allergy"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"A client is admitted with suspected pulmonary tuberculosis. Which precautions should the nurse implement?","url":"https://nclexsim.com/nclex-questions/admitted-suspected-pulmonary-tuberculosis-precautions-implement-sic-001","acceptedAnswer":{"@type":"Answer","text":"Airborne precautions in a negative-pressure room with an N95 respirator","answerExplanation":{"@type":"Comment","text":"TB spreads by airborne droplet nuclei. Clients need an airborne infection isolation (negative-pressure) room, and staff wear a fit-tested N95 or higher respirator. Precautions start on suspicion, not after confirmation."}},"suggestedAnswer":[{"@type":"Answer","text":"Contact precautions with a gown and gloves"},{"@type":"Answer","text":"Droplet precautions with a surgical mask"},{"@type":"Answer","text":"Standard precautions only until sputum results return"}]},{"@type":"Question","eduQuestionType":"Checkbox","text":"A client has MRSA in a wound. Which actions are part of contact precautions? Select all that apply.","url":"https://nclexsim.com/nclex-questions/mrsa-wound-actions-part-contact-precautions-select-sic-019","acceptedAnswer":[{"@type":"Answer","text":"Place the client in a private room or cohort with another MRSA client","answerExplanation":{"@type":"Comment","text":"Contact precautions require gown and gloves, dedicated or disinfected equipment, and a private room or cohorting. N95 respirators and negative pressure are airborne precautions."}},{"@type":"Answer","text":"Wear a gown and gloves when entering the room","answerExplanation":{"@type":"Comment","text":"Contact precautions require gown and gloves, dedicated or disinfected equipment, and a private room or cohorting. N95 respirators and negative pressure are airborne precautions."}},{"@type":"Answer","text":"Use dedicated equipment such as a stethoscope","answerExplanation":{"@type":"Comment","text":"Contact precautions require gown and gloves, dedicated or disinfected equipment, and a private room or cohorting. N95 respirators and negative pressure are airborne precautions."}}],"suggestedAnswer":[{"@type":"Answer","text":"Keep the client in a negative-pressure room"},{"@type":"Answer","text":"Wear an N95 respirator for all care"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which action breaks sterile technique?","url":"https://nclexsim.com/nclex-questions/action-breaks-sterile-technique-sic-011","acceptedAnswer":{"@type":"Answer","text":"Holding sterile gloved hands below the waist","answerExplanation":{"@type":"Comment","text":"Anything below the waist or out of sight is considered contaminated. The outer inch of the field is nonsterile, the nurse should always face the field, and pouring without contact keeps the field sterile."}},"suggestedAnswer":[{"@type":"Answer","text":"Facing the sterile field at all times"},{"@type":"Answer","text":"Keeping a 1-inch (2.5 cm) border around the sterile field as nonsterile"},{"@type":"Answer","text":"Pouring sterile solution without touching the container to the field"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"A nurse gets a needlestick injury from a used needle. What should the nurse do first?","url":"https://nclexsim.com/nclex-questions/gets-needlestick-injury-used-needle-sic-013","acceptedAnswer":{"@type":"Answer","text":"Wash the site with soap and water","answerExplanation":{"@type":"Comment","text":"Immediately wash with soap and water, then report so post-exposure evaluation and prophylaxis can start, ideally within hours. Squeezing and caustic agents are not recommended."}},"suggestedAnswer":[{"@type":"Answer","text":"Squeeze the site to make it bleed"},{"@type":"Answer","text":"Report to employee health for testing"},{"@type":"Answer","text":"Apply bleach to the puncture site"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which intervention is most appropriate for a client at high risk for falls?","url":"https://nclexsim.com/nclex-questions/intervention-appropriate-high-risk-falls-sic-008","acceptedAnswer":{"@type":"Answer","text":"Keep the bed in the lowest position with the wheels locked","answerExplanation":{"@type":"Comment","text":"A low, locked bed reduces injury if the client gets up or falls. Four raised side rails are a restraint and increase injury from climbing over. Rooms should have a night light, and the call light should be within reach on the stronger side."}},"suggestedAnswer":[{"@type":"Answer","text":"Place the call light on the client's weaker side"},{"@type":"Answer","text":"Keep the room dark to promote sleep"},{"@type":"Answer","text":"Raise all four side rails at night"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"After giving a subcutaneous injection, what should the nurse do with the needle?","url":"https://nclexsim.com/nclex-questions/giving-subcutaneous-injection-needle-sic-012","acceptedAnswer":{"@type":"Answer","text":"Activate the safety device and place it in a sharps container right away","answerExplanation":{"@type":"Comment","text":"Needles are not recapped by hand, bent, or broken. Use the safety device and discard immediately in a puncture-resistant sharps container at the point of use."}},"suggestedAnswer":[{"@type":"Answer","text":"Bend the needle before disposal"},{"@type":"Answer","text":"Place it on the bedside table to dispose of later"},{"@type":"Answer","text":"Recap the needle using both hands"}]}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://nclexsim.com/"},{"@type":"ListItem","position":2,"name":"Practice questions","item":"https://nclexsim.com/nclex-practice-questions"},{"@type":"ListItem","position":3,"name":"Safety and Infection Prevention and Control","item":"https://nclexsim.com/nclex-practice-questions/safety-and-infection-control"}]}</script></head><body><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg 