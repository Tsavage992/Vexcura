[{"k":"page","t":"Management of Care NCLEX Practice Questions","x":"Management of Care is the largest NCLEX-RN category: 15–21% of the exam. Free prioritization and delegation questions with answers, rationales, and sources.","u":"/nclex-practice-questions/management-of-care"},{"k":"page","t":"Safety and Infection Prevention and Control NCLEX Practice Questions","x":"Free Safety and Infection Prevention and Control NCLEX-RN practice questions on isolation, PPE, and safety, with answers, rationales, and sources. 10–16% of…","u":"/nclex-practice-questions/safety-and-infection-control"},{"k":"page","t":"Health Promotion and Maintenance NCLEX Practice Questions","x":"Free Health Promotion and Maintenance NCLEX-RN practice questions on maternity, pediatrics, and screening, with answers, rationales, and sources. 6–12% of…","u":"/nclex-practice-questions/health-promotion-and-maintenance"},{"k":"page","t":"Psychosocial Integrity NCLEX Practice Questions","x":"Free Psychosocial Integrity NCLEX-RN practice questions on mental health and therapeutic communication, with answers, rationales, and sources. 6–12% of the…","u":"/nclex-practice-questions/psychosocial-integrity"},{"k":"page","t":"Basic Care and Comfort NCLEX Practice Questions","x":"Free Basic Care and Comfort NCLEX-RN practice questions on mobility, nutrition, and comfort, with answers, rationales, and sources. 6–12% of the exam.","u":"/nclex-practice-questions/basic-care-and-comfort"},{"k":"page","t":"Pharmacological and Parenteral Therapies NCLEX Practice Questions","x":"Free Pharmacological and Parenteral Therapies NCLEX-RN practice questions on pharmacology and dosage calculation, with answers, rationales, and sources.…","u":"/nclex-practice-questions/pharmacology"},{"k":"page","t":"Reduction of Risk Potential NCLEX Practice Questions","x":"Free Reduction of Risk Potential NCLEX-RN practice questions on lab values, ABGs, and procedures, with answers, rationales, and sources. 9–15% of the exam.","u":"/nclex-practice-questions/reduction-of-risk-potential"},{"k":"page","t":"Physiological Adaptation NCLEX Practice Questions","x":"Free Physiological Adaptation NCLEX-RN practice questions on emergencies, shock, and electrolytes, with answers, rationales, and sources. 11–17% of the exam.","u":"/nclex-practice-questions/physiological-adaptation"},{"k":"page","t":"NCLEX Dosage Calculation Practice Questions","x":"Free NCLEX dosage calculation practice: tablets, liquids, IV rates, mg/kg, and intake and output, with worked solutions and sources.","u":"/nclex-dosage-calculation-practice"},{"k":"page","t":"NCLEX Prioritization and Delegation Questions","x":"Free NCLEX prioritization and delegation questions with rationales: who you see first, and what the RN, LPN and assistive personnel can each do.","u":"/nclex-prioritization-questions"},{"k":"sec","t":"Delegation questions: RN, LPN and assistive personnel","x":"","u":"/nclex-prioritization-questions#delegation","p":"NCLEX Prioritization and Delegation Questions"},{"k":"page","t":"Free NCLEX-RN Practice Questions with Rationales","x":"Free NCLEX-RN practice questions with rationales and sources in all 8 client needs categories. A free account adds all 1,220, NGN items and CAT exams.","u":"/nclex-practice-questions"},{"k":"page","t":"Next Generation NCLEX: How It Works and How to Practice","x":"How the Next Generation NCLEX works: the clinical judgment model, case studies, bowtie, matrix, cloze, and highlight items, partial-credit scoring, and free practice.","u":"/next-generation-nclex"},{"k":"page","t":"Free Full-Length NCLEX-RN Practice Exam (Adaptive CAT)","x":"A free, full-length NCLEX-RN practice exam that adapts like the CAT: 85 to 150 items, NGN case studies, real stopping rules and rationales for every item.","u":"/free-nclex-practice-exam"},{"k":"sec","t":"Rehearse test day before test day","x":"","u":"/free-nclex-practice-exam#test-day","p":"Free Full-Length NCLEX-RN Practice Exam (Adaptive CAT)"},{"k":"sec","t":"Can you take the NCLEX at home?","x":"","u":"/free-nclex-practice-exam#at-home","p":"Free Full-Length NCLEX-RN Practice Exam (Adaptive CAT)"},{"k":"sec","t":"One license instead of separate tools","x":"","u":"/free-nclex-practice-exam#vxs-h","p":"Free Full-Length NCLEX-RN Practice Exam (Adaptive CAT)"},{"k":"page","t":"NCLEX Lab Values: Normal Ranges to Know","x":"NCLEX lab values cheat sheet: normal adult ranges for electrolytes, CBC, coagulation, ABGs, renal, glucose, and drug levels, with practice questions and rationales.","u":"/nclex-lab-values"},{"k":"sec","t":"Practice lab value questions","x":"","u":"/nclex-lab-values#lab-questions","p":"NCLEX Lab Values: Normal Ranges to Know"},{"k":"page","t":"NCLEX Prep Compared: What Each Program Includes","x":"NCLEX-RN prep compared: prices, question counts, and adaptive exams for UWorld, Archer Review, Kaplan, SimpleNursing, and Vexcura. Updated November 2026.","u":"/nclex-prep-comparison"},{"k":"page","t":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School","x":"NCLEX-RN prep, an Epic-style academic EHR and instructor tools in one license, free for students and instructors. Plans from $199 per student seat.","u":"/for-nursing-schools"},{"k":"sec","t":"Board compliance for GA, TN and AL programs","x":"","u":"/for-nursing-schools#board-compliance","p":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School"},{"k":"sec","t":"What your faculty run the program on","x":"","u":"/for-nursing-schools#program-tools","p":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School"},{"k":"sec","t":"The clinical instructor workspace","x":"","u":"/for-nursing-schools#instructors","p":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School"},{"k":"sec","t":"LMS integration","x":"","u":"/for-nursing-schools#lms","p":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School"},{"k":"sec","t":"NCLEX remediation from the scores you already have","x":"","u":"/for-nursing-schools#remediation","p":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School"},{"k":"sec","t":"Pricing: every plan includes everything","x":"","u":"/for-nursing-schools#pricing","p":"NCLEX Prep and an Academic EHR, Licensed to Your Nursing School"},{"k":"page","t":"An Epic-Style Academic EHR for Nursing Students","x":"A simulated, Epic-style academic EHR for nursing students and schools: My Chart, MAR, flowsheets and orders on made-up patients. Free for every student.","u":"/academic-ehr-for-nursing-students"},{"k":"sec","t":"Barcode scanning with no scanner to buy","x":"","u":"/academic-ehr-for-nursing-students#scanning","p":"An Epic-Style Academic EHR for Nursing Students"},{"k":"sec","t":"Made for iPad and Apple Pencil","x":"","u":"/academic-ehr-for-nursing-students#pencil","p":"An Epic-Style Academic EHR for Nursing Students"},{"k":"sec","t":"SDOH screening and Secure Chat","x":"","u":"/academic-ehr-for-nursing-students#sdoh","p":"An Epic-Style Academic EHR for Nursing Students"},{"k":"sec","t":"One Library, and everything else under More","x":"","u":"/academic-ehr-for-nursing-students#library","p":"An Epic-Style Academic EHR for Nursing Students"},{"k":"sec","t":"One license instead of separate tools","x":"","u":"/academic-ehr-for-nursing-students#vxs-h","p":"An Epic-Style Academic EHR for Nursing Students"},{"k":"page","t":"Nursing Simulation Scenarios for Clinical Judgment Practice","x":"Virtual nursing simulation: an adaptive deteriorating-patient drill with 59 hidden cases up to the ICU, telemetry and EKG with calipers, and ACLS megacodes.","u":"/nursing-simulation-scenarios"},{"k":"sec","t":"The deteriorating-patient drill","x":"","u":"/nursing-simulation-scenarios#deteriorating-patient","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Debrief and scoring by competency","x":"","u":"/nursing-simulation-scenarios#scoring","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Built for clinical judgment","x":"","u":"/nursing-simulation-scenarios#cjmm","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"From one patient to a full assignment","x":"","u":"/nursing-simulation-scenarios#coordination","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Telemetry and EKG","x":"","u":"/nursing-simulation-scenarios#telemetry","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Assessment and Auscultation","x":"","u":"/nursing-simulation-scenarios#auscultation","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"ACLS megacodes","x":"","u":"/nursing-simulation-scenarios#acls","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Bedside cases","x":"","u":"/nursing-simulation-scenarios#bedside","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"How instructors assign drills","x":"","u":"/nursing-simulation-scenarios#assign","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Coming soon: virtual clinical days and VR","x":"","u":"/nursing-simulation-scenarios#coming-soon","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"sec","t":"Included in every plan","x":"","u":"/nursing-simulation-scenarios#pricing","p":"Nursing Simulation Scenarios for Clinical Judgment Practice"},{"k":"page","t":"Turn your ATI score report into a remediation and NCLEX study plan","x":"Turn an ATI score report into a remediation study plan: each topic to review becomes drills, guides and a checkpoint quiz. Works with HESI, Kaplan and UWorld.","u":"/ati-score-report-study-plan"},{"k":"sec","t":"How Bring your scores works","x":"","u":"/ati-score-report-study-plan#how","p":"Turn your ATI score report into a remediation and NCLEX study plan"},{"k":"sec","t":"HESI, Kaplan and UWorld reports work the same way","x":"","u":"/ati-score-report-study-plan#other-reports","p":"Turn your ATI score report into a remediation and NCLEX study plan"},{"k":"sec","t":"Sources","x":"","u":"/ati-score-report-study-plan#sources","p":"Turn your ATI score report into a remediation and NCLEX study plan"},{"k":"page","t":"About Vexcura","x":"Vexcura is NCLEX-RN prep and an Epic-style academic EHR, licensed to nursing schools and free for students. Founded by Tyler Savage, RN, CRS, LNC, a nurse with over a decade at the bedside.","u":"/about"},{"k":"sec","t":"Meet the founder","x":"","u":"/about#founder","p":"About Vexcura"},{"k":"guide","t":"Studying with AI, Safely","x":"A free guide for nursing students: how to use AI chatbots to study, how they get facts wrong, what never to paste into one, and how to check any answer against credible sources.","u":"/study-guides/ai-for-nursing-students"},{"k":"guide","t":"The 60-Second Fact-Check Card","x":"A free one-page printable for nursing students: check any fact from AI or social media in four steps, know which sources to trust, and spot red flags.","u":"/study-guides/fact-check-card"},{"k":"guide","t":"Lab Values Quick Reference","x":"Free printable NCLEX lab values quick reference: typical adult ranges for electrolytes, CBC, coagulation, ABGs, renal function, glucose, and therapeutic drug levels.","u":"/study-guides/lab-values-quick-reference"},{"k":"guide","t":"The NCLEX-RN at a Glance","x":"Free printable summary of the NCLEX-RN test plan: the 8 client needs categories and their percentages, the 6 clinical judgment steps, exam length, and NGN item types.","u":"/study-guides/nclex-test-plan-at-a-glance"},{"k":"guide","t":"Prioritization and Delegation","x":"Free printable NCLEX prioritization and delegation guide: ABCs, Maslow, acute versus chronic, the five rights of delegation, and what RNs, LPN/VNs, and assistive personnel can do.","u":"/study-guides/prioritization-and-delegation"},{"k":"guide","t":"Dosage Calculation Formulas","x":"Free printable dosage calculation formula sheet for nursing students: conversions, desired-over-have, weight-based doses, IV pump and drip rates, heparin and titrated drips, with worked examples.","u":"/study-guides/dosage-calculation-formulas"},{"k":"guide","t":"Infection Control and Isolation Precautions","x":"Free printable isolation precautions chart for nursing students: standard, contact, droplet, and airborne precautions, example infections, PPE donning and doffing order, and hand hygiene.","u":"/study-guides/isolation-precautions"},{"k":"guide","t":"Heart Failure: Left vs. Right","x":"Free one-page visual cheat sheet: left- vs right-sided heart failure signs, guideline medicines, daily weight rules, BNP, and acute pulmonary edema priorities for the NCLEX.","u":"/study-guides/heart-failure-left-vs-right"},{"k":"guide","t":"DKA vs. HHS, Plus Insulin Timing","x":"Free one-page visual: DKA vs HHS criteria from the 2024 consensus report, treatment order, potassium before insulin, insulin onset-peak-duration chart, and hypoglycemia rule of 15.","u":"/study-guides/dka-vs-hhs"},{"k":"guide","t":"Electrolytes: Low vs. High","x":"Free one-page visual cheat sheet of electrolyte imbalances for nursing students: hypo and hyper potassium, sodium, calcium, and magnesium signs, ECG changes, causes, and treatment.","u":"/study-guides/electrolyte-imbalances"},{"k":"guide","t":"ABGs in 3 Steps","x":"Free one-page visual for arterial blood gas interpretation: normal values, the ROME method, compensation, the four acid-base disorders with causes, and worked examples.","u":"/study-guides/abg-interpretation"},{"k":"guide","t":"Shock: The 4 Types","x":"Free one-page visual on the four types of shock for nursing students: causes, signs, treatment, MAP and urine output targets, and the Surviving Sepsis first-hour steps.","u":"/study-guides/types-of-shock"},{"k":"guide","t":"Stroke: BE-FAST and the First Hour","x":"Free one-page visual stroke cheat sheet: BE-FAST signs, ischemic vs hemorrhagic stroke, thrombolytic window and blood pressure limits, first-hour priorities, and left vs right brain deficits.","u":"/study-guides/stroke-be-fast"},{"k":"guide","t":"COPD vs. Asthma","x":"Free one-page visual comparing COPD and asthma for nursing students: causes, signs, rescue and controller inhalers, oxygen saturation targets, peak flow zones, and emergency red flags.","u":"/study-guides/copd-vs-asthma"},{"k":"guide","t":"Thyroid and Adrenal: Hyper vs. Hypo","x":"Free one-page visual for nursing students: hyperthyroidism vs hypothyroidism and Cushing syndrome vs Addison disease, with signs, treatment, thyroid storm, myxedema coma, and adrenal crisis.","u":"/study-guides/thyroid-and-adrenal-disorders"},{"k":"guide","t":"Kidney Injury: AKI vs. CKD","x":"Free one-page visual for nursing students on acute kidney injury vs chronic kidney disease: KDIGO definitions, prerenal, intrarenal and postrenal causes, CKD stages by GFR, labs, and fistula care.","u":"/study-guides/aki-vs-ckd"},{"k":"guide","t":"Burns: Rule of Nines and Fluids","x":"Free one-page visual burn cheat sheet for nursing students: adult rule of nines diagram, burn depth, Parkland formula with a worked example, current fluid guidance, and airway priorities.","u":"/study-guides/burns-rule-of-nines"},{"k":"guide","t":"Pharm: High-Alert Meds and Antidotes","x":"Free one-page pharmacology visual for nursing students: high-alert medication classes, antidotes and reversal agents, therapeutic drug levels, and safety checks before giving.","u":"/study-guides/high-alert-meds-and-antidotes"},{"k":"guide","t":"OB: Fetal Heart Rate, Preeclampsia, PPH","x":"Free one-page OB visual for nursing students: fetal heart rate baseline and decelerations with VEAL CHOP, intrauterine resuscitation, magnesium sulfate safety, and postpartum hemorrhage management.","u":"/study-guides/ob-fetal-heart-rate-and-postpartum"},{"k":"guide","t":"Psych: Meds, Side Effects, Communication","x":"Free one-page mental health nursing visual: antipsychotic extrapyramidal effects, NMS vs serotonin syndrome, lithium toxicity, MAOI diet, clozapine monitoring, and therapeutic communication.","u":"/study-guides/psych-meds-and-communication"},{"k":"guide","t":"ICU: Hemodynamics, Pressors, Vent Alarms","x":"Free one-page critical care visual for nursing students: normal hemodynamic values, vasopressors and inotropes, ventilator alarm troubleshooting with DOPE, and intracranial pressure basics.","u":"/study-guides/icu-hemodynamics-and-drips"},{"k":"guide","t":"NIH Stroke Scale (NIHSS) at a Glance","x":"Free one-page NIHSS visual for nursing students: all 15 items with score ranges, scoring rules for motor drift, ataxia and language, and what the total score means.","u":"/study-guides/nihss-stroke-scale"},{"k":"guide","t":"ER: ESI Triage and START","x":"Free one-page emergency nursing visual: Emergency Severity Index (ESI) levels 1 to 5 with decision points, danger-zone vital signs, and START mass-casualty triage colors.","u":"/study-guides/er-triage-esi-and-start"},{"k":"guide","t":"IV Safety: Fluids, Complications, Hanging Meds","x":"Free one-page IV safety visual for nursing students: how to hang an IV medication safely, IV fluid types, infiltration vs extravasation vs phlebitis, air embolism, drip rate formula, and blood transfusion rules.","u":"/study-guides/iv-safety-and-hanging-meds"},{"k":"page","t":"Free NCLEX Study Guides","x":"Free printable NCLEX-RN study guides and one-page visual sheets: AI safety, lab values, prioritization, heart failure, DKA, ABGs, shock, stroke, high-alert meds, OB, psych, ICU, NIHSS, ER triage, IV safety, ECG rhythms, transfusion reactions, pediatric milestones, labor and APGAR, chest tubes, pressure injuries, oxygen devices, falls and restraints.","u":"/nclex-study-guides"},{"k":"sec","t":"Med-surg visual sheets","x":"","u":"/nclex-study-guides#med-surg","p":"Free NCLEX Study Guides"},{"k":"sec","t":"Specialty visual sheets","x":"","u":"/nclex-study-guides#specialty","p":"Free NCLEX Study Guides"},{"k":"page","t":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass","x":"Vexcura's NCLEX pass guarantee: meet every condition, don't pass your first attempt after signing, and get your registration fee back, up to $200. Full terms.","u":"/nclex-pass-guarantee"},{"k":"sec","t":"How it works, step by step","x":"","u":"/nclex-pass-guarantee#how","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"The Usage Score: what earns points","x":"","u":"/nclex-pass-guarantee#usage-score","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"What counts as a Qualifying Exam","x":"","u":"/nclex-pass-guarantee#qualifying-exam","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"How to submit a claim","x":"","u":"/nclex-pass-guarantee#claim","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"What doesn't qualify","x":"","u":"/nclex-pass-guarantee#not-covered","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"The full agreement","x":"","u":"/nclex-pass-guarantee#agreement","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"For nursing schools","x":"","u":"/nclex-pass-guarantee#schools","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"sec","t":"Questions about the NCLEX pass guarantee (fee reimbursement)","x":"","u":"/nclex-pass-guarantee#faq","p":"NCLEX Pass Guarantee: Your Registration Fee Back if You Qualify and Don't Pass"},{"k":"page","t":"Better-prepared nurses, for every patient","x":"The communities Vexcura aims to reach, from nursing students and schools to hospitals, rural programs and new nurses, and how we plan to help each one.","u":"/software"},{"k":"sec","t":"Who we serve, and how we plan to help","x":"","u":"/software#cmh","p":"Better-prepared nurses, for every patient"},{"k":"page","t":"Every stage of nursing school, in one place","x":"The nursing-school study platform for every stage: fundamentals, pharmacology, dosage calc, med-surg, care plans, clinicals, and NCLEX prep. Free for students.","u":"/for-nursing-students"},{"k":"page","t":"Academic EHR Comparison: SimChart Alternatives for Nursing Schools","x":"Compare academic EHRs for nursing schools: SimChart, EHR Go, DocuCare and Vexcura. Published prices, who pays, features, and a cost estimator.","u":"/academic-ehr-comparison"},{"k":"sec","t":"Academic EHRs for nursing schools at a glance","x":"","u":"/academic-ehr-comparison#compare","p":"Academic EHR Comparison: SimChart Alternatives for Nursing Schools"},{"k":"sec","t":"How to choose an academic EHR: questions to ask every vendor","x":"","u":"/academic-ehr-comparison#choose","p":"Academic EHR Comparison: SimChart Alternatives for Nursing Schools"},{"k":"sec","t":"Sources","x":"","u":"/academic-ehr-comparison#sources","p":"Academic EHR Comparison: SimChart Alternatives for Nursing Schools"},{"k":"page","t":"Practice Charting at Home on Family and Friends","x":"Practice charting at home: take vital signs on family members who say it's OK and chart them in a free Epic-style EHR. Normal ranges, AHA steps, privacy rules.","u":"/practice-charting-at-home"},{"k":"sec","t":"How to practice charting at home","x":"","u":"/practice-charting-at-home#how","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"Normal vital signs for adults at rest","x":"","u":"/practice-charting-at-home#ranges","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"Blood pressure categories (American Heart Association)","x":"","u":"/practice-charting-at-home#bp-categories","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"How to take a blood pressure at home","x":"","u":"/practice-charting-at-home#bp-at-home","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"How to document vital signs","x":"","u":"/practice-charting-at-home#document","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"Privacy rules for practicing on family","x":"","u":"/practice-charting-at-home#privacy","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"Practice charting in Vexcura's EHR","x":"","u":"/practice-charting-at-home#in-vexcura","p":"Practice Charting at Home on Family and Friends"},{"k":"sec","t":"Sources","x":"","u":"/practice-charting-at-home#sources","p":"Practice Charting at Home on Family and Friends"},{"k":"q","t":"Which client care task can the RN delegate to an LPN?","a":"Answer: Administering a scheduled oral antibiotic to a stable client","r":"LPNs can give scheduled medications to stable clients. First-dose IV drugs for new admissions, care planning, and triage require RN assessment and","s":"NCSBN. Model Nursing Practice Act; state LPN scope of practice","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-009","x":"LPNs can give scheduled medications to stable clients. First-dose IV drugs for new admissions, care planning, and triage require RN assessment and judgment."},{"k":"q","t":"Which client should the nurse in the psychiatric unit see first?","a":"Answer: A client who says the voices are telling him to hurt his roommate","r":"Command hallucinations directing harm to others are a safety emergency. The other clients have needs but no immediate","s":"Varcarolis' Foundations of Psychiatric-Mental Health Nursing, 10th ed.","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-004","x":"Command hallucinations directing harm to others are a safety emergency. The other clients have needs but no immediate danger."},{"k":"q","t":"Which client should the nurse in a pediatric clinic see first?","a":"Answer: A 3-year-old who is drooling, sitting forward, and has muffled speech","r":"Drooling, tripod positioning, and a muffled voice suggest epiglottitis or another upper airway obstruction, an","s":"Hockenberry. Wong's Nursing Care of Infants and Children, 12th ed.","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-005","x":"Drooling, tripod positioning, and a muffled voice suggest epiglottitis or another upper airway obstruction, an emergency."},{"k":"q","t":"The RN is caring for clients with an LPN and AP. Which tasks are appropriate to delegate to the AP? Select all that apply.","a":"Answer: Helping a client with a hip fracture use the bedpan; Recording a client's food intake; Measuring vital signs on a stable client after a cholecystectomy","r":"Routine measurements, toileting help, and recording intake are within the AP role for stable clients. Monitoring response to a first opioid dose and teaching require nursing","s":"NCSBN & ANA. National Guidelines for Nursing Delegation (2019)","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-011","x":"Routine measurements, toileting help, and recording intake are within the AP role for stable clients. Monitoring response to a first opioid dose and teaching require nursing assessment."},{"k":"q","t":"Which event is considered a sentinel event?","a":"Answer: A client dies after receiving an incompatible blood transfusion","r":"A sentinel event is a client safety event resulting in death, permanent harm, or severe temporary harm. Hemolytic transfusion reactions involving major blood group incompatibility are on The Joint Commission","s":"The Joint Commission. Sentinel Event Policy and Procedures","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-019","x":"A sentinel event is a client safety event resulting in death, permanent harm, or severe temporary harm. Hemolytic transfusion reactions involving major blood group incompatibility are on The Joint Commission list."},{"k":"q","t":"Which client in a long-term care facility should the nurse see first?","a":"Answer: A resident with a new onset of confusion and a temperature of 100.8°F (38.2°C)","r":"Acute confusion with fever in an older adult may signal sepsis or another acute illness and needs prompt","s":"Lewis's Medical-Surgical Nursing, 13th ed. (older adults)","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-006","x":"Acute confusion with fever in an older adult may signal sepsis or another acute illness and needs prompt assessment."},{"k":"q","t":"Under Medicare, which client is most likely to qualify for home health services?","a":"Answer: A homebound client who needs skilled nursing for wound care","r":"Medicare home health requires that the client be homebound and need intermittent skilled services such as nursing or therapy under a plan of","s":"CMS. Medicare Home Health Services","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-018","x":"Medicare home health requires that the client be homebound and need intermittent skilled services such as nursing or therapy under a plan of care."},{"k":"q","t":"Four clients have new lab results. Which result requires immediate action?","a":"Answer: Glucose of 42 mg/dL in a client receiving insulin","r":"Severe hypoglycemia can cause seizures and brain injury and needs immediate treatment. The others need follow-up but aren't emergencies; an INR of 2.6 is therapeutic for atrial","s":"ADA. Standards of Care in Diabetes, Section 6 (hypoglycemia)","c":"Management of Care","u":"/nclex-practice-questions/management-of-care#moc4-007","x":"Severe hypoglycemia can cause seizures and brain injury and needs immediate treatment. The others need follow-up but aren't emergencies; an INR of 2.6 is therapeutic for atrial fibrillation."},{"k":"q","t":"After caring for a client with Clostridioides difficile, how should the nurse clean their hands?","a":"Answer: Wash with soap and water after removing gloves","r":"C. difficile forms spores that alcohol does not kill. Soap and water with friction physically removes spores. Gloves never replace hand","s":"CDC. Hand Hygiene in Healthcare Settings; C. difficile clinical overview","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-002","x":"C. difficile forms spores that alcohol does not kill. Soap and water with friction physically removes spores. Gloves never replace hand hygiene."},{"k":"q","t":"A client reports allergies to bananas, avocados, and kiwi. What should the nurse ask about next?","a":"Answer: Latex allergy","r":"These foods cross-react with latex (latex-fruit syndrome). The nurse should screen for latex allergy and use latex-free equipment if","s":"ACAAI. Latex Allergy (latex-fruit syndrome)","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-018","x":"These foods cross-react with latex (latex-fruit syndrome). The nurse should screen for latex allergy and use latex-free equipment if present."},{"k":"q","t":"A client is admitted with suspected pulmonary tuberculosis. Which precautions should the nurse implement?","a":"Answer: Airborne precautions in a negative-pressure room with an N95 respirator","r":"TB spreads by airborne droplet nuclei. Clients need an airborne infection isolation (negative-pressure) room, and staff wear a fit-tested N95 or higher respirator. Precautions start on suspicion, not after","s":"CDC. 2007 Guideline for Isolation Precautions; CDC TB Infection Control (2005)","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-001","x":"TB spreads by airborne droplet nuclei. Clients need an airborne infection isolation (negative-pressure) room, and staff wear a fit-tested N95 or higher respirator. Precautions start on suspicion, not after confirmation."},{"k":"q","t":"A client has MRSA in a wound. Which actions are part of contact precautions? Select all that apply.","a":"Answer: Place the client in a private room or cohort with another MRSA client; Wear a gown and gloves when entering the room; Use dedicated equipment such as a stethoscope","r":"Contact precautions require gown and gloves, dedicated or disinfected equipment, and a private room or cohorting. N95 respirators and negative pressure are airborne","s":"CDC. 2007 Guideline for Isolation Precautions (Contact Precautions)","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-019","x":"Contact precautions require gown and gloves, dedicated or disinfected equipment, and a private room or cohorting. N95 respirators and negative pressure are airborne precautions."},{"k":"q","t":"Which action breaks sterile technique?","a":"Answer: Holding sterile gloved hands below the waist","r":"Anything below the waist or out of sight is considered contaminated. The outer inch of the field is nonsterile, the nurse should always face the field, and pouring without contact keeps the field","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (surgical asepsis)","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-011","x":"Anything below the waist or out of sight is considered contaminated. The outer inch of the field is nonsterile, the nurse should always face the field, and pouring without contact keeps the field sterile."},{"k":"q","t":"A nurse gets a needlestick injury from a used needle. What should the nurse do first?","a":"Answer: Wash the site with soap and water","r":"Immediately wash with soap and water, then report so post-exposure evaluation and prophylaxis can start, ideally within hours. Squeezing and caustic agents are not","s":"CDC. Exposure to Blood: What Healthcare Personnel Need to Know","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-013","x":"Immediately wash with soap and water, then report so post-exposure evaluation and prophylaxis can start, ideally within hours. Squeezing and caustic agents are not recommended."},{"k":"q","t":"Which intervention is most appropriate for a client at high risk for falls?","a":"Answer: Keep the bed in the lowest position with the wheels locked","r":"A low, locked bed reduces injury if the client gets up or falls. Four raised side rails are a restraint and increase injury from climbing over. Rooms should have a night light, and the call light should be within reach on the stronger","s":"AHRQ. Preventing Falls in Hospitals Toolkit","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-008","x":"A low, locked bed reduces injury if the client gets up or falls. Four raised side rails are a restraint and increase injury from climbing over. Rooms should have a night light, and the call light should be within reach on the stronger side."},{"k":"q","t":"After giving a subcutaneous injection, what should the nurse do with the needle?","a":"Answer: Activate the safety device and place it in a sharps container right away","r":"Needles are not recapped by hand, bent, or broken. Use the safety device and discard immediately in a puncture-resistant sharps container at the point of","s":"OSHA. Bloodborne Pathogens Standard, 29 CFR 1910.1030","c":"Safety and Infection Prevention and Control","u":"/nclex-practice-questions/safety-and-infection-control#sic-012","x":"Needles are not recapped by hand, bent, or broken. Use the safety device and discard immediately in a puncture-resistant sharps container at the point of use."},{"k":"q","t":"Which contraceptive method also helps protect against sexually transmitted infections?","a":"Answer: Male condom","r":"Latex or polyurethane condoms, used correctly every time, reduce the risk of many STIs. Hormonal methods and IUDs do not protect against","s":"CDC. Sexually Transmitted Infections Treatment Guidelines (2021)","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm3-018","x":"Latex or polyurethane condoms, used correctly every time, reduce the risk of many STIs. Hormonal methods and IUDs do not protect against STIs."},{"k":"q","t":"Which sunscreen guidance should the nurse give?","a":"Answer: Use a broad-spectrum sunscreen with SPF 30 or higher and reapply every 2 hours","r":"Broad-spectrum SPF 30 or higher, applied generously to all exposed skin and reapplied every 2 hours or after swimming or sweating, reduces skin cancer risk. UV rays penetrate","s":"American Academy of Dermatology. How to Select a Sunscreen","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm3-019","x":"Broad-spectrum SPF 30 or higher, applied generously to all exposed skin and reapplied every 2 hours or after swimming or sweating, reduces skin cancer risk. UV rays penetrate clouds."},{"k":"q","t":"A pregnant client asks when she will first feel the baby move. What should the nurse say?","a":"Answer: Usually between 16 and 20 weeks","r":"Quickening, the first maternal perception of fetal movement, usually occurs between 16 and 20 weeks; often earlier in clients who have been pregnant","s":"Lowdermilk. Maternity & Women's Health Care, 13th ed.","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm3-009","x":"Quickening, the first maternal perception of fetal movement, usually occurs between 16 and 20 weeks; often earlier in clients who have been pregnant before."},{"k":"q","t":"Which signs show that an infant is developmentally ready to start solid foods? Select all that apply.","a":"Answer: Has lost the tongue-thrust reflex; Good head and neck control; Shows interest in food when others eat","r":"Readiness for solids usually appears around 6 months: good head control, sitting with support, interest in food, and loss of the tongue-thrust reflex. Crawling isn't","s":"AAP. HealthyChildren.org: Starting Solid Foods","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm4-020","x":"Readiness for solids usually appears around 6 months: good head control, sitting with support, interest in food, and loss of the tongue-thrust reflex. Crawling isn't required."},{"k":"q","t":"Which finding indicates true labor rather than false labor?","a":"Answer: Progressive cervical dilation and effacement","r":"True labor causes progressive cervical change, with contractions that become regular, stronger, and closer, and continue despite activity. False labor contractions are irregular and often ease with rest or","s":"Lowdermilk. Maternity & Women's Health Care, 13th ed. (onset of labor)","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm3-012","x":"True labor causes progressive cervical change, with contractions that become regular, stronger, and closer, and continue despite activity. False labor contractions are irregular and often ease with rest or walking."},{"k":"q","t":"A laboring client is 8 cm dilated, irritable, nauseated, and says she can't go on. Which phase of labor is she in?","a":"Answer: Transition phase of the first stage","r":"Transition is the end of active first stage labor (about 8 to 10 cm). Intense contractions, irritability, nausea, and feeling out of control are","s":"Lowdermilk. Maternity & Women's Health Care, 13th ed. (stages of labor)","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm3-013","x":"Transition is the end of active first stage labor (about 8 to 10 cm). Intense contractions, irritability, nausea, and feeling out of control are common."},{"k":"q","t":"At 1 minute after birth, a newborn has a heart rate of 110/min, a slow, irregular respiratory effort with a weak cry, some flexion of the extremities, a grimace when suctioned, and a pink body with blue hands and feet. What is the Apgar score?","a":"Answer: 6 points","r":"Heart rate over 100 = 2; slow, irregular breathing with weak cry = 1; some flexion = 1; grimace = 1; acrocyanosis = 1. Total = 6. Scores of 7–10 are reassuring; 4–6 means moderate","s":"AAP/ACOG. The Apgar Score (Committee Opinion 644)","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm-013","x":"Heart rate over 100 = 2; slow, irregular breathing with weak cry = 1; some flexion = 1; grimace = 1; acrocyanosis = 1. Total = 6. Scores of 7–10 are reassuring; 4–6 means moderate difficulty."},{"k":"q","t":"A pregnant client has a normal pre-pregnancy BMI. What is the recommended total weight gain?","a":"Answer: 25 to 35 lb (11 to 16 kg)","r":"The IOM recommends 25 to 35 lb for a normal BMI, 28 to 40 lb if underweight, 15 to 25 lb if overweight, and 11 to 20 lb if","s":"IOM. Weight Gain During Pregnancy: Reexamining the Guidelines (2009); ACOG","c":"Health Promotion and Maintenance","u":"/nclex-practice-questions/health-promotion-and-maintenance#hpm3-011","x":"The IOM recommends 25 to 35 lb for a normal BMI, 28 to 40 lb if underweight, 15 to 25 lb if overweight, and 11 to 20 lb if obese."},{"k":"q","t":"A client with schizophrenia stands in the corner staring and doesn't respond to questions. What should the nurse do?","a":"Answer: Stay with the client, speak simply, and check physical needs","r":"For a withdrawn or catatonic client, the nurse offers presence, uses short simple statements, and makes sure basic needs like nutrition, hydration, and toileting are","s":"Varcarolis' Foundations of Psychiatric-Mental Health Nursing, 10th ed.","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-018","x":"For a withdrawn or catatonic client, the nurse offers presence, uses short simple statements, and makes sure basic needs like nutrition, hydration, and toileting are met."},{"k":"q","t":"An older client lives alone, has lost weight, and the home is cluttered with spoiled food. The client is alert and oriented. What should the nurse do?","a":"Answer: Assess the client's ability to care for self and refer to adult protective services or social services for possible self-neglect","r":"Self-neglect is a form of elder mistreatment that can be reported. The nurse assesses safety and connects the client with resources while respecting","s":"National Center on Elder Abuse; state adult protective services statutes","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-021","x":"Self-neglect is a form of elder mistreatment that can be reported. The nurse assesses safety and connects the client with resources while respecting autonomy."},{"k":"q","t":"A client describes feeling detached from their body, as if watching themselves from outside. Which symptom is this?","a":"Answer: Depersonalization","r":"Depersonalization is a sense of detachment from one's body or thoughts. It can occur with severe anxiety, trauma, or dissociative","s":"APA. DSM-5-TR (dissociative symptoms)","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-019","x":"Depersonalization is a sense of detachment from one's body or thoughts. It can occur with severe anxiety, trauma, or dissociative disorders."},{"k":"q","t":"Which communication techniques are therapeutic? Select all that apply.","a":"Answer: Offering self, such as \"I'll stay with you\"; Restating the client's message; Using open-ended questions","r":"Open-ended questions, restating, and offering self encourage communication. Giving approval or disapproval and \"why\" questions can block communication or put clients on the","s":"Varcarolis' Foundations of Psychiatric-Mental Health Nursing, 10th ed.","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-016","x":"Open-ended questions, restating, and offering self encourage communication. Giving approval or disapproval and \"why\" questions can block communication or put clients on the defensive."},{"k":"q","t":"A client has trouble coping after a job loss. Which action best supports healthy coping?","a":"Answer: Help the client identify supports and problem-solving steps","r":"Supporting problem-solving, identifying strengths and supports, and exploring feelings promote adaptive","s":"Varcarolis' Foundations of Psychiatric-Mental Health Nursing, 10th ed.","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-020","x":"Supporting problem-solving, identifying strengths and supports, and exploring feelings promote adaptive coping."},{"k":"q","t":"Which finding in a young child may indicate sexual abuse?","a":"Answer: Age-inappropriate sexual knowledge or behavior","r":"Sexual knowledge or behavior beyond the child's developmental level, genital injuries, and sudden behavior changes are concerning signs that warrant further evaluation and","s":"AAP. Clinical Report: The Evaluation of Children in the Primary Care Setting When Sexual Abuse Is Suspected","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-009","x":"Sexual knowledge or behavior beyond the child's developmental level, genital injuries, and sudden behavior changes are concerning signs that warrant further evaluation and reporting."},{"k":"q","t":"How do most school-age children (about 9 to 10 years) understand death?","a":"Answer: Death is permanent and happens to everyone","r":"By about age 9 or 10, most children understand that death is final, universal, and has","s":"Hockenberry. Wong's Nursing Care of Infants and Children, 12th ed.","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-012","x":"By about age 9 or 10, most children understand that death is final, universal, and has causes."},{"k":"q","t":"A client recovering from a myocardial infarction asks when it's safe to resume sexual activity. Which response reflects current guidance?","a":"Answer: It's generally reasonable once you can do mild to moderate activity, like climbing two flights of stairs, without symptoms","r":"For uncomplicated MI, sexual activity is often reasonable about a week or more later if the client can do mild to moderate activity (3 to 5 METs) without symptoms. The nurse addresses sexuality openly as part of","s":"AHA. Scientific Statement: Sexual Activity and Cardiovascular Disease (2012)","c":"Psychosocial Integrity","u":"/nclex-practice-questions/psychosocial-integrity#psy4-013","x":"For uncomplicated MI, sexual activity is often reasonable about a week or more later if the client can do mild to moderate activity (3 to 5 METs) without symptoms. The nurse addresses sexuality openly as part of care."},{"k":"q","t":"A client with COPD is short of breath at rest. Which position is most helpful?","a":"Answer: Sitting up and leaning forward with arms resting on the overbed table","r":"The orthopneic (tripod) position lets the diaphragm move more freely and uses accessory muscles more","s":"Lewis's Medical-Surgical Nursing, 13th ed. (COPD)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-006","x":"The orthopneic (tripod) position lets the diaphragm move more freely and uses accessory muscles more effectively."},{"k":"q","t":"Which device helps keep a client's hip from rotating outward while lying in bed?","a":"Answer: A trochanter roll placed along the outer thigh","r":"A trochanter roll along the lateral thigh from hip to knee prevents external rotation of the","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (positioning)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-007","x":"A trochanter roll along the lateral thigh from hip to knee prevents external rotation of the hip."},{"k":"q","t":"How should a client care for a hearing aid?","a":"Answer: Keep it dry and remove it before showering","r":"Moisture damages hearing aids. They are removed before bathing or swimming, wiped with a dry cloth, and stored in a dry place, with the battery door open at","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (hygiene)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-004","x":"Moisture damages hearing aids. They are removed before bathing or swimming, wiped with a dry cloth, and stored in a dry place, with the battery door open at night."},{"k":"q","t":"A client is having trouble urinating after surgery. Which nursing measures may help? Select all that apply.","a":"Answer: Help the client to a normal voiding position; Pour warm water over the perineum; Run water in the sink","r":"Sounds of running water, a natural position, privacy, and warm water over the perineum promote relaxation of the urinary sphincter. Restricting fluids and cold do not","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (urinary elimination)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc2-020","x":"Sounds of running water, a natural position, privacy, and warm water over the perineum promote relaxation of the urinary sphincter. Restricting fluids and cold do not help."},{"k":"q","t":"How should the nurse store a client's dentures overnight?","a":"Answer: In a labeled denture cup with water or cleansing solution","r":"Dentures are stored moist in a labeled cup to prevent warping and loss. Hot water can warp them, and paper towels on trays are often thrown","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (oral hygiene)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-005","x":"Dentures are stored moist in a labeled cup to prevent warping and loss. Hot water can warp them, and paper towels on trays are often thrown away."},{"k":"q","t":"Which finding shows skin traction is set up correctly?","a":"Answer: The weights hang freely off the floor","r":"Weights must hang freely, with ropes moving freely through pulleys, to apply consistent traction. Weights aren't removed or lifted without an","s":"Lewis's Medical-Surgical Nursing, 13th ed. (traction)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-019","x":"Weights must hang freely, with ropes moving freely through pulleys, to apply consistent traction. Weights aren't removed or lifted without an order."},{"k":"q","t":"During a shift, a client voids 450 mL and 300 mL, and 125 mL drains from the nasogastric tube. What is the total output in mL?","a":"Answer: 875 mL","r":"450 + 300 + 125 = 875 mL. Output includes urine, emesis, drainage from tubes, and","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (intake and output)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-015","x":"450 + 300 + 125 = 875 mL. Output includes urine, emesis, drainage from tubes, and diarrhea."},{"k":"q","t":"A client had a partial gastrectomy and has cramping, dizziness, and diarrhea soon after eating. What should the nurse teach?","a":"Answer: Eat small meals, avoid drinking fluids with meals, and lie down briefly after eating","r":"Dumping syndrome happens when food moves rapidly into the small intestine. Small, frequent, high-protein meals, low simple sugars, fluids between meals, and lying down after eating","s":"Lewis's Medical-Surgical Nursing, 13th ed. (dumping syndrome)","c":"Basic Care and Comfort","u":"/nclex-practice-questions/basic-care-and-comfort#bcc3-002","x":"Dumping syndrome happens when food moves rapidly into the small intestine. Small, frequent, high-protein meals, low simple sugars, fluids between meals, and lying down after eating help."},{"k":"q","t":"A client who started haloperidol yesterday has a sudden painful spasm that twists the neck to one side. Which medication should the nurse expect to give?","a":"Answer: Benztropine","r":"Acute dystonia is treated with an anticholinergic such as benztropine or with diphenhydramine, given IM or IV for rapid relief. Dantrolene is used for","s":"Lehne's Pharmacology for Nursing Care, 12th ed. (antipsychotic EPS)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha2-040","x":"Acute dystonia is treated with an anticholinergic such as benztropine or with diphenhydramine, given IM or IV for rapid relief. Dantrolene is used for NMS."},{"k":"q","t":"A client is receiving IV acyclovir. Which nursing action helps prevent kidney injury?","a":"Answer: Make sure the client is well hydrated","r":"Acyclovir can crystallize in the renal tubules. Adequate hydration and infusing over at least 1 hour reduce the","s":"FDA label: Acyclovir sodium injection, DailyMed","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha3-029","x":"Acyclovir can crystallize in the renal tubules. Adequate hydration and infusing over at least 1 hour reduce the risk."},{"k":"q","t":"A child is starting methylphenidate for ADHD. What should the nurse teach the parents?","a":"Answer: Give the medication in the morning and monitor the child's appetite and growth","r":"Stimulants are given early in the day to avoid insomnia. They can decrease appetite and slow growth, so weight and height are","s":"FDA label: Ritalin (methylphenidate), DailyMed","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha2-041","x":"Stimulants are given early in the day to avoid insomnia. They can decrease appetite and slow growth, so weight and height are monitored."},{"k":"q","t":"Which instructions should the nurse include for a client starting warfarin? Select all that apply.","a":"Answer: Use a soft-bristled toothbrush; Keep your intake of vitamin K-rich foods consistent; Report black, tarry stools","r":"Consistent vitamin K intake keeps INR stable, black stools may signal GI bleeding, and soft toothbrushes reduce gum bleeding. Aspirin increases bleeding risk, and missed doses are never","s":"FDA label: Coumadin (warfarin), DailyMed (patient counseling)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha-032","x":"Consistent vitamin K intake keeps INR stable, black stools may signal GI bleeding, and soft toothbrushes reduce gum bleeding. Aspirin increases bleeding risk, and missed doses are never doubled."},{"k":"q","t":"Which instruction should the nurse give a client taking lithium?","a":"Answer: Keep your fluid and salt intake consistent from day to day","r":"Lithium is excreted like sodium. Low sodium or dehydration (sweating, vomiting, diarrhea) increases lithium levels and toxicity risk. Consistent salt and fluid intake (usually 2 to 3 L/day) keeps levels","s":"FDA label: Lithium carbonate, DailyMed; Varcarolis, 9th ed.","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha2-039","x":"Lithium is excreted like sodium. Low sodium or dehydration (sweating, vomiting, diarrhea) increases lithium levels and toxicity risk. Consistent salt and fluid intake (usually 2 to 3 L/day) keeps levels stable."},{"k":"q","t":"A client is starting linezolid. What should the nurse teach?","a":"Answer: Avoid large amounts of high-tyramine foods like aged cheese and cured meats","r":"Linezolid is a weak MAO inhibitor. Large amounts of tyramine can raise blood pressure, and combining it with serotonergic drugs can cause serotonin","s":"FDA label: Zyvox (linezolid), DailyMed","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha3-028","x":"Linezolid is a weak MAO inhibitor. Large amounts of tyramine can raise blood pressure, and combining it with serotonergic drugs can cause serotonin syndrome."},{"k":"q","t":"Heparin 5,000 units subcutaneously is prescribed. The vial contains 10,000 units/mL. How many mL should the nurse give?","a":"Answer: 0.5 mL","r":"5,000 units ÷ 10,000 units/mL = 0.5","s":"Pickar. Dosage Calculations; ISMP High-Alert Medications","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha3-038","x":"5,000 units ÷ 10,000 units/mL = 0.5 mL."},{"k":"q","t":"A client has a tonic-clonic seizure lasting more than 5 minutes. Which medication should the nurse expect to give first?","a":"Answer: IV lorazepam","r":"Status epilepticus is a seizure lasting 5 minutes or longer. A benzodiazepine (IV lorazepam, IM midazolam, or IV diazepam) is first-line, followed by a second-line agent such as fosphenytoin or","s":"American Epilepsy Society. Guideline: Treatment of Convulsive Status Epilepticus (2016)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-practice-questions/pharmacology#pha2-042","x":"Status epilepticus is a seizure lasting 5 minutes or longer. A benzodiazepine (IV lorazepam, IM midazolam, or IV diazepam) is first-line, followed by a second-line agent such as fosphenytoin or levetiracetam."},{"k":"q","t":"Which hemoglobin A1C goal is reasonable for many nonpregnant adults with diabetes?","a":"Answer: Below 7%","r":"An A1C below 7% is a common goal for many nonpregnant adults. Goals are individualized, and less strict targets may be appropriate for older adults or those at risk for","s":"ADA. Standards of Care in Diabetes, Section 6 (glycemic goals)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-018","x":"An A1C below 7% is a common goal for many nonpregnant adults. Goals are individualized, and less strict targets may be appropriate for older adults or those at risk for hypoglycemia."},{"k":"q","t":"A client is having synchronized cardioversion for atrial fibrillation. What must the nurse confirm before the shock?","a":"Answer: The synchronize mode is turned on","r":"Synchronization times the shock with the R wave to avoid the vulnerable period that could cause ventricular fibrillation. Clients are sedated and no one touches the","s":"AHA. Guidelines for CPR and ECC (electrical therapy)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-019","x":"Synchronization times the shock with the R wave to avoid the vulnerable period that could cause ventricular fibrillation. Clients are sedated and no one touches the bed."},{"k":"q","t":"After an upper GI endoscopy, which finding should the nurse report right away?","a":"Answer: Sharp chest or abdominal pain with fever","r":"Severe pain, fever, or difficulty swallowing after endoscopy may signal perforation. A mild sore throat and bloating are","s":"Lewis's Medical-Surgical Nursing, 13th ed. (endoscopy)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-009","x":"Severe pain, fever, or difficulty swallowing after endoscopy may signal perforation. A mild sore throat and bloating are expected."},{"k":"q","t":"Which findings should the nurse include in a neurovascular check of a casted leg? Select all that apply.","a":"Answer: Capillary refill; Ability to move the toes; Sensation in the toes; Color and temperature of the toes","r":"Neurovascular checks include color, temperature, capillary refill, pulses, sensation, movement, and pain, to detect compartment syndrome or impaired circulation","s":"Lewis's Medical-Surgical Nursing, 13th ed. (fracture care)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-013","x":"Neurovascular checks include color, temperature, capillary refill, pulses, sensation, movement, and pain, to detect compartment syndrome or impaired circulation early."},{"k":"q","t":"During neuro checks on a client with a head injury, the nurse finds a newly fixed and dilated right pupil. What does this suggest?","a":"Answer: Increasing intracranial pressure with possible brain herniation","r":"A new unilateral fixed, dilated pupil suggests compression of cranial nerve III from herniation. This is an emergency requiring immediate","s":"Lewis's Medical-Surgical Nursing, 13th ed. (head injury)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-012","x":"A new unilateral fixed, dilated pupil suggests compression of cranial nerve III from herniation. This is an emergency requiring immediate notification."},{"k":"q","t":"Where should the nurse listen to obtain an apical pulse in an adult?","a":"Answer: Fifth intercostal space at the left midclavicular line","r":"The apical pulse is heard at the point of maximal impulse, at the left 5th intercostal space, midclavicular","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (vital signs)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-011","x":"The apical pulse is heard at the point of maximal impulse, at the left 5th intercostal space, midclavicular line."},{"k":"q","t":"A client's blood pressure is 120/60 mm Hg. What is the mean arterial pressure (MAP)?","a":"Answer: 80 mm Hg","r":"MAP ≈ (SBP + 2 × DBP) ÷ 3 = (120 + 120) ÷ 3 = 80 mm Hg. A MAP of at least 65 mm Hg is generally needed to perfuse","s":"Lewis's Medical-Surgical Nursing, 13th ed. (hemodynamic monitoring)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp3-010","x":"MAP ≈ (SBP + 2 × DBP) ÷ 3 = (120 + 120) ÷ 3 = 80 mm Hg. A MAP of at least 65 mm Hg is generally needed to perfuse organs."},{"k":"q","t":"How should a client collect a sputum specimen for culture?","a":"Answer: Early in the morning, after rinsing the mouth with water, by coughing deeply","r":"Early morning specimens contain more secretions. Rinsing with water (not mouthwash) reduces contamination, and deep coughing produces sputum rather than","s":"Pagana. Mosby's Manual of Diagnostic and Laboratory Tests (sputum culture)","c":"Reduction of Risk Potential","u":"/nclex-practice-questions/reduction-of-risk-potential#rrp4-005","x":"Early morning specimens contain more secretions. Rinsing with water (not mouthwash) reduces contamination, and deep coughing produces sputum rather than saliva."},{"k":"q","t":"A client's chest tube water-seal chamber has stopped tidaling. The client is breathing comfortably with equal breath sounds bilaterally, and the tubing is free of kinks and clots. How should the nurse interpret this?","a":"Answer: The lung has likely re-expanded","r":"Tidaling stops when the lung re-expands or when the tubing is kinked or occluded. With a re-expanded lung on x-ray, this is expected. Otherwise, the nurse checks for kinks or","s":"Lewis's Medical-Surgical Nursing, 13th ed. (chest drainage)","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy3-009","x":"Tidaling stops when the lung re-expands or when the tubing is kinked or occluded. With a re-expanded lung on x-ray, this is expected. Otherwise, the nurse checks for kinks or clots."},{"k":"q","t":"After a crush injury to the chest, part of the client's chest wall moves inward during inspiration. What does the nurse suspect?","a":"Answer: Flail chest","r":"Flail chest occurs when multiple adjacent ribs break in more than one place, causing paradoxical chest wall movement and impaired","s":"ACS. ATLS Student Course Manual, 11th ed.","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy3-008","x":"Flail chest occurs when multiple adjacent ribs break in more than one place, causing paradoxical chest wall movement and impaired ventilation."},{"k":"q","t":"A client has stable supraventricular tachycardia at 190/min and normal blood pressure. What should the nurse expect to try first?","a":"Answer: Vagal maneuvers","r":"For stable, regular narrow-complex tachycardia, vagal maneuvers (such as a modified Valsalva) are tried first, then adenosine. Cardioversion is for unstable","s":"AHA. Guidelines for CPR and ECC (adult tachycardia algorithm)","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy3-001","x":"For stable, regular narrow-complex tachycardia, vagal maneuvers (such as a modified Valsalva) are tried first, then adenosine. Cardioversion is for unstable clients."},{"k":"q","t":"A client with suspected sepsis has a BP of 82/48 mm Hg and lactate of 4.2 mmol/L. Which actions should the nurse anticipate in the first hour? Select all that apply.","a":"Answer: Give broad-spectrum antibiotics; Draw blood cultures before antibiotics; Infuse 30 mL/kg of IV crystalloid","r":"Sepsis hour-1 bundle: measure lactate, draw blood cultures before antibiotics, start broad-spectrum antibiotics, give 30 mL/kg crystalloid for hypotension or lactate at least 4 mmol/L, and start vasopressors if hypotension","s":"Surviving Sepsis Campaign. Hour-1 Bundle; 2021 Guidelines","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy-019","x":"Sepsis hour-1 bundle: measure lactate, draw blood cultures before antibiotics, start broad-spectrum antibiotics, give 30 mL/kg crystalloid for hypotension or lactate at least 4 mmol/L, and start vasopressors if hypotension persists."},{"k":"q","t":"The monitor shows ventricular fibrillation and the client is unresponsive with no pulse. What should the nurse do first?","a":"Answer: Start CPR and defibrillate as soon as the defibrillator is ready","r":"VF is a shockable rhythm. High-quality CPR and early defibrillation are the most important interventions. Drugs","s":"AHA. Guidelines for CPR and ECC (adult cardiac arrest)","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy3-002","x":"VF is a shockable rhythm. High-quality CPR and early defibrillation are the most important interventions. Drugs follow."},{"k":"q","t":"Which finding is consistent with acute pericarditis?","a":"Answer: Sharp chest pain that improves when the client sits up and leans forward","r":"Pericarditis typically causes sharp, pleuritic chest pain that improves when sitting forward and worsens lying down, often with a pericardial friction","s":"ESC. 2025 Guidelines for the Management of Myocarditis and Pericarditis","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy3-005","x":"Pericarditis typically causes sharp, pleuritic chest pain that improves when sitting forward and worsens lying down, often with a pericardial friction rub."},{"k":"q","t":"A client opens the eyes only to pain, makes inappropriate words, and withdraws from a painful stimulus. What is the Glasgow Coma Scale score?","a":"Answer: 9 points","r":"Eye opening to pain = 2; inappropriate words = 3; withdraws from pain = 4. Total = 9. A GCS of 8 or below usually indicates the need for airway","s":"Teasdale & Jennett. Glasgow Coma Scale; Lewis's Med-Surg","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy3-021","x":"Eye opening to pain = 2; inappropriate words = 3; withdraws from pain = 4. Total = 9. A GCS of 8 or below usually indicates the need for airway protection."},{"k":"q","t":"A client's serum sodium is 118 mEq/L and the client is confused. Which precaution should the nurse put in place?","a":"Answer: Seizure precautions","r":"Severe hyponatremia causes cerebral edema, which can lead to confusion, seizures, and coma. Correction is done slowly to avoid osmotic","s":"Lewis's Medical-Surgical Nursing, 13th ed. (hyponatremia)","c":"Physiological Adaptation","u":"/nclex-practice-questions/physiological-adaptation#phy2-031","x":"Severe hyponatremia causes cerebral edema, which can lead to confusion, seizures, and coma. Correction is done slowly to avoid osmotic demyelination."},{"k":"q","t":"1,000 mL of lactated Ringer's is to infuse over 10 hours by gravity. The drop factor is 20 gtt/mL. How many drops per minute should the nurse regulate?","a":"Answer: 33 gtt/min","r":"(1,000 mL × 20 gtt/mL) ÷ 600 min = 20,000 ÷ 600 = 33.3, rounded to 33","s":"Potter & Perry. Fundamentals of Nursing, 12th ed. (gravity drip rate)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha3-039","x":"(1,000 mL × 20 gtt/mL) ÷ 600 min = 20,000 ÷ 600 = 33.3, rounded to 33 gtt/min."},{"k":"q","t":"Acetaminophen 15 mg/kg PO is prescribed for a child who weighs 18 kg. The liquid is labeled 160 mg/5 mL. How many mL should the nurse give?","a":"Answer: 8.4 mL","r":"Dose: 15 mg × 18 kg = 270 mg. Volume: (270 ÷ 160) × 5 mL = 8.4375, rounded to 8.4","s":"Pickar. Dosage Calculations; AAP acetaminophen dosing","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha2-035","x":"Dose: 15 mg × 18 kg = 270 mg. Volume: (270 ÷ 160) × 5 mL = 8.4375, rounded to 8.4 mL."},{"k":"q","t":"Levothyroxine 0.1 mg PO daily is prescribed. The tablets available are 50 mcg each. How many tablets should the nurse give?","a":"Answer: 2 tablets","r":"0.1 mg = 100 mcg. 100 mcg ÷ 50 mcg = 2","s":"Pickar. Dosage Calculations (metric conversions)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha2-034","x":"0.1 mg = 100 mcg. 100 mcg ÷ 50 mcg = 2 tablets."},{"k":"q","t":"A heparin bolus of 80 units/kg IV is prescribed for a client who weighs 75 kg. The vial contains 5,000 units/mL. How many mL should the nurse give?","a":"Answer: 1.2 mL","r":"Dose: 80 units × 75 kg = 6,000 units. Volume: 6,000 ÷ 5,000 = 1.2 mL. Heparin is high-alert; get an independent double","s":"Pickar. Dosage Calculations; ISMP High-Alert Medications","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha2-036","x":"Dose: 80 units × 75 kg = 6,000 units. Volume: 6,000 ÷ 5,000 = 1.2 mL. Heparin is high-alert; get an independent double check."},{"k":"q","t":"An IV antibiotic in 100 mL of 0.9% sodium chloride is to infuse over 30 minutes. At what rate should the nurse set the pump?","a":"Answer: 200 mL/hr","r":"100 mL ÷ 0.5 hr = 200","s":"Pickar. Dosage Calculations (IV piggyback rates)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha2-031","x":"100 mL ÷ 0.5 hr = 200 mL/hr."},{"k":"q","t":"Amoxicillin 40 mg/kg/day is prescribed, divided every 8 hours, for a child who weighs 15 kg. How many mg should the nurse give per dose?","a":"Answer: 200 mg","r":"Daily dose: 40 mg × 15 kg = 600 mg/day. Divided every 8 hours (3 doses): 600 ÷ 3 = 200 mg per","s":"Pickar. Dosage Calculations (pediatric divided doses)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha3-036","x":"Daily dose: 40 mg × 15 kg = 600 mg/day. Divided every 8 hours (3 doses): 600 ÷ 3 = 200 mg per dose."},{"k":"q","t":"A diltiazem infusion contains 125 mg in 125 mL. The prescribed dose is 10 mg/hr. At what rate should the nurse set the pump?","a":"Answer: 10 mL/hr","r":"Concentration: 125 mg ÷ 125 mL = 1 mg/mL. Rate: 10 mg/hr ÷ 1 mg/mL = 10","s":"Pickar. Dosage Calculations; FDA label: Diltiazem injection","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha3-037","x":"Concentration: 125 mg ÷ 125 mL = 1 mg/mL. Rate: 10 mg/hr ÷ 1 mg/mL = 10 mL/hr."},{"k":"q","t":"An insulin infusion contains 100 units of regular insulin in 100 mL of 0.9% sodium chloride. The prescribed rate is 6 units/hr. At what rate should the nurse set the pump?","a":"Answer: 6 mL/hr","r":"Concentration: 100 units ÷ 100 mL = 1 unit/mL. Rate: 6 units/hr ÷ 1 unit/mL = 6","s":"Pickar. Dosage Calculations; ISMP High-Alert Medications","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha2-033","x":"Concentration: 100 units ÷ 100 mL = 1 unit/mL. Rate: 6 units/hr ÷ 1 unit/mL = 6 mL/hr."},{"k":"q","t":"A nitroglycerin infusion contains 50 mg in 250 mL of D5W. The prescribed dose is 10 mcg/min. At what rate in mL/hr should the nurse set the pump?","a":"Answer: 3 mL/hr","r":"Concentration: 50 mg ÷ 250 mL = 0.2 mg/mL = 200 mcg/mL. Dose: 10 mcg/min × 60 = 600 mcg/hr. Rate: 600 ÷ 200 = 3","s":"Pickar. Dosage Calculations (mcg/min titrations)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha3-040","x":"Concentration: 50 mg ÷ 250 mL = 0.2 mg/mL = 200 mcg/mL. Dose: 10 mcg/min × 60 = 600 mcg/hr. Rate: 600 ÷ 200 = 3 mL/hr."},{"k":"q","t":"Dobutamine 250 mg in 250 mL D5W is prescribed at 5 mcg/kg/min for a client who weighs 80 kg. At what rate in mL/hr should the nurse set the pump?","a":"Answer: 24 mL/hr","r":"Concentration: 250 mg ÷ 250 mL = 1 mg/mL = 1,000 mcg/mL. Dose: 5 × 80 = 400 mcg/min × 60 = 24,000 mcg/hr. Rate: 24,000 ÷ 1,000 = 24","s":"Pickar. Dosage Calculations (weight-based titrations)","c":"Pharmacological and Parenteral Therapies","u":"/nclex-dosage-calculation-practice#pha4-033","x":"Concentration: 250 mg ÷ 250 mL = 1 mg/mL = 1,000 mcg/mL. Dose: 5 × 80 = 400 mcg/min × 60 = 24,000 mcg/hr. Rate: 24,000 ÷ 1,000 = 24 mL/hr."},{"k":"q","t":"Which client should the nurse on a medical-surgical unit assess first?","a":"Answer: A client with pneumonia whose SpO2 dropped from 95% to 88% in the past hour","r":"A falling oxygen saturation in a client with pneumonia signals worsening gas exchange and needs immediate assessment. The others are","s":"Lewis's Medical-Surgical Nursing, 13th ed. (prioritization)","c":"Management of Care","u":"/nclex-prioritization-questions#moc4-001","x":"A falling oxygen saturation in a client with pneumonia signals worsening gas exchange and needs immediate assessment. The others are stable."},{"k":"q","t":"Which client should the nurse assess first?","a":"Answer: A client with a femur fracture who has a cool, pale foot with a weak pedal pulse","r":"A cool, pale extremity with a weak pulse below a fracture suggests vascular compromise or compartment syndrome, which threatens the limb. The others are","s":"Lewis's Medical-Surgical Nursing, 13th ed. (fracture complications)","c":"Management of Care","u":"/nclex-prioritization-questions#moc4-002","x":"A cool, pale extremity with a weak pulse below a fracture suggests vascular compromise or compartment syndrome, which threatens the limb. The others are stable."},{"k":"q","t":"A chemical splashes into a staff member's eye. What is the priority action?","a":"Answer: Flush the eye with running water or saline for at least 15 minutes","r":"Immediate, prolonged irrigation limits tissue damage. The safety data sheet guides follow-up care but should not delay","s":"OSHA 29 CFR 1910.151(c); ANSI Z358.1 Emergency Eyewash","c":"Safety and Infection Prevention and Control","u":"/nclex-prioritization-questions#sic-017","x":"Immediate, prolonged irrigation limits tissue damage. The safety data sheet guides follow-up care but should not delay flushing."},{"k":"q","t":"Which client should the nurse on a postpartum unit see first?","a":"Answer: A client who has soaked a peri pad in 15 minutes","r":"Saturating a pad in 15 minutes indicates hemorrhage. Afterpains during breastfeeding and a firm fundus at the umbilicus are","s":"ACOG. Practice Bulletin 183: Postpartum Hemorrhage","c":"Management of Care","u":"/nclex-prioritization-questions#moc4-003","x":"Saturating a pad in 15 minutes indicates hemorrhage. Afterpains during breastfeeding and a firm fundus at the umbilicus are expected."},{"k":"q","t":"Fifteen minutes after a vaginal birth, the nurse finds a soft, boggy fundus and heavy bleeding. What should the nurse do first?","a":"Answer: Massage the fundus until it is firm","r":"Uterine atony is the most common cause of postpartum hemorrhage. Fundal massage stimulates contraction and is the first step, followed by uterotonic drugs and calling for","s":"ACOG. Practice Bulletin 183: Postpartum Hemorrhage","c":"Physiological Adaptation","u":"/nclex-prioritization-questions#phy2-030","x":"Uterine atony is the most common cause of postpartum hemorrhage. Fundal massage stimulates contraction and is the first step, followed by uterotonic drugs and calling for help."},{"k":"q","t":"The negative pressure wound therapy device alarms for an air leak. What should the nurse do first?","a":"Answer: Check the dressing seal and tubing connections for leaks","r":"Most alarms come from breaks in the seal or tubing. Restoring the seal quickly maintains therapy. If therapy is interrupted for an extended time (often about 2 hours), the dressing is replaced per","s":"Manufacturer guidance; WOCN Society NPWT recommendations","c":"Reduction of Risk Potential","u":"/nclex-prioritization-questions#rrp4-004","x":"Most alarms come from breaks in the seal or tubing. Restoring the seal quickly maintains therapy. If therapy is interrupted for an extended time (often about 2 hours), the dressing is replaced per policy."},{"k":"q","t":"Four hours after surgery, a client's urine output has been 20 mL/hr for 2 hours. The client has no catheter and reports lower abdominal discomfort. What should the nurse do first?","a":"Answer: Assess the bladder with a bladder scanner","r":"Lower abdominal discomfort with low output after surgery suggests urinary retention. A bladder scan is a quick, noninvasive assessment that guides next steps such as straight catheterization per","s":"Lewis's Medical-Surgical Nursing, 13th ed. (urinary retention)","c":"Reduction of Risk Potential","u":"/nclex-prioritization-questions#rrp-030","x":"Lower abdominal discomfort with low output after surgery suggests urinary retention. A bladder scan is a quick, noninvasive assessment that guides next steps such as straight catheterization per protocol."},{"k":"q","t":"During a central line dressing change, the client suddenly becomes short of breath with chest pain. The nurse suspects an air embolism. What should the nurse do first?","a":"Answer: Clamp the catheter and place the client on the left side with the head lower than the feet","r":"Clamp the line to stop air entry and position the client left side down with the head lowered (if tolerated) to trap air in the right atrium. Give oxygen and notify the","s":"INS. Infusion Therapy Standards of Practice, 9th ed. (air embolism)","c":"Reduction of Risk Potential","u":"/nclex-prioritization-questions#rrp2-017","x":"Clamp the line to stop air entry and position the client left side down with the head lowered (if tolerated) to trap air in the right atrium. Give oxygen and notify the provider."},{"k":"q","t":"Which client should the charge nurse assign to the most experienced RN?","a":"Answer: A client with diabetic ketoacidosis on an insulin infusion with hourly glucose checks","r":"The most complex, unstable client with high-alert medications and frequent titration needs the most experienced nurse. The other clients are stable with predictable","s":"ADA. Standards of Care in Diabetes (DKA management)","c":"Management of Care","u":"/nclex-prioritization-questions#moc-033","x":"The most complex, unstable client with high-alert medications and frequent titration needs the most experienced nurse. The other clients are stable with predictable needs."},{"k":"q","t":"The charge nurse is making assignments. Which client is most appropriate to assign to an LPN?","a":"Answer: A client with a stable spinal cord injury who needs scheduled intermittent catheterization","r":"LPNs care for stable clients with predictable outcomes and can perform sterile procedures such as intermittent catheterization. A new admission with chest pain needs RN assessment, initial discharge teaching on a high-alert drug is an RN responsibility, and a fresh tracheostomy is an unstable, high-risk","s":"NCSBN. National Guidelines for Nursing Delegation (2019); state LPN scope","c":"Management of Care","u":"/nclex-prioritization-questions#moc-003","x":"LPNs care for stable clients with predictable outcomes and can perform sterile procedures such as intermittent catheterization. A new admission with chest pain needs RN assessment, initial discharge teaching on a high-alert drug is an RN responsibility, and a fresh tracheostomy is an unstable, high-risk airway."},{"k":"q","t":"Which action by an LPN requires the RN to intervene?","a":"Answer: Completing the initial admission assessment of a newly admitted client","r":"Initial comprehensive assessment is an RN responsibility. LPNs collect data and reinforce teaching within their","s":"NCSBN. Model Nursing Practice Act and Rules; state nurse practice acts","c":"Management of Care","u":"/nclex-prioritization-questions#moc2-021","x":"Initial comprehensive assessment is an RN responsibility. LPNs collect data and reinforce teaching within their scope."},{"k":"q","t":"A client with sepsis is oozing from IV sites and has a falling platelet count, low fibrinogen, and an elevated D-dimer. What does the nurse suspect?","a":"Answer: Disseminated intravascular coagulation","r":"DIC involves widespread clotting that consumes platelets and clotting factors, leading to bleeding. Low platelets and fibrinogen with high D-dimer and prolonged clotting times are typical. Treatment targets the","s":"ISTH. Guidance for Diagnosis and Treatment of DIC (2013)","c":"Physiological Adaptation","u":"/nclex-lab-values#phy3-006","x":"DIC involves widespread clotting that consumes platelets and clotting factors, leading to bleeding. Low platelets and fibrinogen with high D-dimer and prolonged clotting times are typical. Treatment targets the cause."},{"k":"q","t":"An older adult with dementia who can't get to water easily has a serum sodium of 154 mEq/L. Which findings does the nurse expect?","a":"Answer: Thirst, dry mucous membranes, and confusion","r":"Hypernatremia usually results from water loss or inadequate intake and causes thirst, dry mucous membranes, restlessness, and confusion. Correction is","s":"Lewis's Medical-Surgical Nursing, 13th ed. (hypernatremia)","c":"Physiological Adaptation","u":"/nclex-lab-values#phy4-011","x":"Hypernatremia usually results from water loss or inadequate intake and causes thirst, dry mucous membranes, restlessness, and confusion. Correction is gradual."},{"k":"q","t":"A client's potassium is 2.8 mEq/L. Which ECG change does the nurse expect?","a":"Answer: Prominent U waves and flattened T waves","r":"Hypokalemia causes flattened T waves, U waves, and ST depression, and increases the risk of dysrhythmias, especially with","s":"Lewis's Medical-Surgical Nursing, 13th ed. (hypokalemia)","c":"Physiological Adaptation","u":"/nclex-lab-values#phy4-010","x":"Hypokalemia causes flattened T waves, U waves, and ST depression, and increases the risk of dysrhythmias, especially with digoxin."},{"k":"q","t":"A nursing student about to take an exam feels alert, focused, and slightly restless. Which level of anxiety is this?","a":"Answer: Mild","r":"Mild anxiety sharpens the senses and can motivate learning. Moderate anxiety narrows focus. Severe anxiety and panic impair","s":"Varcarolis' Foundations of Psychiatric-Mental Health Nursing, 10th ed.","c":"Psychosocial Integrity","u":"/nclex-lab-values#psy4-004","x":"Mild anxiety sharpens the senses and can motivate learning. Moderate anxiety narrows focus. Severe anxiety and panic impair functioning."},{"k":"q","t":"A client is scheduled for an oral glucose tolerance test. What should the nurse teach?","a":"Answer: Fast for at least 8 hours before the test","r":"The OGTT is done after an overnight fast. During the test, clients stay seated and avoid eating, smoking, and","s":"ADA. Standards of Care in Diabetes, Section 2 (diagnosis)","c":"Reduction of Risk Potential","u":"/nclex-lab-values#rrp4-007","x":"The OGTT is done after an overnight fast. During the test, clients stay seated and avoid eating, smoking, and exercise."},{"k":"q","t":"A client newly diagnosed with type 2 diabetes keeps \"forgetting\" to check glucose and says, \"It's not that serious.\" What is the client most likely using?","a":"Answer: Denial","r":"Minimizing a serious diagnosis is a form of denial, often an early response to bad news. The nurse explores feelings and gives information at a pace the client can","s":"Varcarolis' Foundations of Psychiatric-Mental Health Nursing, 10th ed.","c":"Psychosocial Integrity","u":"/nclex-lab-values#psy4-014","x":"Minimizing a serious diagnosis is a form of denial, often an early response to bad news. The nurse explores feelings and gives information at a pace the client can handle."},{"k":"q","t":"Before drawing an arterial blood gas from the radial artery, what should the nurse check?","a":"Answer: Ulnar collateral circulation with an Allen test","r":"The Allen test (or a modified version) assesses ulnar artery flow to the hand in case the radial artery is damaged. Its value is debated, but it remains common","s":"Lewis's Medical-Surgical Nursing, 13th ed. (arterial blood gas sampling)","c":"Reduction of Risk Potential","u":"/nclex-lab-values#rrp2-016","x":"The Allen test (or a modified version) assesses ulnar artery flow to the hand in case the radial artery is damaged. Its value is debated, but it remains common practice."},{"k":"q","t":"A client on a continuous heparin infusion has an aPTT of 62 seconds. The control is 30 seconds, and the protocol target is 1.5 to 2.5 times control. How should the nurse interpret this?","a":"Answer: The aPTT is within the therapeutic range","r":"1.5 to 2.5 times a 30-second control is 45 to 75 seconds. 62 seconds is therapeutic. Many facilities now use anti-Xa levels instead, following their","s":"Lehne's Pharmacology for Nursing Care, 12th ed. (heparin monitoring)","c":"Reduction of Risk Potential","u":"/nclex-lab-values#rrp2-007","x":"1.5 to 2.5 times a 30-second control is 45 to 75 seconds. 62 seconds is therapeutic. Many facilities now use anti-Xa levels instead, following their protocol."},{"k":"lab","t":"Sodium (Na)","a":"135–145 mEq/L","r":"Low or high sodium changes neurologic status. Watch for confusion and seizures, and correct slowly.","u":"/nclex-lab-values","x":"Low or high sodium changes neurologic status. Watch for confusion and seizures, and correct slowly."},{"k":"lab","t":"Potassium (K)","a":"3.5–5.0 mEq/L","r":"Both low and high potassium cause dysrhythmias. Hyperkalemia: peaked T waves. Hypokalemia: U waves and higher risk of digoxin toxicity.","u":"/nclex-lab-values","x":"Both low and high potassium cause dysrhythmias. Hyperkalemia: peaked T waves. Hypokalemia: U waves and higher risk of digoxin toxicity."},{"k":"lab","t":"Chloride (Cl)","a":"98–106 mEq/L","r":"Usually moves with sodium and affects acid-base balance.","u":"/nclex-lab-values","x":"Usually moves with sodium and affects acid-base balance."},{"k":"lab","t":"Calcium, total (Ca)","a":"9.0–10.5 mg/dL","r":"Low calcium: tetany and positive Chvostek and Trousseau signs. High calcium: muscle weakness and kidney stones.","u":"/nclex-lab-values","x":"Low calcium: tetany and positive Chvostek and Trousseau signs. High calcium: muscle weakness and kidney stones."},{"k":"lab","t":"Magnesium (Mg)","a":"1.3–2.1 mEq/L","r":"High magnesium (for example during magnesium sulfate therapy) depresses deep tendon reflexes and respirations.","u":"/nclex-lab-values","x":"High magnesium (for example during magnesium sulfate therapy) depresses deep tendon reflexes and respirations."},{"k":"lab","t":"Phosphorus (P)","a":"3.0–4.5 mg/dL","r":"Moves opposite to calcium. Often high in chronic kidney disease.","u":"/nclex-lab-values","x":"Moves opposite to calcium. Often high in chronic kidney disease."},{"k":"lab","t":"Hemoglobin (Hgb)","a":"Male 14–18 g/dL; female 12–16 g/dL","r":"Low values mean anemia or bleeding. Check for tachycardia, pallor, and fatigue.","u":"/nclex-lab-values","x":"Low values mean anemia or bleeding. Check for tachycardia, pallor, and fatigue."},{"k":"lab","t":"Hematocrit (Hct)","a":"Male 42–52%; female 37–47%","r":"Rises with dehydration and falls with bleeding or fluid overload.","u":"/nclex-lab-values","x":"Rises with dehydration and falls with bleeding or fluid overload."},{"k":"lab","t":"White blood cells (WBC)","a":"5,000–10,000/mm³","r":"High suggests infection or inflammation. Low means infection risk: use neutropenic precautions.","u":"/nclex-lab-values","x":"High suggests infection or inflammation. Low means infection risk: use neutropenic precautions."},{"k":"lab","t":"Platelets","a":"150,000–400,000/mm³","r":"Below about 50,000/mm³, bleeding risk rises: avoid injections and use bleeding precautions.","u":"/nclex-lab-values","x":"Below about 50,000/mm³, bleeding risk rises: avoid injections and use bleeding precautions."},{"k":"lab","t":"Prothrombin time (PT)","a":"11–12.5 seconds","r":"Monitors warfarin therapy along with the INR.","u":"/nclex-lab-values","x":"Monitors warfarin therapy along with the INR."},{"k":"lab","t":"INR","a":"0.8–1.1 (no anticoagulant)","r":"Warfarin target is usually 2–3, and higher for some mechanical heart valves. Vitamin K reverses warfarin.","u":"/nclex-lab-values","x":"Warfarin target is usually 2–3, and higher for some mechanical heart valves. Vitamin K reverses warfarin."},{"k":"lab","t":"aPTT","a":"30–40 seconds","r":"Monitors IV unfractionated heparin; a common target is 1.5–2.5 times control. Protamine reverses heparin.","u":"/nclex-lab-values","x":"Monitors IV unfractionated heparin; a common target is 1.5–2.5 times control. Protamine reverses heparin."},{"k":"lab","t":"pH","a":"7.35–7.45","r":"Below 7.35 is acidosis; above 7.45 is alkalosis.","u":"/nclex-lab-values","x":"Below 7.35 is acidosis; above 7.45 is alkalosis."},{"k":"lab","t":"PaCO₂","a":"35–45 mm Hg","r":"The respiratory part. High PaCO₂ with low pH is respiratory acidosis.","u":"/nclex-lab-values","x":"The respiratory part. High PaCO₂ with low pH is respiratory acidosis."},{"k":"lab","t":"HCO₃⁻ (bicarbonate)","a":"22–26 mEq/L","r":"The metabolic part. Low HCO₃⁻ with low pH is metabolic acidosis.","u":"/nclex-lab-values","x":"The metabolic part. Low HCO₃⁻ with low pH is metabolic acidosis."},{"k":"lab","t":"PaO₂","a":"80–100 mm Hg","r":"Below 80 mm Hg is hypoxemia.","u":"/nclex-lab-values","x":"Below 80 mm Hg is hypoxemia."},{"k":"lab","t":"SaO₂","a":"95–100%","r":"Interpret with the client's baseline; some clients with COPD have a lower target.","u":"/nclex-lab-values","x":"Interpret with the client's baseline; some clients with COPD have a lower target."},{"k":"lab","t":"BUN","a":"10–20 mg/dL","r":"Rises with dehydration, GI bleeding, and kidney injury.","u":"/nclex-lab-values","x":"Rises with dehydration, GI bleeding, and kidney injury."},{"k":"lab","t":"Creatinine","a":"0.5–1.2 mg/dL","r":"The better marker of kidney function. Check it before nephrotoxic drugs and contrast.","u":"/nclex-lab-values","x":"The better marker of kidney function. Check it before nephrotoxic drugs and contrast."},{"k":"lab","t":"Fasting blood glucose","a":"70–99 mg/dL","r":"Below 70 mg/dL is hypoglycemia: treat it right away. 126 mg/dL or higher on two tests suggests diabetes.","u":"/nclex-lab-values","x":"Below 70 mg/dL is hypoglycemia: treat it right away. 126 mg/dL or higher on two tests suggests diabetes."},{"k":"lab","t":"Hemoglobin A1C","a":"Below 5.7%","r":"5.7–6.4% is prediabetes and 6.5% or higher is diabetes. Shows average glucose over about 3 months.","u":"/nclex-lab-values","x":"5.7–6.4% is prediabetes and 6.5% or higher is diabetes. Shows average glucose over about 3 months."},{"k":"lab","t":"Digoxin","a":"0.5–2.0 ng/mL","r":"Many heart failure guidelines aim for the low end. Toxicity: nausea, vision changes, and bradycardia, made worse by low potassium.","u":"/nclex-lab-values","x":"Many heart failure guidelines aim for the low end. Toxicity: nausea, vision changes, and bradycardia, made worse by low potassium."},{"k":"lab","t":"Lithium","a":"0.6–1.2 mEq/L (maintenance)","r":"Narrow range. Dehydration and low sodium raise levels; above about 1.5 mEq/L signs of toxicity appear.","u":"/nclex-lab-values","x":"Narrow range. Dehydration and low sodium raise levels; above about 1.5 mEq/L signs of toxicity appear."},{"k":"lab","t":"Phenytoin","a":"10–20 mcg/mL","r":"Toxicity causes nystagmus, ataxia, and confusion.","u":"/nclex-lab-values","x":"Toxicity causes nystagmus, ataxia, and confusion."},{"k":"lab","t":"Albumin","a":"3.5–5.0 g/dL","r":"Low albumin points to poor nutrition or liver disease, and to edema.","u":"/nclex-lab-values","x":"Low albumin points to poor nutrition or liver disease, and to edema."},{"k":"lab","t":"BNP","a":"Below 100 pg/mL","r":"Higher values support a diagnosis of heart failure.","u":"/nclex-lab-values","x":"Higher values support a diagnosis of heart failure."},{"k":"lab","t":"Troponin","a":"Below the lab's 99th percentile cutoff","r":"A rise and fall above the cutoff means myocardial injury, such as a heart attack. Ranges depend on the assay.","u":"/nclex-lab-values","x":"A rise and fall above the cutoff means myocardial injury, such as a heart attack. Ranges depend on the assay."},{"k":"lab","t":"Total cholesterol","a":"Below 200 mg/dL","r":"Part of cardiovascular risk assessment along with LDL and HDL.","u":"/nclex-lab-values","x":"Part of cardiovascular risk assessment along with LDL and HDL."},{"k":"lab","t":"Urine specific gravity","a":"1.005–1.030","r":"High suggests dehydration; low suggests overhydration or diabetes insipidus.","u":"/nclex-lab-values","x":"High suggests dehydration; low suggests overhydration or diabetes insipidus."}]