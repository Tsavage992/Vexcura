<link rel="stylesheet" href="/s-211dn.css"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://nclexsim.com/"},{"@type":"ListItem","position":2,"name":"For nursing schools","item":"https://nclexsim.com/for-nursing-schools"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Vexcura for nursing programs","description":"NCLEX-RN prep and an academic EHR for nursing education, licensed to nursing schools and facilities. Students and instructors are free.","url":"https://nclexsim.com/for-nursing-schools","applicationCategory":"EducationalApplication","applicationSubCategory":"Nursing education","operatingSystem":"Any (web browser)","featureList":["NCLEX-RN practice questions and adaptive exams with rationales","Next Generation NCLEX item types and case studies","Academic EHR with My Chart, MAR and flowsheets","Clinical days with attendance and badge sign-in","Assign work and curriculum uploads","Program admin","Google and Microsoft single sign-on","LTI 1.3"],"audience":{"@type":"EducationalAudience","educationalRole":"teacher","audienceType":"Nursing schools, nursing faculty and clinical instructors"},"publisher":{"@id":"https://nclexsim.com/#org"},"offers":[{"@type":"Offer","name":"Vexcura Per student","description":"Any size; the program chooses the number of seats (per student seat), per year. Every plan includes every feature. Students and instructors are free.","price":"99","priceCurrency":"USD","category":"Institutional license"},{"@type":"Offer","name":"Vexcura Site 100","description":"Up to 100 students, per year. Every plan includes every feature. Students and instructors are free.","price":"7500","priceCurrency":"USD","category":"Institutional license"},{"@type":"Offer","name":"Vexcura Site 250","description":"101 to 250 students, per year. Every plan includes every feature. Students and instructors are free.","price":"15000","priceCurrency":"USD","category":"Institutional license"},{"@type":"Offer","name":"Vexcura Site 500","description":"251 to 500 students, per year. Every plan includes every feature. Students and instructors are free.","price":"25000","priceCurrency":"USD","category":"Institutional license"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How is Vexcura licensed?","acceptedAnswer":{"@type":"Answer","text":"The school or facility licenses Vexcura; students, instructors and program admins never pay. Choose per student ($99 per student seat, per year, with the number of seats your program picks) or a site license: Site 100 (up to 100 students, $7,500), Site 250 (101 to 250 students, $15,000), Site 500 (251 to 500 students, $25,000). Custom plans cover more than 500 students, several campuses, or major customizations. Every plan includes every feature."}},{"@type":"Question","name":"Do students or instructors pay anything?","acceptedAnswer":{"@type":"Answer","text":"No. Students, instructors and program admins are always free. The school or facility licenses Vexcura."}},{"@type":"Question","name":"Are some features only in higher plans?","acceptedAnswer":{"@type":"Answer","text":"No. Every plan includes everything: NCLEX practice, the academic EHR, the instructor workspace, badge sign-in, curriculum uploads, SSO and LTI. Plans differ only by how many students they cover."}},{"@type":"Question","name":"How do we pay?","acceptedAnswer":{"@type":"Answer","text":"By check only, payable to Vexcura, Attn: Tyler J. Savage, 27 General Cleburne St., Ringgold, GA 30736. Licenses are invoiced per year."}},{"@type":"Question","name":"Can we try it before we buy?","acceptedAnswer":{"@type":"Answer","text":"Yes. A free one-semester pilot covers one clinical group or cohort, with no obligation to buy. Programs that subscribe after a pilot can qualify for founding-program pricing on their first paid year."}},{"@type":"Question","name":"Who do we work with?","acceptedAnswer":{"@type":"Answer","text":"Tyler Savage, RN, Vexcura's founder, is the representative for every program and handles major customizations personally. Call 762-677-2802."}},{"@type":"Question","name":"Does Vexcura work with our LMS and sign-in?","acceptedAnswer":{"@type":"Answer","text":"Vexcura connects to Canvas, Blackboard, D2L Brightspace and Moodle using the LTI 1.3 standard. Instructors add Vexcura case assignments to a course, students open them from the course, and released grades can be sent to the gradebook. Students and faculty can also sign in with their school Google or Microsoft account."}},{"@type":"Question","name":"How does Vexcura handle student data?","acceptedAnswer":{"@type":"Answer","text":"Student records are handled under FERPA as a school official with a legitimate educational interest, under a signed data privacy agreement. The practice EHR is built so no real patient information is entered: no names, dates or record numbers. Program admins can download their program's data at any time."}},{"@type":"Question","name":"Is Vexcura accessible?","acceptedAnswer":{"@type":"Answer","text":"Vexcura is built to WCAG 2.1 AA. Automated testing with axe-core finds no violations on the main screens, and a draft accessibility conformance report in the VPAT format is available on request. An independent manual review has not been completed yet."}},{"@type":"Question","name":"Is Vexcura affiliated with NCSBN or Epic?","acceptedAnswer":{"@type":"Answer","text":"No. Vexcura is independent and isn't endorsed by NCSBN or any EHR vendor. NCLEX is a registered trademark of NCSBN. Epic is a trademark of Epic Systems Corporation; \"Epic-style\" only describes the familiar hospital charting layout of Vexcura's practice EHR."}}]}</script></head><body><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg 