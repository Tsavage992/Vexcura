   </div></details></nav></div></header><script>(function(){var d=document.querySelector(".mnav");if(!d)return;document.addEventListener("click",function(e){if(d.open&&!d.contains(e.target))d.open=false});document.addEventListener("keydown",function(e){if(e.key==="Escape"&&d.open){d.open=false;d.querySelector("summary").focus()}})})();</script><main><nav class="crumb w" aria-label="Breadcrumb"><a href="/">Home</a> › <span>The platform</span></nav><section class="hero w"><h1>One platform for the whole clinical-education stack</h1><p class="lead">Vexcura started as a practice exam and grew into the system a nursing program runs on — charting, simulation, teaching, and reporting — built by a registered nurse. Here is everything it reaches.</p><div class="cta"><a class="btn" href="/for-nursing-schools">Vexcura for nursing programs</a><a class="btn alt" href="/for-nursing-students">For students</a></div></section><div class="w"><style>.mm{margin:30px calc(50% - min(50vw - 16px,620px)) 36px}.mm-ai{margin:14px 2px 0;color:var(--muted)}.mm-ai b{color:var(--ink)}.mm-top{display:flex;flex-wrap:wrap;gap:10px 20px;justify-content:space-between;align-items:flex-end;margin:0 0 14px}.mm-top h2{margin:0 0 4px}.mm-top p{margin:0;color:var(--muted)}.mm-ctl{display:flex;gap:8px;align-items:center}.mm-cnt{font-size:14px;color:var(--muted);min-width:9ch;text-align:right}.mm:not(.js) .mm-ctl{display:none}.mm-b{font:600 14px var(--fb);border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:7px 14px;cursor:pointer}.mm-b:hover{border-color:var(--accent)}.mm-stage{position:relative;container-type:inline-size;aspect-ratio:1240/1060;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:radial-gradient(60% 55% at 50% 50%,color-mix(in srgb,var(--flame) 10%,var(--surface)) 0%,var(--surface) 70%),var(--surface)}.mm-stage::before{content:"";position:absolute;inset:0;background-image:radial-gradient(color-mix(in srgb,var(--line) 70%,transparent) 1px,transparent 1.2px);background-size:22px 22px;opacity:.55;pointer-events:none}.mm-svg{position:absolute;inset:0;width:100%;height:100%}.mm-svg path{fill:none;stroke:var(--c);stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0;transition:opacity .25s,stroke-width .25s}.mm-l0{stroke-width:4.5;opacity:.75}.mm-l1{stroke-width:2.6;opacity:.5}@media (prefers-reduced-motion:no-preference){.mm-svg path{animation:mm-draw 1s var(--d,0s) both cubic-bezier(.4,0,.2,1)}.mm-glow{animation:mm-pulse 5s ease-in-out infinite}.mm-leaf{animation:mm-in .5s var(--d) both}.mm-br{animation:mm-in .45s .2s both}}@keyframes mm-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}@keyframes mm-pulse{50%{opacity:.55}}@keyframes mm-in{from{opacity:0;scale:.92}}.mm-hub,.mm-br,.mm-leaf{position:absolute;left:calc(var(--x)*1%);top:calc(var(--y)*1%);translate:-50% -50%}.mm-hub{width:16.129cqw;aspect-ratio:1;border-radius:50%;display:grid;place-content:center;justify-items:center;text-align:center;background:var(--navy);color:var(--navy-ink);box-shadow:0 0 0 .5cqw color-mix(in srgb,var(--flame) 55%,transparent),0 1.6cqw 3.5cqw -1.4cqw rgba(10,30,40,.55);z-index:2}.mm-hub b{font:400 2.5cqw/1 var(--fh);color:#fff;letter-spacing:.01em}.mm-hub span{font:700 .95cqw var(--fb);letter-spacing:.32em;text-transform:uppercase;color:var(--flame)}.mm-hub .mm-hk{letter-spacing:.2em;opacity:.8;margin-bottom:.35cqw}.mm-hub small{font:600 .82cqw var(--fb);opacity:.7;margin-top:.5cqw;max-width:12cqw}.mm-grp{display:contents}.mm-br{width:16.935cqw;height:4.677cqw;display:flex;align-items:center;justify-content:center;gap:.7cqw;border-radius:999px;background:var(--c);color:#fff;text-decoration:none;font:700 1.25cqw var(--fb);box-shadow:0 .8cqw 1.8cqw -.9cqw color-mix(in srgb,var(--c) 70%,#000);z-index:2;transition:opacity .25s,transform .2s}.mm-br svg{width:1.5cqw;height:1.5cqw}.mm-br:hover,.mm-br:focus-visible{transform:scale(1.04)}.mm-br:focus-visible{outline:3px solid var(--flame);outline-offset:3px}.mm-leaf{width:16.129cqw;height:6.452cqw;perspective:60cqw;z-index:1;transition:opacity .25s}.mm-card{position:relative;width:100%;height:100%;cursor:pointer}.mm-in{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .55s cubic-bezier(.3,.7,.3,1.2)}.mm-card.on .mm-in,.mm:not(.js) .mm-card:focus-within .mm-in{transform:rotateY(180deg)}.mm-f,.mm-bk{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:1cqw;padding:.8cqw 1cqw;display:flex;flex-direction:column;justify-content:center;gap:.3cqw;box-sizing:border-box}.mm-f{background:var(--surface);border:1px solid color-mix(in srgb,var(--c) 35%,var(--line));box-shadow:inset .45cqw 0 0 var(--c),0 .5cqw 1.2cqw -.8cqw rgba(10,30,40,.4)}.mm-flip{all:unset;font:700 1.2cqw/1.2 var(--fb);color:var(--ink);cursor:pointer}.mm-flip:focus-visible{outline:2px solid var(--c);outline-offset:4px;border-radius:4px}.mm-tap{font:600 .85cqw var(--fb);color:var(--muted);letter-spacing:.04em}.mm-tap::before{content:"↻ "}.mm-bk{transform:rotateY(180deg);background:var(--c);color:#fff;text-decoration:none;font:500 1.02cqw/1.3 var(--fb)}.mm-bk b{font-weight:700;font-size:.95cqw;opacity:.92}.mm-bk:focus-visible{outline:3px solid var(--flame);outline-offset:2px}.mm-card:hover .mm-f{border-color:var(--c)}.mm[data-hl]:not([data-hl=""]) .mm-svg path{opacity:.12}.mm[data-hl="ehr"] .mm-svg path[data-b="ehr"]{opacity:.95;stroke-width:5}.mm[data-hl="ehr"] .mm-grp:not([data-b="ehr"]) .mm-leaf,.mm[data-hl="ehr"] .mm-grp:not([data-b="ehr"]) .mm-br{opacity:.38}.mm[data-hl="exam"] .mm-svg path[data-b="exam"]{opacity:.95;stroke-width:5}.mm[data-hl="exam"] .mm-grp:not([data-b="exam"]) .mm-leaf,.mm[data-hl="exam"] .mm-grp:not([data-b="exam"]) .mm-br{opacity:.38}.mm[data-hl="study"] .mm-svg path[data-b="study"]{opacity:.95;stroke-width:5}.mm[data-hl="study"] .mm-grp:not([data-b="study"]) .mm-leaf,.mm[data-hl="study"] .mm-grp:not([data-b="study"]) .mm-br{opacity:.38}.mm[data-hl="sim"] .mm-svg path[data-b="sim"]{opacity:.95;stroke-width:5}.mm[data-hl="sim"] .mm-grp:not([data-b="sim"]) .mm-leaf,.mm[data-hl="sim"] .mm-grp:not([data-b="sim"]) .mm-br{opacity:.38}.mm[data-hl="inst"] .mm-svg path[data-b="inst"]{opacity:.95;stroke-width:5}.mm[data-hl="inst"] .mm-grp:not([data-b="inst"]) .mm-leaf,.mm[data-hl="inst"] .mm-grp:not([data-b="inst"]) .mm-br{opacity:.38}.mm[data-hl="prog"] .mm-svg path[data-b="prog"]{opacity:.95;stroke-width:5}.mm[data-hl="prog"] .mm-grp:not([data-b="prog"]) .mm-leaf,.mm[data-hl="prog"] .mm-grp:not([data-b="prog"]) .mm-br{opacity:.38}@media (prefers-reduced-motion:reduce){.mm-in{transition:none}}/* narrow screens: a vertical tree with the same tiles */@media (max-width:1039px){.mm{margin-inline:0}.mm-stage{aspect-ratio:auto;container-type:normal;padding:18px 14px 20px;display:grid;gap:18px}.mm-svg{display:none}.mm-hub,.mm-br,.mm-leaf{position:relative;left:auto;top:auto;translate:none}.mm-hub{width:150px;margin:4px auto 6px;box-shadow:0 0 0 4px color-mix(in srgb,var(--flame) 55%,transparent),0 12px 26px -12px rgba(10,30,40,.55)}.mm-hub b{font-size:28px}.mm-hub span{font-size:11px}.mm-hub small{font-size:10.5px;max-width:110px;margin-top:4px}.mm-grp{display:grid;gap:10px;position:relative}.mm-br{width:auto;height:auto;justify-self:start;padding:10px 18px;font-size:16px;gap:8px}.mm-br svg{width:18px;height:18px}.mm-leaves{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-left:18px;padding-left:16px;border-left:3px solid var(--c)}.mm-leaf{width:auto;height:104px;perspective:700px}.mm-leaf::before{content:"";position:absolute;left:-19px;top:50%;width:16px;border-top:3px solid var(--c)}.mm-leaves .mm-leaf:nth-child(2n)::before{display:none}.mm-f,.mm-bk{border-radius:10px;padding:10px 12px;gap:4px}.mm-f{box-shadow:inset 5px 0 0 var(--c),0 6px 14px -10px rgba(10,30,40,.4)}.mm-flip{font-size:15.5px}.mm-tap{font-size:12px}.mm-bk{font-size:13.5px}.mm-bk b{font-size:13px}}@media (max-width:520px){.mm-leaves{grid-template-columns:1fr}.mm-leaves .mm-leaf:nth-child(2n)::before{display:block}.mm-leaf{height:92px}.mm-top{align-items:flex-start}}</style><section class="mm" aria-labelledby="mmh"><div class="mm-top"><div><h2 id="mmh">Explore the platform</h2><p>Six areas, one login. Tap any tile to flip it, or tap an area to flip its whole branch.</p></div>
    <div class="mm-ctl"><span class="mm-cnt" aria-live="polite"></span><button type="button" class="mm-b" data-mm="all">Flip all</button><button type="button" class="mm-b" data-mm="none">Reset</button></div></div>
