  const go=()=>{const k=key();document.documentElement.dataset.vxscene=k;document.querySelectorAll(".vxs-bg[data-vxs-i]").forEach(el=>{const off=+el.dataset.vxsI||0;if(el.dataset.k===k+pick(k,null,off))return;el.dataset.k=k+pick(k,null,off);el.innerHTML=art(k,"vxs-art",null,off);requestAnimationFrame(()=>el.classList.add("on"))})};
