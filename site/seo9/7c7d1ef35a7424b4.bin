(function vxsMain(){
/*<vxs-core>*/
  const SLOTS=[ // [startHour, key, label, composition]
    [5,"dawn","Dawn","lake"],[8,"morning","Morning","campus"],[11,"midday","Midday","hospital"],
    [14,"afternoon","Afternoon","lake"],[17,"sunset","Sunset","hospital"],[20,"night","Night","campus"]];
  const PAL={
    dawn:{sky:["#f6c9b8","#f9dcc6","#fdf0dc"],sun:[1250,330,40,"#fff0c8","#ffc9a0"],cloud:"#fff3ec",co:.85,mf:"#b9a6b8",mn:"#9c8ea6",h1:"#93b38a",h2:"#76a06e",w:["#c9b6c4","#7e9bb5"],wall:"#f6ede0",roof:"#5b5577",win:"#e7c9a8",lit:"#ffd98a",leaf:"#a7c49a",bl:"#fbe3e6",bd:"#f2b8c6",trunk:"#6b4f3a",bird:"#6b5a6e",gr:"#6f9963",city:"#b5a5b8",cityw:"#ffe1a8",stars:0,dark:0},
    morning:{sky:["#9fd3ea","#d6ecf3","#fbeed6"],sun:[1320,250,46,"#fff4c4","#ffe6a0"],cloud:"#ffffff",co:.9,mf:"#9dbccb",mn:"#87a9ba",h1:"#86b77a",h2:"#6aa262",w:["#7cc3d8","#3f8fae"],wall:"#f3eee2",roof:"#1d5670",win:"#6fa8c2",lit:"#6fa8c2",leaf:"#86b77a",bl:"#fdf6f2",bd:"#f4c9d2",trunk:"#6b4f3a",bird:"#3d5a68",gr:"#5f9a55",city:"#a8bfcb",cityw:"#d6e4ea",stars:0,dark:0},
    midday:{sky:["#6fbfe6","#a9dcf1","#e4f4f8"],sun:[1390,150,52,"#fffbe6","#fff0b0"],cloud:"#ffffff",co:.95,mf:"#a3c3d0",mn:"#8fb1c0",h1:"#8cc07a",h2:"#6fae5f",w:["#64b6d6","#2f85a8"],wall:"#f4f7f8",roof:"#1d5670",win:"#7fb7cf",lit:"#7fb7cf",leaf:"#5f9e55",bl:"#7dbb6a",bd:"#4f8f45",trunk:"#6b4f3a",bird:"#3d5a68",gr:"#5a9a50",city:"#aec4cf",cityw:"#e2eef2",stars:0,dark:0},
    afternoon:{sky:["#8cc6e3","#cfe6ee","#f6e6c8"],sun:[1180,300,46,"#fff0bf","#ffd98f"],cloud:"#fffaf0",co:.85,mf:"#9fb6c2",mn:"#87a2b1",h1:"#9ab874",h2:"#7ea35d",w:["#6eb2cc","#356f8f"],wall:"#f3ecdf",roof:"#7a3e2c",win:"#6fa8c2",lit:"#6fa8c2",leaf:"#c99a3e",bl:"#e0a640",bd:"#b8642c",trunk:"#6b4f3a",bird:"#3d5a68",gr:"#6c8f4c",city:"#a9bcc6",cityw:"#d6e4ea",stars:0,dark:0},
    sunset:{sky:["#4b4f86","#d77a6a","#f8c27a"],sun:[1330,400,58,"#fff0c0","#ff9f6a"],cloud:"#f3b5a0",co:.75,mf:"#7a6a8e",mn:"#5f557a",h1:"#5f7a5a",h2:"#4b6448",w:["#c98a7a","#3f4f78"],wall:"#e8d6c6",roof:"#2b3a5a",win:"#f4c27a",lit:"#ffd27a",leaf:"#4f6a48",bl:"#3f5a3c",bd:"#2f4630",trunk:"#3b2f2a",bird:"#3b2f44",gr:"#3f5a3c",city:"#5d5578",cityw:"#ffd27a",stars:0,dark:1},
    night:{sky:["#0b1a33","#1d3557","#3a4f6e"],moon:[1300,180,40],cloud:"#4a5f7e",co:.45,mf:"#2c3e57",mn:"#22324a",h1:"#2f4a3e",h2:"#253d33",w:["#1f3a58","#0d1f33"],wall:"#c9c4b6",roof:"#14304a",win:"#33506a",lit:"#ffd77a",leaf:"#2f4a3e",bl:"#e8dfe6",bd:"#b88fa2",trunk:"#3b2f2a",bird:"#000",gr:"#22382e",city:"#2c3e57",cityw:"#ffd77a",stars:1,dark:2}};
  // v26: twelve compositions. Each slot rotates through its list by local calendar day (stable across re-renders);
  // in season (Dec-Feb snow, Mar-Apr blossoms, Sep-Nov autumn) every other day is the seasonal scene.
  const COMPS=["lake","campus","hospital","mountains","rivertown","school","garden","nightward","graduation","autumn","spring","winter"];
  const ROT={dawn:["lake","mountains","rivertown","garden","nightward"],morning:["campus","school","mountains","garden","graduation"],
    midday:["hospital","graduation","rivertown","school","garden"],afternoon:["lake","rivertown","mountains","school","graduation"],
    sunset:["hospital","mountains","rivertown","nightward","garden"],night:["campus","nightward","rivertown","mountains","garden"]};
  const SEASON=m=>(m===11||m<2)?"winter":m<4?"spring":(m>7&&m<11)?"autumn":"";
  const dayN=d=>Math.floor((d.getTime()-d.getTimezoneOffset()*6e4)/864e5);
  const slot=(d)=>{const h=(d||new Date()).getHours();let s=SLOTS[SLOTS.length-1];for(const x of SLOTS){if(h>=x[0])s=x}if(h<5)s=SLOTS[SLOTS.length-1];return s};
  // off: stable per-section offset so stacked bands on one page show different pictures
  function pick(k,d,off){d=d||new Date();off=off|0;let q="";try{q=new URLSearchParams(location.search).get("art")||""}catch(e){}
    const L=ROT[k]||ROT.night,i=SLOTS.findIndex(x=>x[1]===k),n=dayN(d),se=SEASON(d.getMonth());
    if(COMPS.includes(q)&&!off)return q;
    const b=(se?n>>1:n)+i,at=j=>L[(b+j)%L.length];
    if(se){const p=n%2;if(off===p)return se;return at(off>p?off-1:off)}
    return at(off)}
  const mix=(a,b,t)=>{const h=c=>{c=c.slice(1);if(c.length===3)c=c.replace(/./g,"$&$&");return[0,2,4].map(i=>parseInt(c.substr(i,2),16))};const A=h(a),B=h(b);return"#"+A.map((v,i)=>Math.round(v+(B[i]-v)*t).toString(16).padStart(2,"0")).join("")};
  const rng=s=>()=>(s=(s*16807)%2147483647)/2147483647;
  const R0=Math.round;
  function art(key,cls,force,off){const S=SLOTS.find(x=>x[1]===key)||slot();const k=S[1],P=PAL[k],comp=COMPS.includes(force)?force:pick(k,null,off),id="vxs"+k+comp;
    const night=P.dark===2,X=EXT[comp];let o=`<svg class="${cls||"wsx-art"} vxs-${k}" data-vxs="${k}" data-vxc="${comp}" data-vxo="${off|0}" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><defs><linearGradient id="${id}S" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${P.sky[0]}"/><stop offset=".55" stop-color="${P.sky[1]}"/><stop offset=".8" stop-color="${P.sky[2]}"/></linearGradient><linearGradient id="${id}W" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${P.w[0]}"/><stop offset="1" stop-color="${P.w[1]}"/></linearGradient><radialGradient id="${id}G" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="${P.sun?P.sun[3]:"#fff"}"/><stop offset=".45" stop-color="${P.sun?P.sun[4]:"#cfd8ff"}" stop-opacity="${night?.35:.75}"/><stop offset="1" stop-color="${P.sun?P.sun[4]:"#cfd8ff"}" stop-opacity="0"/></radialGradient>${X?`<linearGradient id="${id}M" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${P.cloud}" stop-opacity="0"/><stop offset=".5" stop-color="${P.cloud}" stop-opacity=".9"/><stop offset="1" stop-color="${P.cloud}" stop-opacity="0"/></linearGradient><radialGradient id="${id}L"><stop offset="0" stop-color="${P.lit}" stop-opacity=".8"/><stop offset="1" stop-color="${P.lit}" stop-opacity="0"/></radialGradient>`:""}</defs><rect width="1600" height="900" fill="url(#${id}S)"/>`;
    if(P.stars){let st="";for(let i=0;i<70;i++){const x=(i*233)%1600,y=(i*97)%420,r=(i%5===0)?1.8:1;st+=`<circle cx="${x}" cy="${y}" r="${r}"/>`}o+=`<g fill="#fff" opacity=".8">${st}</g>`}
    const tw=(n,y0,y1,x0)=>{let s="";for(let i=0;i<n;i++)s+=`<circle cx="${x0+(i*389)%(1600-x0)}" cy="${y0+(i*151)%(y1-y0)}" r="${i%3?1.5:2.2}"/>`;return`<g class="vxs-tw" fill="#fff">${s}</g>`};
    if(night||(P.dark&&comp==="nightward"))o+=tw(15,24,night?380:200,780);
    if(P.sun){const[x,y,r,c]=P.sun;o+=`<circle cx="${x}" cy="${y}" r="${r*4.2}" fill="url(#${id}G)"/><circle cx="${x}" cy="${y}" r="${r}" fill="${c}"/>`}
    if(P.moon){const[x,y,r]=P.moon;o+=`<circle cx="${x}" cy="${y}" r="${r*2.6}" fill="url(#${id}G)" opacity=".55"/><path d="M${x} ${y-r}A${r} ${r} 0 1 0 ${x} ${y+r}A${r*.72} ${r} 0 1 1 ${x} ${y-r}Z" fill="#f4f0dc"/>`}
    o+=`<g class="vxs-cl" fill="${P.cloud}" opacity="${P.co}"><ellipse cx="210" cy="140" rx="120" ry="34"/><ellipse cx="290" cy="118" rx="80" ry="40"/><ellipse cx="150" cy="122" rx="60" ry="30"/><ellipse cx="1080" cy="110" rx="110" ry="28"/><ellipse cx="1150" cy="92" rx="70" ry="34"/><ellipse cx="520" cy="230" rx="90" ry="18" opacity=".6"/></g>`;
    if(!night)o+=`<g fill="none" stroke="${P.bird}" stroke-width="2.4" stroke-linecap="round" opacity=".5"><path d="M1180 170q8-8 16 0q8-8 16 0"/><path d="M1230 140q6-6 12 0q6-6 12 0"/><path d="M380 190q7-7 14 0q7-7 14 0"/></g>`;
    const win=(lit)=>lit&&P.dark?P.lit:P.win;
    // skyline
    const city=(tx,ty,s)=>`<g transform="translate(${tx} ${ty}) scale(${s})"><g fill="${P.city}"><rect x="0" y="20" width="34" height="90"/><rect x="40" y="-10" width="26" height="120"/><rect x="72" y="30" width="40" height="80"/><rect x="118" y="5" width="22" height="105"/><rect x="146" y="40" width="44" height="70"/></g><g fill="${P.cityw}"><rect x="46" y="2" width="5" height="6"/><rect x="55" y="2" width="5" height="6"/><rect x="46" y="18" width="5" height="6"/><rect x="55" y="34" width="5" height="6"/><rect x="122" y="20" width="5" height="6"/><rect x="130" y="40" width="5" height="6"/><rect x="80" y="44" width="5" height="6"/><rect x="160" y="54" width="5" height="6"/></g></g>`;
    const tree=(tx,ty,s,bl,bd)=>`<g transform="translate(${tx} ${ty}) scale(${s})"><path d="M0 0q-4-60 2-120" stroke="${P.trunk}" stroke-width="12" fill="none" stroke-linecap="round"/><path d="M0-70q-30-20-50-30M2-90q28-18 46-22" stroke="${P.trunk}" stroke-width="6" fill="none" stroke-linecap="round"/><g fill="${bl||P.bl}"><circle cx="-60" cy="-110" r="34"/><circle cx="-20" cy="-150" r="40"/><circle cx="30" cy="-140" r="38"/><circle cx="62" cy="-108" r="30"/><circle cx="0" cy="-104" r="34"/></g><g fill="${bd||P.bd}"><circle cx="-44" cy="-128" r="6"/><circle cx="-8" cy="-162" r="6"/><circle cx="34" cy="-150" r="6"/><circle cx="58" cy="-116" r="5"/><circle cx="6" cy="-118" r="6"/><circle cx="-70" cy="-100" r="5"/><circle cx="20" cy="-96" r="5"/></g></g>`;
    const pine=(tx,ty,s)=>`<g transform="translate(${tx} ${ty}) scale(${s})"><rect x="-5" y="-20" width="10" height="24" fill="${P.trunk}"/><path d="M0-150L-44-60H44Z M0-120L-54-20H54Z" fill="${P.leaf}"/><path d="M0-150L-44-60H0Z M0-120L-54-20H0Z" fill="#000" opacity=".12"/></g>`;
    const vx=(x,y)=>`<rect x="${x}" y="${y}" width="26" height="26" rx="6" fill="${P.roof}"/><path d="M${x+6} ${y+6}h5l3 9 4-9h5l-7 14h-4z" fill="#fff"/><path d="M${x+19} ${y+15}h3l3 3-3 3h-3l3-3z" fill="#c9a24a"/>`;
    const boat=(x,y,s,c)=>`<g transform="translate(${x} ${y}) scale(${s})"><path d="M0 0h60l-10 14h-42z" fill="${P.wall}"/><path d="M28 0v-44l22 38z" fill="${c||"#fff"}"/><path d="M26 0v-46" stroke="#5c6f78" stroke-width="2"/></g>`;
    if(X){const dk=[0,.32,.6][P.dark],tone=c=>dk?mix(c,P.mn,dk):c;
      const C={P,k,id,night,dk,tone,win,tree,pine,vx,boat,city,
        g:(d,f,op)=>`<path d="${d}" fill="${f}"${op?` opacity="${op}"`:""}/>`,
        mist:(y,h,op)=>`<rect y="${y}" width="1600" height="${h}" fill="url(#${id}M)" opacity="${op}"/>`,
        glow:(x,y,r)=>P.dark?`<circle cx="${R0(x)}" cy="${R0(y)}" r="${R0(r)}" fill="url(#${id}L)"/>`:"",
        ff:pts=>night?`<g fill="#ffd77a" opacity=".8">${pts.map(([x,y])=>`<circle cx="${x}" cy="${y}" r="3"/>`).join("")}</g>`:"",
        water:(y)=>`<g stroke="#fff" stroke-width="2" opacity="${night?.2:.45}" stroke-linecap="round"><path d="M120 ${y}h70M520 ${y-10}h90M900 ${y+10}h60M1180 ${y}h80M1380 ${y+30}h60M700 ${y+60}h70M300 ${y+90}h60M1100 ${y+80}h90"/></g>`};
      C.lamp=(x,y,s)=>{s=s||1;const ir=tone("#3a4450");return`<g transform="translate(${x} ${y}) scale(${s})"><rect x="-2.5" y="-74" width="5" height="74" fill="${ir}"/><path d="M-8-74h16l-3-15h-10z" fill="${P.dark?P.lit:tone("#f3e6c4")}"/><path d="M-10-89h20l-10-8z" fill="${ir}"/></g>`+C.glow(x,y-82*s,46*s)};
      C.bench=(x,y,s)=>{const wd=tone("#9a6b45"),ir=tone("#3a4450");return`<g transform="translate(${x} ${y}) scale(${s||1})"><path d="M-32-13v13M32-13v13M-34-42v29M34-42v29" stroke="${ir}" stroke-width="4" stroke-linecap="round"/><g fill="${wd}"><rect x="-38" y="-42" width="76" height="6" rx="2"/><rect x="-38" y="-33" width="76" height="6" rx="2"/><rect x="-41" y="-20" width="82" height="7" rx="2"/></g></g>`};
      const hd=tone("#3b2f2a");
      C.person=(x,y,s,c,up)=>`<g transform="translate(${R0(x)} ${R0(y)}) scale(${s})" fill="${c}"><circle cx="0" cy="-31" r="5.5" fill="${hd}"/><rect x="-6.5" y="-24" width="13" height="16" rx="5"/><rect x="-5.5" y="-11" width="4.5" height="11" rx="2"/><rect x="1" y="-11" width="4.5" height="11" rx="2"/>${up?`<path d="M5-21l7-13" stroke="${c}" stroke-width="3.5" stroke-linecap="round"/>`:""}</g>`;
      // periodic falling layer: each item is drawn at y and y-900, the group slides 900 units and loops seamlessly
      C.fall=(n,seed,mk,cls)=>{const r=rng(seed);let s="";for(let i=0;i<n;i++){const x=R0(i%4===0?r()*700:700+r()*900),y=R0(r()*900),a=r();s+=mk(x,y,a,i)+mk(x,y-900,a,i)}return`<g class="vxs-fall ${cls||""}"><g class="vxs-sw">${s}</g></g>`};
      return o+X(C)+`</svg>`}
    const comp0=comp,big=comp0==="lake";
    o+=big?`<path d="M0 450L140 330L260 380L420 270L560 360L700 300L860 390L1020 290L1180 370L1320 280L1460 350L1600 300V560H0Z" fill="${P.mf}"/><path d="M380 300L420 270L460 300L440 296L420 284L402 298Z M980 318L1020 290L1060 318L1040 312L1020 302L1000 314Z" fill="#fff" opacity="${night?.35:.8}"/><path d="M0 500L200 420L360 470L540 410L760 480L960 430L1160 490L1380 420L1600 470V600H0Z" fill="${P.mn}"/>`
      :`<path d="M0 470L120 430L260 445L420 400L560 420L760 380L980 395L1120 360L1260 372L1400 340L1600 360V560H0Z" fill="${P.mf}"/><path d="M1100 372L1260 372L1400 340L1600 360V420L1450 400L1300 410L1180 395Z" fill="${P.mn}"/>`;
    o+=`<path d="M0 520Q200 470 420 500T860 490T1300 480T1600 470V600H0Z" fill="${P.h1}"/><path d="M0 560Q260 520 520 548T1060 540T1600 520V640H0Z" fill="${P.h2}"/>`;
    if(comp0==="campus"){
      o+=`<g transform="translate(130 360)"><rect x="0" y="80" width="300" height="160" fill="${P.wall}" stroke="#00000022" stroke-width="2"/><path d="M-14 84L150 18L314 84Z" fill="${P.roof}"/><rect x="120" y="-26" width="60" height="58" fill="${P.wall}" stroke="#00000022" stroke-width="2"/><path d="M112 -24L150 -54L188 -24Z" fill="${P.roof}"/>${vx(137,-9)}<g stroke="#00000030" stroke-width="1.5">${[[22,104,1],[72,104,0],[198,104,1],[248,104,0],[22,160,0],[72,160,1],[198,160,1],[248,160,0]].map(([x,y,l])=>`<rect x="${x}" y="${y}" width="30" height="36" fill="${win(l)}"/>`).join("")}</g><rect x="124" y="150" width="52" height="90" rx="26" fill="${P.roof}"/><rect x="-20" y="236" width="340" height="10" fill="#00000018"/></g>${city(1210,430,1)}`;
    }else if(comp0==="hospital"){
      o+=`<g transform="translate(150 300)"><rect x="0" y="120" width="140" height="190" fill="${P.wall}" stroke="#00000022" stroke-width="2"/><rect x="140" y="20" width="160" height="290" fill="${P.wall}" stroke="#00000022" stroke-width="2"/><rect x="300" y="150" width="130" height="160" fill="${P.wall}" stroke="#00000022" stroke-width="2"/><rect x="140" y="8" width="160" height="14" fill="${P.roof}"/><rect x="0" y="110" width="140" height="12" fill="${P.roof}"/><rect x="300" y="140" width="130" height="12" fill="${P.roof}"/>
       <ellipse cx="220" cy="8" rx="46" ry="7" fill="#00000030"/><circle cx="220" cy="2" r="26" fill="none" stroke="#fff" stroke-width="3" opacity=".8"/><text x="220" y="11" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="24" fill="#fff" opacity=".9">H</text>
       <g transform="translate(196 44)"><rect width="48" height="48" rx="8" fill="#1f7a8c"/><path d="M19 9h10v10h10v10H29v10H19V29H9V19h10z" fill="#fff"/></g>
       ${(()=>{let w="";for(let r=0;r<6;r++)for(let c=0;c<5;c++)w+=`<rect x="${154+c*30}" y="${110+r*30}" width="18" height="18" fill="${win((r+c)%3!==0)}"/>`;for(let r=0;r<4;r++)for(let c=0;c<3;c++){w+=`<rect x="${16+c*42}" y="${140+r*38}" width="26" height="22" fill="${win((r*c)%2===0)}"/>`;w+=`<rect x="${316+c*38}" y="${172+r*32}" width="24" height="18" fill="${win((r+c)%2===1)}"/>`}return w})()}
       <rect x="190" y="262" width="60" height="48" fill="${P.roof}"/><rect x="170" y="252" width="100" height="10" fill="${P.roof}"/>${vx(400,160)}</g>
       <path d="M0 640Q300 600 700 616" stroke="#00000020" stroke-width="18" fill="none"/>${city(1180,430,1.1)}`;
    }else{
      o+=`<g transform="translate(1180 520) scale(.8)" opacity=".9"><rect x="0" y="40" width="200" height="90" fill="${P.wall}"/><path d="M-10 44L100 0L210 44Z" fill="${P.roof}"/><g>${[20,60,130,170].map((x,i)=>`<rect x="${x}" y="64" width="20" height="26" fill="${win(i%2===0)}"/>`).join("")}</g><rect x="84" y="80" width="32" height="50" rx="16" fill="${P.roof}"/></g>
       <g transform="translate(260 612)"><rect x="0" y="-30" width="120" height="40" fill="${P.wall}"/><path d="M-8 -28L60 -64L128 -28Z" fill="${P.roof}"/><rect x="40" y="-18" width="40" height="28" fill="${P.roof}"/><path d="M120 6H330" stroke="#6b4f3a" stroke-width="8"/><g stroke="#6b4f3a" stroke-width="5"><path d="M160 6v24M220 6v24M280 6v24"/></g></g>`;
    }
    o+=`<path d="M0 640Q400 610 800 628T1600 616V900H0Z" fill="url(#${id}W)"/>`;
    if(P.sun&&(k==="sunset"||k==="dawn"))o+=`<g fill="${P.sun[4]}" opacity=".45"><rect x="${P.sun[0]-60}" y="660" width="120" height="6" rx="3"/><rect x="${P.sun[0]-40}" y="690" width="80" height="5" rx="3"/><rect x="${P.sun[0]-24}" y="718" width="48" height="4" rx="2"/></g>`;
    if(P.moon)o+=`<g fill="#f4f0dc" opacity=".3"><rect x="${P.moon[0]-40}" y="680" width="80" height="5" rx="3"/><rect x="${P.moon[0]-24}" y="706" width="48" height="4" rx="2"/></g>`;
    o+=`<g stroke="#fff" stroke-width="2" opacity="${night?.2:.45}" stroke-linecap="round"><path d="M120 690h70M260 720h50M520 680h90M900 700h60M1180 690h80M1380 730h60M700 760h70M300 800h60M1100 790h90"/></g>`;
    if(comp0==="campus")o+=`<g transform="translate(980 600)"><path d="M0 40Q160 -40 320 40" fill="none" stroke="#5c6f78" stroke-width="10"/><g stroke="#5c6f78" stroke-width="4"><path d="M40 22v24M80 6v40M120 -2v48M160 -6v52M200 -2v48M240 6v40M280 22v24"/></g><rect x="-10" y="38" width="340" height="10" fill="#5c6f78"/></g>`;
    o+=comp0==="lake"?boat(640,800,1.2)+boat(980,730,.8,"#f2b84b")+boat(420,760,.7):boat(640,820,1);
    if(comp0==="campus")o+=tree(70,660,1.15)+tree(470,650,.9)+tree(1520,670,1.2)+tree(1110,650,.75);
    else if(comp0==="hospital")o+=tree(80,650,1)+tree(690,640,.8)+tree(1510,660,1.1)+tree(980,630,.7);
