try{F=new Intl.DateTimeFormat(undefined,{hour:"numeric",minute:"2-digit"})}catch(e){F=null}
function sb(d){if(F&&F.formatToParts){var p=F.formatToParts(d),h="",m="",s=":",i;for(i=0;i<p.length;i++){if(p[i].type==="hour")h=p[i].value;else if(p[i].type==="minute")m=p[i].value;else if(h&&!m&&p[i].type==="literal")s=p[i].value}if(h&&m)return h+s+m}return (d.getHours()%12||12)+":"+("0"+d.getMinutes()).slice(-2)}
function full(d){return F?F.format(d):sb(d)}
function iso(d){return d.getFullYear()+"-"+("0"+(d.getMonth()+1)).slice(-2)+"-"+("0"+d.getDate()).slice(-2)+"T"+("0"+d.getHours()).slice(-2)+":"+("0"+d.getMinutes()).slice(-2)}
function base(){var d=new Date();t0=Math.floor(d.getTime()/1000);a0={s:d.getSeconds()*6,m:d.getMinutes()*6+d.getSeconds()*.1,h:(d.getHours()%12)*30+d.getMinutes()*.5+d.getSeconds()/120}}
function hands(d,jump){var k=Math.floor(d.getTime()/1000)-t0,rm=R.matches,mn,hr,sc;if(rm){mn=d.getMinutes()*6;hr=(d.getHours()%12)*30+d.getMinutes()*.5}else{mn=a0.m+k*.1;hr=a0.h+k/120;sc=a0.s+k*6}
 C.forEach(function(c){var g=c.querySelectorAll("g");if(jump)c.classList.add("jump");g[0].style.transform="rotate("+hr+"deg)";g[1].style.transform="rotate("+mn+"deg)";if(sc!=null)g[2].style.transform="rotate("+sc+"deg)";c.classList.add("on");if(jump){c.getBoundingClientRect();c.classList.remove("jump")}})}
function paint(jump){var d=new Date(),mk=Math.floor(d.getTime()/6e4);if(mk!==last){last=mk;var a=sb(d),b=full(d),z=iso(d);for(var i=0;i<T.length;i++){T[i].textContent=T[i].getAttribute("data-f")==="sb"?a:b;T[i].setAttribute("datetime",z)}C.forEach(function(c){c.setAttribute("aria-label","Current time, "+b)})}if(C.length)hands(d,jump)}
function sched(){clearTimeout(tm);var n=Date.now(),step=(R.matches||!C.length)?6e4:1e3;tm=setTimeout(function(){if(!document.hidden)paint(false);sched()},step-n%step+8)}
function start(){base();paint(true);sched()}
start();document.addEventListener("visibilitychange",function(){if(!document.hidden)start()});if(R.addEventListener)R.addEventListener("change",start);else if(R.addListener)R.addListener(start)})();</script><script src="/vxs-1bt75x.js" defer></script></body></html>