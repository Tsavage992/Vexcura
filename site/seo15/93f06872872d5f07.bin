.gpx-k{margin:0 0 2pt;font-size:7.2pt;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#f8c27a}.gpx-h{margin:0;font:800 19pt/1.08 var(--fh);letter-spacing:-.01em}.gpx-l{margin:4pt 0 0;font-size:9.6pt;line-height:1.38;color:#eef0f7;max-width:62em}.gpx-l b,.gpx-l a{color:#f8c27a;font-weight:700}
.gpx-m{display:flex;flex-wrap:wrap;gap:4pt;margin:6pt 0 0}.gpx-m span{font-size:7pt;font-weight:600;background:rgb(255 255 255 / .13);border:.6pt solid rgb(255 255 255 / .28);border-radius:8pt;padding:1pt 6pt}
.gpx-band .gkey{margin:7pt 0 0;padding:6pt 0 0;border:0;border-top:.75pt solid rgb(255 255 255 / .25);border-radius:0;background:none}.gpx-band .gkey-t{display:none}.gkey ol{grid-template-columns:repeat(3,minmax(0,1fr));gap:4pt 12pt}.gkey li{grid-template-columns:13pt 1fr;gap:5pt;font-size:8.6pt;line-height:1.3;color:#fff}.gkey li b,.gkey li i{color:#f8c27a}.gkey li::before{width:13pt;height:13pt;font-size:7.5pt;background:#f8c27a;color:#2c3e57}
.gkp{display:block}
.gdoc{counter-reset:h}.gdoc>h2:not(.gsh){--sc:#4b4f86;counter-increment:h;display:flex;align-items:center;gap:6pt;font:800 12.5pt/1.2 var(--fh);color:var(--sc);margin:12pt 0 5pt;padding:0 0 3pt;border-bottom:1.2pt solid color-mix(in srgb,var(--sc) 30%,#fff);break-after:avoid}
.gdoc>h2:not(.gsh)::before{content:counter(h);flex:none;width:15pt;height:15pt;border-radius:50%;background:var(--sc);color:#fff;display:grid;place-items:center;font-size:8pt;font-weight:800}
.gdoc>h2:not(.gsh):nth-of-type(4n+2){--sc:#a94e3f}.gdoc>h2:not(.gsh):nth-of-type(4n+3){--sc:#2c3e57}.gdoc>h2:not(.gsh):nth-of-type(4n+4){--sc:#8a5a14}
.gdoc h3{font-size:10.5pt;font-weight:800;margin:8pt 0 3pt;break-after:avoid}.gdoc ul,.gdoc ol:not(.gsteps):not(.gsrc){padding-left:13pt}.gdoc li{margin:1.5pt 0}.gdoc li::marker{color:#4b4f86}
.tw{overflow:visible;margin:5pt 0}.vsheet .tw{break-inside:avoid}.gt thead{display:table-header-group}.gt{width:100%;border-collapse:separate;border-spacing:0;border:.75pt solid #cfd4e0;border-radius:6pt;overflow:hidden;background:#fff}.gt th{background:#2c3e57;color:#fff;font-size:7.6pt;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:4pt 6pt;text-align:left;border:0}.gt td{font-size:9pt;line-height:1.32;padding:3.5pt 6pt;border:0;border-top:.5pt solid #e1e4ec;vertical-align:top}.gt tbody tr:first-child td{border-top:0}.gt tbody tr:nth-child(even) td{background:#f4f5f9}.gt td b{color:#2c3e57}tr{break-inside:avoid}
