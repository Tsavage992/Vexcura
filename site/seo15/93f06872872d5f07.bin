.gcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:14px;margin:18px 0}.gcard{background:var(--surface);border:1px solid var(--line);border-top:4px solid var(--accent);padding:16px 18px;display:grid;gap:8px;align-content:start}.gcard.feat1{border-top-color:var(--gold);grid-column:1/-1}.gcard .gh{display:flex;gap:10px;align-items:center}.gcard .gh svg{color:var(--accent);flex:none}.gcard b{font:400 22px/1.2 var(--fh)}.gcard p{margin:0;color:var(--muted);font-size:15.5px}.gcard .gl{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}.gcard .gl a{font-weight:700}.gcard small{color:var(--muted)}
.vtag{display:inline-block;padding:1px 8px;border-radius:4px;font-weight:800;color:#fff;font-size:.9em}.vtag.g{background:#2f7a3d}.vtag.k{background:#222}.vtag.r{background:#b33a3a}.vtag.y{background:#e0b000;color:#222}.vsheet{--t:#1d5670}.vsheet .gcard{border-top-color:var(--t)}
.vrow{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:10px;margin:12px 0}
.vc{border-radius:10px;overflow:hidden;border:1.5px solid color-mix(in srgb,var(--c,var(--t)) 40%,var(--line));background:var(--surface);break-inside:avoid;display:flex;flex-direction:column}
.vch{margin:0;background:var(--c,var(--t));color:#fff;font-weight:700;padding:7px 12px;display:flex;gap:8px;align-items:center;font-size:15.5px;line-height:1.25}.vch svg{flex:none}
.vch em{margin-left:auto;font-style:normal;font-size:11px;text-transform:uppercase;letter-spacing:.06em;background:rgb(255 255 255 / .22);padding:2px 8px;border-radius:10px;white-space:nowrap}
.vcb{padding:8px 12px;flex:1}.vcb p{margin:4px 0}
.vl{list-style:none;margin:0;padding:0}.vl li{position:relative;padding-left:16px;margin:4px 0}.vl li::before{content:"";position:absolute;left:2px;top:.55em;width:7px;height:7px;border-radius:50%;background:var(--c,var(--t))}
.vvs{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:stretch;margin:12px 0}.vsx{align-self:center;width:38px;height:38px;border-radius:50%;background:var(--navy);color:var(--flame);display:grid;place-items:center;font:italic 700 15px var(--fh)}
.vkeys{display:grid;grid-template-columns:repeat(var(--k,3),minmax(0,1fr));gap:8px;margin:12px 0}.vk{border:1.5px dashed var(--t);border-radius:10px;padding:8px 11px;background:color-mix(in srgb,var(--t) 7%,var(--surface))}.vk b{display:block;font:400 23px/1.1 var(--fh);color:color-mix(in srgb,var(--t) 55%,var(--ink))}.vk span{font-size:13.5px;line-height:1.3;display:block;margin-top:2px}
.vflow{margin:12px 0}.vft{font:400 19px var(--fh);margin:0 0 6px;color:color-mix(in srgb,var(--t) 55%,var(--ink))}
.vflow ol{list-style:none;counter-reset:f;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--k,4),minmax(0,1fr));gap:10px}
.vflow li{counter-increment:f;position:relative;background:color-mix(in srgb,var(--t) 8%,var(--surface));border:1px solid color-mix(in srgb,var(--t) 30%,var(--line));border-radius:10px;padding:26px 10px 8px;break-inside:avoid}
.vflow li::before{content:counter(f);position:absolute;top:-10px;left:10px;width:28px;height:28px;border-radius:50%;background:var(--t);color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px;border:2px solid var(--surface)}
.vflow li:not(:last-child)::after{content:"";position:absolute;right:-9px;top:50%;width:8px;height:8px;border-top:2.5px solid var(--t);border-right:2.5px solid var(--t);transform:translateY(-50%) rotate(45deg);z-index:1}
.vflow li>b{display:block;font-size:14.5px}.vflow li>span{display:block;font-size:13.5px;line-height:1.3;margin-top:2px}
.valert,.vtip{display:flex;gap:10px;align-items:flex-start;border-radius:10px;padding:9px 12px;margin:12px 0;break-inside:avoid}.valert{background:var(--bad-soft);border:1.5px solid var(--bad)}.valert svg{color:var(--bad);flex:none;margin-top:2px}.valert b{color:var(--bad)}
.vtip{background:color-mix(in srgb,var(--gold) 10%,var(--surface));border:1.5px dashed var(--gold)}.vtip svg{color:var(--gold);flex:none;margin-top:3px}
.vt{width:100%;border-collapse:collapse;font-size:14px}.vt th{text-align:left;background:color-mix(in srgb,var(--c,var(--t)) 13%,var(--surface));padding:5px 7px;font-size:12.5px;text-transform:uppercase;letter-spacing:.03em}.vt td{padding:5px 7px;border-bottom:1px solid var(--line);vertical-align:top}.vt tr:last-child td{border-bottom:0}
.vsm{font-size:13px;color:var(--muted);margin:6px 0 0}
.vel{border:1.5px solid var(--c);border-radius:10px;overflow:hidden;margin:10px 0;break-inside:avoid}.velh{display:flex;justify-content:space-between;align-items:baseline;gap:10px;background:var(--c);color:#fff;padding:6px 12px}.velh b{font:400 19px var(--fh)}.velh span{font-weight:700;font-size:14px;background:rgb(255 255 255 / .2);padding:1px 9px;border-radius:10px}
.velb{display:grid;grid-template-columns:1fr 1fr}.vlo,.vhi{display:grid;grid-template-columns:26px 1fr;gap:6px;padding:7px 10px}.vlo{background:color-mix(in srgb,#2b4c7e 6%,var(--surface))}.vhi{background:color-mix(in srgb,#9d2a22 6%,var(--surface));border-left:1px solid var(--line)}
.va{font-style:normal;color:#2b4c7e}.va-up{color:#b23a2e}.vlo>.va,.vhi>.va{font-size:20px;line-height:1.1}.vlo .vl li::before{background:#2b4c7e}.vhi .vl li::before{background:#b23a2e}
.vabg{font-weight:800;margin:0 0 4px;font-size:15.5px}
.vbf{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:12px 0}.vbf div{border-radius:10px;background:color-mix(in srgb,var(--t) 8%,var(--surface));border:1.5px solid color-mix(in srgb,var(--t) 35%,var(--line));padding:8px;text-align:center}.vbf b{display:grid;place-items:center;width:42px;height:42px;margin:0 auto 4px;border-radius:50%;background:var(--t);color:#fff;font:700 24px var(--fh)}.vbf span{display:block;font-weight:800}.vbf small{display:block;font-size:12.5px;line-height:1.25;margin-top:2px}
.vbf div:last-child b{background:#9d2a22}
.vzone div{border-radius:7px;padding:6px 10px;margin:5px 0;display:flex;flex-direction:column}.vzone b{font-size:14.5px}.vzone span{font-size:13px}.zg{background:#2f6146;color:#fff}.zy{background:#e0b22f;color:#2a1f0b}.zr{background:#9d2a22;color:#fff}
.vgfr{margin:12px 0}.vgfr>div{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-radius:8px;overflow:hidden}.vgfr span{color:#fff;padding:6px 4px;text-align:center;font-size:13px;line-height:1.2}.vgfr span b{display:block;font-size:16px}
.vburn{display:grid;grid-template-columns:190px 1fr;gap:14px;align-items:start;margin:12px 0}.vnine{width:100%;height:auto}
.vform{font:700 21px var(--fh);text-align:center;background:color-mix(in srgb,var(--c,var(--t)) 9%,var(--surface));border-radius:8px;padding:6px;margin:2px 0 6px!important}
.vban{display:none}
@media screen and (max-width:720px){.vkeys{grid-template-columns:1fr 1fr}.vflow ol{grid-template-columns:1fr 1fr;row-gap:16px}.vflow li:not(:last-child)::after{display:none}.vrow{grid-template-columns:1fr}.vvs{grid-template-columns:1fr}.vsx{justify-self:center}.vbf{grid-template-columns:repeat(3,minmax(0,1fr))}.velb{grid-template-columns:1fr}.vhi{border-left:0;border-top:1px solid var(--line)}.vburn{grid-template-columns:1fr}.vnine{max-width:220px;margin:0 auto;display:block}.vgfr span{font-size:11px}.vgfr span b{font-size:13px}}
@media print{.vsheet{zoom:var(--z,1.2)}.vsheet *{-webkit-print-color-adjust:exact;print-color-adjust:exact}.vsheet .hero,.vsheet .gpr{display:none!important}.vban{display:flex!important;justify-content:space-between;align-items:center;gap:12pt;background:var(--t);color:#fff;border-radius:8pt;padding:7pt 12pt;margin:0 0 6pt}.vban small{display:block;font-size:7.5pt;letter-spacing:.08em;text-transform:uppercase;opacity:.85}.vban b{display:block;font:400 19pt/1.1 var(--fh)}.vban p{margin:2pt 0 0;font-size:9pt;opacity:.95}.vban p b{display:inline;font:inherit;font-weight:700}.vban>div{flex:1}.vban>span{flex:none;display:flex;flex-direction:column;align-items:center;gap:2pt;font-size:6.5pt;opacity:.9;max-width:62pt;text-align:center;overflow-wrap:anywhere}.vban svg{width:16pt;height:19pt}
.vsheet body,.vsheet{font-size:8.4pt;line-height:1.3}.vrow,.vvs{gap:6pt;margin:5pt 0}.vch{font-size:9.3pt;padding:3pt 7pt}.vch svg{width:10pt;height:10pt}.vch em{font-size:6.5pt;padding:1pt 5pt}.vcb{padding:3pt 7pt}.vl li{margin:1pt 0;padding-left:10pt}.vl li::before{width:4.5pt;height:4.5pt;top:.5em}.vsx{width:22pt;height:22pt;font-size:9pt}
.vkeys{gap:5pt;margin:5pt 0}.vk{padding:3pt 7pt}.vk b{font-size:13pt}.vk span{font-size:7.6pt}.vflow{margin:6pt 0}.vft{font-size:11pt;margin:0 0 4pt}.vflow ol{gap:6pt}.vflow li{padding:13pt 6pt 4pt}.vflow li::before{width:16pt;height:16pt;font-size:8pt;top:-6pt;left:6pt}.vflow li>b{font-size:8.6pt}.vflow li>span{font-size:7.7pt}.vflow li:not(:last-child)::after{right:-6pt;width:5pt;height:5pt}
.valert,.vtip{padding:4pt 8pt;margin:5pt 0;gap:6pt}.valert svg,.vtip svg{width:11pt;height:11pt}.vt{font-size:7.8pt}.vt th{font-size:6.9pt;padding:2pt 4pt}.vt td{padding:1.6pt 4pt}.vsm{font-size:7.4pt;margin:3pt 0 0}
.vel{margin:4pt 0}.velh{padding:2pt 8pt}.velh b{font-size:11pt}.velh span{font-size:8pt}.vlo,.vhi{padding:3pt 6pt;grid-template-columns:13pt 1fr;gap:3pt}.vlo>.va,.vhi>.va{font-size:11pt}.vabg{font-size:9pt;margin:0 0 2pt}
.vbf{gap:5pt;margin:5pt 0}.vbf div{padding:4pt}.vbf b{width:22pt;height:22pt;font-size:13pt;margin-bottom:2pt}.vbf small{font-size:7.2pt}.vzone div{padding:2.5pt 6pt;margin:2.5pt 0}.vzone b{font-size:8.4pt}.vzone span{font-size:7.6pt}
.vgfr{margin:5pt 0}.vgfr span{font-size:7.5pt;padding:2.5pt 2pt}.vgfr span b{font-size:9pt}.vburn{grid-template-columns:120pt 1fr;gap:9pt;margin:5pt 0}.vform{font-size:13pt;padding:3pt}
.vsheet .gsh{font-size:9pt;margin:5pt 0 1pt}.vsheet .gsrc{font-size:6.6pt;line-height:1.25}.vsheet .gdis{font-size:6.3pt;margin:2pt 0 0}.vsheet .gfine{margin:3pt 0}}
@page{size:letter;margin:.55in .6in .7in}
.gkey{background:color-mix(in srgb,var(--flame) 14%,var(--surface));border:1px solid color-mix(in srgb,var(--flame) 55%,var(--line));border-radius:10px;padding:12px 16px;margin:6px 0 18px}.gkey-t{margin:0 0 8px;font-weight:800;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink)}.gkey ol{list-style:none;counter-reset:k;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px 16px}.gkey li{counter-increment:k;display:grid;grid-template-columns:26px 1fr;gap:8px;align-items:start;line-height:1.35}.gkey li::before{content:counter(k);width:24px;height:24px;border-radius:50%;background:var(--navy);color:var(--flame);display:grid;place-items:center;font-weight:800;font-size:13px}.gpx,.gkp{display:none}
@media print{:root{--bg:#fff;--surface:#fff;--sunk:#eef0f6;--ink:#1d2738;--muted:#4a5568;--line:#d5d9e3;--navy:#2c3e57;--accent:#4b4f86;--gold:#8a5a14;--flame:#f8c27a;--good:#2f6b45;--good-soft:#ebf5ee;--bad:#a1271d;--bad-soft:#fdeae7;--fh:Archivo,"Helvetica Neue",Arial,sans-serif;--fb:Archivo,"Helvetica Neue",Arial,sans-serif;color-scheme:light}
html,body{background:#fff}body{font:400 10pt/1.42 var(--fb);color:var(--ink)}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}
.top,.foot,.crumb,.cta,.band,.gmore,.gnp,.hero,.gpr,.vban,.gks{display:none!important}.w{max-width:none;padding:0}a{color:inherit;text-decoration:none}p{margin:4pt 0}ul,ol{margin:4pt 0}
