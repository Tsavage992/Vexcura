.gend{break-inside:avoid;margin:12pt 0 0;padding:7pt 0 0;border-top:1pt solid #d5d9e3}.gsh{font:800 7.6pt var(--fb)!important;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)!important;margin:0 0 3pt!important;border:0!important;padding:0!important}.gsh::before{display:none!important}.gsrc{font-size:7.6pt;line-height:1.32;margin:0;padding-left:12pt;color:var(--muted);columns:2;column-gap:14pt}.gsrc li{margin:0 0 1.5pt;break-inside:avoid}.gdis{font-size:7.2pt;line-height:1.3;margin:4pt 0 0;color:var(--muted)}.gfine{font-size:8.4pt;color:var(--muted)}
.vsheet .vk b,.vsheet .vft,.vsheet .vform,.vsheet .velh b{font-weight:800}.vsheet .vt th{font-weight:700}.vsheet .gend{margin-top:5pt;padding-top:4pt}.vsheet .gsrc{font-size:6.4pt;columns:2}.vsheet .gsh{font-size:6.6pt!important}}</style><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"><nav class="crumb w" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/nclex-study-guides">Study guides</a> › <span>COPD vs. asthma, plus oxygen safety</span></nav><div class="w"><header class="gpx"><div class="gpx-top"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><defs><linearGradient id="sxlW" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:var(--vxa);stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlWr" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxrb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxrc);stop-opacity:1"/></linearGradient><linearGradient id="sxlB" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offset="0" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlBr" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxrc);stop-opacity:1"/></linearGradient><linearGradient id="sxlF" gradientUnits="userSpaceOnUse" x1="0" y1="4" x2="25" y2="-72"><stop offset="0" style="stop-color:var(--vxc);stop-opacity:0"/><stop offset=".55" style="stop-color:var(--vxc);stop-opacity:0.55"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:0.95