body.v26{--t0:#fff;--t1:#f5f7f8;--t2:#fff;--t3:#eef2f4;--t4:#e1e8ec;--hdr:rgba(255,255,255,.72);background:var(--t0);-webkit-font-smoothing:antialiased}
@media (prefers-color-scheme:dark){body.v26{--t0:#0b1d27;--t1:#112a37;--t2:#0b1d27;--t3:#1a3a4a;--t4:#24485a;--hdr:rgba(11,29,39,.78)}}
body.v26 header.top{background:var(--hdr)!important;-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid rgba(20,35,43,.08)}
body.v26 .crumb{text-align:center;font-size:13px;color:var(--muted);margin-top:18px}
body.v26 main>.hero.w{max-width:1180px;margin:14px auto 0;border-radius:36px;padding:clamp(52px,8vw,108px) clamp(22px,5vw,72px) clamp(44px,6vw,76px);text-align:center;background:radial-gradient(60% 80% at 0% 0%,rgba(29,86,112,.10),transparent 70%),radial-gradient(55% 75% at 100% 0%,rgba(243,196,120,.22),transparent 70%),radial-gradient(60% 80% at 100% 100%,rgba(233,128,106,.12),transparent 70%),var(--t1)}
body.v26 .hero h1{font-size:clamp(44px,7.6vw,92px);line-height:1;letter-spacing:-.028em;max-width:15ch;margin:0 auto 20px}
body.v26 .hero p.lead{font-size:clamp(18px,2.1vw,23px);line-height:1.45;max-width:44ch;margin:0 auto 24px;color:var(--ink)}
body.v26 .hero>p{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
body.v26 .hero .cta,body.v26 .hero .daily{justify-content:center;margin-left:auto;margin-right:auto}
body.v26 .hero .pill{margin:0}
body.v26 main>.w{max-width:980px}
body.v26 main>.w>h2,body.v26 main>section .w>h2{font-size:clamp(32px,4.6vw,56px);line-height:1.04;letter-spacing:-.02em;margin:96px 0 18px;max-width:20ch}
body.v26 main>.w>h2:first-child{margin-top:72px}
body.v26 main>.w>p{font-size:18px;max-width:62ch}
body.v26 .btn{border-radius:999px;padding:12px 22px;font-weight:600}
body.v26 .tips,body.v26 .faq details,body.v26 article.q,body.v26 .fnd,body.v26 .mocw,body.v26 .split{border-radius:24px}
body.v26 .tips{background:var(--t1);border:0;padding:26px 30px}
body.v26 article.q{border:0;background:var(--t1);padding:24px 26px;margin:16px 0}
body.v26 .faq details{border:0;background:var(--t1);margin:10px 0;padding:4px 22px}
body.v26 .fnd{background:var(--t1);border:0;padding:clamp(22px,4vw,40px)}
body.v26 ul.rel{display:flex;gap:12px;padding:6px 2px 18px;margin:0;list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}body.v26 ul.rel::-webkit-scrollbar{display:none}body.v26 ul.rel>li{flex:0 0 min(70%,260px);scroll-snap-align:start}
body.v26 ul.rel li{margin:0}body.v26 ul.rel a{display:block;height:100%;box-sizing:border-box;padding:16px 18px;border-radius:18px;background:var(--t1);text-decoration:none;font-weight:600;color:var(--ink)}
body.v26 ul.rel a:hover{background:var(--t3)}
body.v26 .band{border-radius:36px;max-width:1180px;margin:96px auto 24px;overflow:hidden}
body.v26 .band h2{font-size:clamp(32px,4.6vw,56px);letter-spacing:-.02em;line-height:1.04}
body.v26 .mktf-cta{color:#fff!important}
body.v26 .mpanel .mt.hero small{color:inherit;opacity:.85}
@media (prefers-color-scheme:dark){body.v26 .moc-top{color:#1b1405}}
body.v26 main>.hero.w.hv{text-align:left}
body.v26 .hero.hv h1{font-size:clamp(40px,5.2vw,68px);line-height:1.02;max-width:14ch;margin:0 0 18px}
body.v26 .hero.hv p.lead{margin:0 0 24px;max-width:34ch}
body.v26 .hero.hv .cta,body.v26 .hero.hv>p{justify-content:flex-start;margin-left:0}
body.v26 .feat div{border:0;border-radius:22px;background:var(--t1);padding:22px 24px}
body.v26 .gcard{border:0!important;border-radius:24px!important;background:var(--t1)!important;box-shadow:none!important}
body.v26 .tw{border-radius:20px;overflow:hidden;border:0}
@media (max-width:620px){body.v26 .feat{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 16px;margin:18px 0}body.v26 .feat::-webkit-scrollbar{display:none}body.v26 .feat>div{flex:0 0 78%;scroll-snap-align:start;box-sizing:border-box}}
@media (max-width:820px){body.v26 main>.hero.w.hv{text-align:center}body.v26 .hero.hv h1,body.v26 .hero.hv p.lead{margin-left:auto;margin-right:auto}body.v26 .hero.hv .cta,body.v26 .hero.hv>p{justify-content:center}}
body.v26 .v26-qw{position:relative;margin:0 0 8px}
body.v26 .v26-q{display:flex;align-items:flex-start;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;scrollbar-width:none;padding:6px 2px 14px}
body.v26 .v26-q::-webkit-scrollbar{display:none}
body.v26 .v26-q>article.q{flex:0 0 100%;box-sizing:border-box;scroll-snap-align:center;margin:0}
body.v26 .v26-qn{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 6px}
body.v26 .v26-qn span{font-size:14.5px;color:var(--muted);font-weight:600}
body.v26 .v26-qn div{display:flex;gap:10px}
body.v26 .v26-qn button{width:44px;height:44px;border-radius:50%;border:0;background:var(--t3);color:var(--ink);font:400 26px/1 var(--fb);cursor:pointer}
body.v26 .v26-qn button[disabled]{opacity:.35;cursor:default}
html.v26-rv .rv{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
html.v26-rv .rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){html.v26-rv .rv{opacity:1;transform:none;transition:none}}
@media (max-width:620px){body.v26 main>.hero.w{margin:8px 8px 0;border-radius:28px}body.v26 main>.w h2{margin-top:72px}body.v26 .band{margin:72px 8px 16px;border-radius:28px}}
</style><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://vexcura.com/"},{"@type":"ListItem","position":2,"name":"NCLEX prep compared","item":"https://vexcura.com/nclex-prep-comparison"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is there a free alternative to UWorld for the NCLEX?","acceptedAnswer":{"@type":"Answer","text":"Vexcura's public practice questions and study guides are free to use. The full platform, with adaptive (CAT) exams, NGN case studies and proctored test-day mode, is free for nursing students with a Vexcura account; nursing programs license it for their faculty and cohorts. It has fewer questions than the largest paid banks, so some students use both: a question bank for volume and Vexcura for full exams and test-day rehearsal."}},{"@type":"Question","name":"Do I need a paid NCLEX prep course to pass?","acceptedAnswer":{"@type":"Answer","text":"Not necessarily. What matters most is steady practice with rationales, full-length timed exams, and reviewing your weak categories. A paid course adds more questions, videos, and sometimes a pass guarantee. Free tools can cover the practice exam and test-day rehearsal."}},{"@type":"Question","name":"Which NCLEX prep includes an adaptive (CAT) exam?","acceptedAnswer":{"@type":"Answer","text":"All of the programs compared here include CAT exams in their plans. Vexcura's is included free with a Vexcura student account, with or without a school."}},{"@type":"Question","name":"Are these prices current?","acceptedAnswer":{"@type":"Answer","text":"They were taken from each company's website on October 29, 2026; Kaplan, Archer Review and SimpleNursing prices were re-checked on November 16, 2026. Prices and plans change often, so check the company's site before you buy."}}]}</script></head><body cla