<link rel="stylesheet" href="/s-yiqru.css"><style id="v26" media="screen">
body.v26{--t0:#fff;--t1:#f5f7f8;--t2:#fff;--t3:#eef2f4;--t4:#e1e8ec;--hdr:rgba(255,255,255,.72);background:var(--t0);-webkit-font-smoothing:antialiased}
@media (prefers-color-scheme:dark){body.v26{--t0:#0b1d27;--t1:#112a37;--t2:#0b1d27;--t3:#1a3a4a;--t4:#24485a;--hdr:rgba(11,29,39,.78)}}
body.v26 header.top{background:var(--hdr)!important;-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid rgba(20,35,43,.08)}
body.v26 .crumb{text-align:center;font-size:13px;color:var(--muted);margin-top:18px}
body.v26 main>.hero.w{max-width:1180px;margin:14px auto 0;border-radius:36px;padding:clamp(52px,8vw,108px) clamp(22px,5vw,72px) clamp(44px,6vw,76px);text-align:center;background:radial-gradient(60% 80% at 0% 0%,rgba(29,86,112,.10),transparent 70%),radial-gradient(55% 75% at 100% 0%,rgba(243,196,120,.22),transparent 70%),radial-gradient(60% 80% at 100% 100%,rgba(233,128,106,.12),transparent 70%),var(--t1)}
body.v26 .hero h1{font-size:clamp(44px,7.6vw,92px);line-height:1;letter-spacing:-.028em;max-width:15ch;margin:0 auto 20px}
body.v26 .hero p.lead{font-size:clamp(18px,2.1vw,23px);line-height:1.45;max-width:44ch;margin:0 auto 24px;color:var(--ink)}
body.v26 .hero>p{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
body.v26 .hero .cta,body.v26 .hero .daily{justify-content:center;margin-left:auto;margin-right:auto}
body.v26 .hero .pill{margin:0}
body.v26 main>.w{max-width:980px}
body.v26 main>.w>h2,body.v26 main>section .w>h2{font-size:clamp(32px,4.6vw,56px);line-height:1.04;letter-spacing:-.02em;margin:96px 0 18px;max-width:20ch}
body.v26 main>.w>h2:first-child{margin-top:72px}
body.v26 main>.w>p{font-size:18px;max-width:62ch}
body.v26 .btn{border-radius:999px;padding:12px 22px;font-weight:600}
body.v26 .tips,body.v26 .faq details,body.v26 article.q,body.v26 .fnd,body.v26 .mocw,body.v26 .split{border-radius:24px}
body.v26 .tips{background:var(--t1);border:0;padding:26px 30px}
body.v26 article.q{border:0;background:var(--t1);padding:24px 26px;margin:16px 0}
body.v26 .faq details{border:0;background:var(--t1);margin:10px 0;padding:4px 22px}
body.v26 .fnd{background:var(--t1);border:0;padding:clamp(22px,4vw,40px)}
body.v26 ul.rel{display:flex;gap:12px;padding:6px 2px 18px;margin:0;list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}body.v26 ul.rel::-webkit-scrollbar{display:none}body.v26 ul.rel>li{flex:0 0 min(70%,260px);scroll-snap-align:start}
body.v26 ul.rel li{margin:0}body.v26 ul.rel a{display:block;height:100%;box-sizing:border-box;padding:16px 18px;border-radius:18px;background:var(--t1);text-decoration:none;font-weight:600;color:var(--ink)}
body.v26 ul.rel a:hover{background:var(--t3)}
body.v26 .band{border-radius:36px;max-width:1180px;margin:96px auto 24px;overflow:hidden}
body.v26 .band h2{font-size:clamp(32px,4.6vw,56px);letter-spacing:-.02em;line-height:1.04}
body.v26 .mktf-cta{color:#fff!important}
body.v26 .mpanel .mt.hero small{color:inherit;opacity:.85}
@media (prefers-color-scheme:dark){body.v26 .moc-top{color:#1b1405}}
body.v26 main>.hero.w.hv{text-align:left}
body.v26 .hero.hv h1{font-size:clamp(40px,5.2vw,68px);line-height:1.02;max-width:14ch;margin:0 0 18px}
body.v26 .hero.hv p.lead{margin:0 0 24px;max-width:34ch}
body.v26 .hero.hv .cta,body.v26 .hero.hv>p{justify-content:flex-start;margin-left:0}
body.v26 .feat div{border:0;border-radius:22px;background:var(--t1);padding:22px 24px}
body.v26 .gcard{border:0!important;border-radius:24px!important;background:var(--t1)!important;box-shadow:none!important}
body.v26 .tw{border-radius:20px;overflow:hidden;border:0}
@media (max-width:620px){body.v26 .feat{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 16px;margin:18px 0}body.v26 .feat::-webkit-scrollbar{display:none}body.v26 .feat>div{flex:0 0 78%;scroll-snap-align:start;box-sizing:border-box}}
@media (max-width:820px){body.v26 main>.hero.w.hv{text-align:center}body.v26 .hero.hv h1,body.v26 .hero.hv p.lead{margin-left:auto;margin-right:auto}body.v26 .hero.hv .cta,body.v26 .hero.hv>p{justify-content:center}}
body.v26 .v26-qw{position:relative;margin:0 0 8px}
body.v26 .v26-q{display:flex;align-items:flex-start;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;scrollbar-width:none;padding:6px 2px 14px}
body.v26 .v26-q::-webkit-scrollbar{display:none}
body.v26 .v26-q>article.q{flex:0 0 100%;box-sizing:border-box;scroll-snap-align:center;margin:0}
body.v26 .v26-qn{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 6px}
body.v26 .v26-qn span{font-size:14.5px;color:var(--muted);font-weight:600}
body.v26 .v26-qn div{display:flex;gap:10px}
body.v26 .v26-qn button{width:44px;height:44px;border-radius:50%;border:0;background:var(--t3);color:var(--ink);font:400 26px/1 var(--fb);cursor:pointer}
body.v26 .v26-qn button[disabled]{opacity:.35;cursor:default}
html.v26-rv .rv{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
html.v26-rv .rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){html.v26-rv .rv{opacity:1;transform:none;transition:none}}
@media (max-width:620px){body.v26 main>.hero.w{margin:8px 8px 0;border-radius:28px}body.v26 main>.w h2{margin-top:72px}body.v26 .band{margin:72px 8px 16px;border-radius:28px}}
</style><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://vexcura.com/"},{"@type":"ListItem","position":2,"name":"NCLEX pass guarantee (fee reimbursement)","item":"https://vexcura.com/nclex-pass-guarantee"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"HowTo","name":"How to qualify for Vexcura's NCLEX fee reimbursement (pass guarantee with conditions)","step":[{"@type":"HowToStep","position":1,"text":"Get Vexcura through your nursing program. Vexcura is licensed to nursing schools, so students never pay. Join with the code from your instructor."},{"@type":"HowToStep","position":2,"text":"Read and sign the agreement before your NCLEX. Open My Chart, read the full agreement (version 2.1), check the three boxes, print your name and draw your signature. You have to sign before the day of your NCLEX. Your signed copy stays in your account."},{"@type":"HowToStep","position":3,"text":"Enter your NCLEX test date. Save your test date in Vexcura before you test."},{"@type":"HowToStep","position":4,"text":"Raise your Usage Score to 98% or higher. My Chart shows each part of the score, its target and your progress. The table below lists what earns points."},{"@type":"HowToStep","position":5,"text":"Pass 3 full exams in proctored test-day mode. Each one needs 85 or more questions, a Pass result and a Clean integrity report. Keep every proctored practice exam you take after signing Clean."},{"@type":"HowToStep","position":6,"text":"Take your NCLEX. If you pass, you're done and there's nothing to claim. The agreement ends when you pass."},{"@type":"HowToStep","position":7,"text":"If you don't pass, submit a claim within 30 days. Submit it from My Chart within 30 days of your official result. Within 14 days of our request, send your official result, your Pearson VUE receipt showing your name and the amount paid, and proof of identity."},{"@type":"HowToStep","position":8,"text":"Get a decision. Vexcura decides within 30 days of receiving all documents. If your claim is approved, Vexcura pays you by check or electronic transfer within 30 days. If it's denied, you're told why, and you can ask for a second review within 14 days."}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does Vexcura guarantee I'll pass the NCLEX?","acceptedAnswer":{"@type":"Answer","text":"No. Vexcura doesn't promise or predict that anyone will pass. What we call the pass guarantee is a fee reimbursement: if you sign the agreement, meet every condition and don't pass your first NCLEX-RN attempt after signing, Vexcura reimburses the registration fee you paid to Pearson VUE, up to $200."}},{"@type":"Question","name":"Is this an NCLEX money-back guarantee?","acceptedAnswer":{"@type":"Answer","text":"Only for the NCLEX registration fee, and only if you qualify. Students don't pay Vexcura anything, because nursing schools license it. So the money you can get back is the NCLEX-RN registration fee you paid to Pearson VUE, up to $200, and only if you meet every condition and don't pass your first attempt after signing."}},{"@type":"Question","name":"How much is reimbursed, and how is it paid?","acceptedAnswer":{"@type":"Answer","text":"The registration fee you personally paid to Pearson VUE for that attempt, up to $200. It's paid to you only, by check or electronic transfer, within 30 days after your claim is approved. You're responsible for any taxes that apply."}},{"@type":"Question","name":"What is the Usage Score?","acceptedAnswer":{"@type":"Answer","text":"A score from 0 to 100 on My Chart that shows how fully you've used Vexcura: full exams, how much of the question bank you've answered, every NCLEX category, missed-question review, study days, study-plan orders and clinical practice. You need 98% or higher, so you can be short by no more than 2 points in total. If your device and Vexcura's records disagree, Vexcura's records count."}},{"@type":"Question","name":"What counts as a Qualifying Exam?","acceptedAnswer":{"@type":"Answer","text":"A full adaptive practice exam taken in your own account in proctored test-day mode. It has to have at least 85 questions, end with a Pass result and have an integrity report that reads Clean. You need 3 of them before your NCLEX."}},{"@type":"Question","name":"Do practice exams I took before signing count?","acceptedAnswer":{"@type":"Answer","text":"Yes. Qualifying Exams count if they were completed before your NCLEX, even if you took them before you signed. The no-integrity-flags condition applies to proctored practice exams taken after you sign."}},{"@type":"Question","name":"What if a proctored practice exam gets a Minor flags or Irregular report?","acceptedAnswer":{"@type":"Answer","text":"Any report other than Clean is an integrity flag. One flag on a proctored practice exam taken after you sign means that condition isn't met, so you won't qualify for reimbursement under that agreement."}},{"@type":"Question","name":"When do I have to sign?","acceptedAnswer":{"@type":"Answer","text":"Before the day of your NCLEX, in My Chart. Reimbursement only covers the first NCLEX-RN attempt you take after signing. If no attempt happens within 12 months of signing, the agreement ends."}},{"@type":"Question","name":"How long do I have to file a claim?","acceptedAnswer":{"@type":"Answer","text":"You have 30 days from the date of your official result to submit your claim in My Chart. After we ask for documents, you have 14 days to send them. Late or incomplete claims are denied."}},{"@type":"Question","name":"Can I read the full agreement before I sign?","acceptedAnswer":{"@type":"Answer","text":"Yes. The full agreement (version 2.1) is in My Chart, and the signature section only unlocks once you scroll to the end. After you sign, you can view, print or save your signed copy any time, and you can withdraw from My Chart whenever you want. If this page and the agreement ever differ, the agreement controls."}},{"@type":"Question","name":"Does it cover the NCLEX-PN or a retake?","acceptedAnswer":{"@type":"Answer","text":"No. It covers only the NCLEX-RN registration fee for the first attempt after you sign. Later attempts, the NCLEX-PN, and licensure, application, background-check and fingerprinting fees aren't covered."}},{"@type":"Question","name":"How do I get Vexcura?","acceptedAnswer":{"@type":"Answer","text":"Through your nursing program. Vexcura is licensed to nursing schools and facilities, and it's free for their students and instructors. If your program doesn't use Vexcura yet, send your faculty to vexcura.com/for-nursing-schools."}}]}</script></head><body class="v26"><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><defs><linearGradient id="sxlW" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:var(--vxa);stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlWr" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxrb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxrc);stop-opacity:1"/></linearGradient><linearGradient id="sxlB" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offset="0" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlBr" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset="1" style="stop-color:var(--vx