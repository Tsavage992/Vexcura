.vx-cmp .vx-us{background:var(--navy);border-color:var(--navy);color:var(--navy-ink)}.vx-cmp .vx-us .amt,.vx-cmp .vx-us b{color:var(--navy-ink)}.vx-cmp .vx-us small{color:var(--navy-ink);opacity:.85}
