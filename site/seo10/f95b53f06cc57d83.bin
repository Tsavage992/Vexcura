.vx-calc fieldset{border:0;padding:0;margin:10px 0 0;display:flex;flex-wrap:wrap;gap:6px 18px}.vx-calc legend{font-size:14.5px;color:var(--muted);margin-bottom:4px;padding:0}.vx-calc fieldset label{font-weight:400;display:inline-flex;gap:6px;align-items:center}
.vx-out{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:10px;margin:14px 0 4px}.vx-out>div{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.vx-out span{display:block;font-size:14px;color:var(--muted)}.vx-out output{display:block;font:700 22px/1.25 var(--fb);font-variant-numeric:tabular-nums}.vx-out small{color:var(--muted)}
