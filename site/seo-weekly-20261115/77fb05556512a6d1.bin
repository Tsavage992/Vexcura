<link rel="stylesheet" href="/s-d5jl2.css"><style>
.hm{--hm-w:920px}.hm-w{max-width:var(--hm-w);margin:0 auto;padding:0 max(20px,env(safe-area-inset-left))}
.hm a.arw{font-weight:600;text-decoration:none;color:var(--accent);white-space:nowrap}.hm a.arw:hover span{margin-left:3px}.hm a.arw span{transition:margin .15s}
.hm a.arw:hover{text-decoration:underline;text-underline-offset:3px}
.hm-hero{text-align:center;padding:84px 0 64px}.hm-hero h1{font:400 clamp(40px,7vw,68px)/1.05 var(--fh);margin:0 auto 22px;max-width:14ch;letter-spacing:-.005em}
.hm-lead{font-size:clamp(18px,2.2vw,21px);line-height:1.55;color:var(--muted);max-width:40em;margin:0 auto 28px}
.hm-go{display:flex;gap:14px 26px;justify-content:center;align-items:center;flex-wrap:wrap;margin:0}.hm-go .btn{padding:13px 22px;font-size:17px;border-radius:999px}
.hm-sub{margin:22px 0 0;color:var(--muted);font-size:15.5px}
.hm-stack{display:grid;gap:0;border-top:1px solid var(--line)}.hm-stack article{padding:38px 0;border-bottom:1px solid var(--line)}
.hm-stack h2{font:400 clamp(27px,3.6vw,38px)/1.15 var(--fh);margin:0 0 10px;max-width:24ch}.hm-stack p{margin:0 0 12px;color:var(--muted);max-width:60ch}
.hm-sw{display:grid;grid-template-columns:auto 1fr;gap:26px;align-items:start;padding-top:64px;padding-bottom:20px}.hm-ic{width:92px;height:92px;border-radius:50%;background:var(--sunk);display:grid;place-items:center;color:var(--accent)}
.hm-sw h2,.hm-hd h2,.hm-promo h2{font:400 clamp(28px,3.6vw,36px)/1.15 var(--fh);margin:0 0 10px}.hm-sw p{margin:0 0 12px;max-width:62ch}
.hm-sec{padding-top:64px}.hm-hd{display:flex;justify-content:space-between;align-items:baseline;gap:8px 20px;flex-wrap:wrap;margin-bottom:22px;border-bottom:1px solid var(--line);padding-bottom:10px}.hm-hd h2{margin:0}
.hm-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
.hm-card h3,.hm-qc h3,.hm-news h3{font:400 22px/1.25 var(--fh);margin:12px 0 6px}.hm-card h3 a,.hm-qc h3 a,.hm-news h3 a{color:var(--ink);text-decoration:none}.hm-card h3 a:hover,.hm-qc h3 a:hover,.hm-news h3 a:hover{text-decoration:underline}
.hm-card p,.hm-news p{color:var(--muted);font-size:15.5px;margin:0 0 10px}
.hm-cv{aspect-ratio:4/3;border-radius:10px;background:linear-gradient(150deg,var(--cv),color-mix(in srgb,var(--cv) 62%,#000));color:#fff;padding:18px 18px 14px;display:flex;flex-direction:column;position:relative;overflow:hidden}
.hm-cv:after{content:"";position:absolute;right:-30px;bottom:-40px;width:150px;height:150px;border-radius:50%;border:22px solid rgba(255,255,255,.08)}
.hm-cv span{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.8}.hm-cv b{font:400 26px/1.15 var(--fh);margin-top:auto;max-width:12ch}.hm-cv i{font-style:normal;font-size:12.5px;opacity:.7;margin-top:10px}
.hm-qc{border:1px solid var(--line);border-radius:10px;padding:18px 18px 16px;background:var(--surface)}.hm-bar{height:8px;border-radius:4px;background:var(--sunk);overflow:hidden}.hm-bar i{display:block;height:100%;background:var(--accent);border-radius:4px}
.hm-k{font-size:13.5px;letter-spacing:.04em;color:var(--muted);margin:10px 0 0}
.hm-list{display:grid;gap:0}.hm-news{padding:20px 0;border-bottom:1px solid var(--line)}.hm-news:first-child{padding-top:0}.hm-news .hm-k{margin:0}
.hm-promo{display:grid;grid-template-columns:240px 1fr;gap:40px;align-items:center;padding-top:72px;padding-bottom:24px}.hm-promo p{max-width:58ch}.hm-promo .hm-k{margin:0 0 10px}
.hm-links{display:flex;gap:10px 28px;flex-wrap:wrap}
.hm-book{position:relative;height:300px}.hm-bk{position:absolute;width:190px;height:260px;border-radius:4px 10px 10px 4px;box-shadow:0 18px 40px -18px rgba(0,0,0,.45)}
.hm-bk.b3{left:44px;top:0;background:#c9a24f}.hm-bk.b2{left:22px;top:14px;background:#7a3b52}.hm-bk.b1{left:0;top:30px;background:linear-gradient(160deg,#1d5670,#103a4f);color:#fff;padding:22px 18px;display:flex;flex-direction:column}
.hm-bk.b1 span{font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.75}.hm-bk.b1 b{font:400 27px/1.12 var(--fh);margin-top:auto}.hm-bk.b1 i{font-style:normal;font-size:12.5px;opacity:.75;margin-top:10px}
@media (max-width:860px){.hm-cards{grid-template-columns:1fr 1fr}.hm-promo{grid-template-columns:1fr;gap:18px}.hm-book{height:290px;max-width:240px}}
@media (max-width:600px){.hm-hero{padding:56px 0 44px}.hm-cards{grid-template-columns:1fr}.hm-sw{grid-template-columns:1fr;gap:14px}.hm-ic{width:72px;height:72px}.hm-ic svg{width:48px;height:48px}.hm-stack article{padding:28px 0}}
