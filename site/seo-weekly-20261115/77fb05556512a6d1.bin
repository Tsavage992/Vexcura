ription":"Any size; the program chooses the number of seats (per student seat), per year. Every plan includes every feature. Students and instructors are free.","price":"199","priceCurrency":"USD","category":"Institutional license"},{"@type":"Offer","name":"Vexcura Site 100","description":"Up to 100 students, per year. Every plan includes every feature. Students and instructors are free.","price":"15000","priceCurrency":"USD","category":"Institutional license"},{"@type":"Offer","name":"Vexcura Site 250","description":"101 to 250 students, per year. Every plan includes every feature. Students and instructors are free.","price":"30000","priceCurrency":"USD","category":"Institutional license"},{"@type":"Offer","name":"Vexcura Site 500","description":"251 to 500 students, per year. Every plan includes every feature. Students and instructors are free.","price":"50000","priceCurrency":"USD","category":"Institutional license"}],"screenshot":["https://vexcura.com/img/exam-q-1600.webp","https://vexcura.com/img/exam-results-1600.webp","https://vexcura.com/img/d-mar-1600.webp"],"publisher":{"@id":"https://vexcura.com/#org"}}]}</script></head><body><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><defs><linearGradient id="sxlW" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:var(--vxa);stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlWr" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxrb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxrc);stop-opacity:1"/></linearGradient><linearGradient id="sxlB" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offse