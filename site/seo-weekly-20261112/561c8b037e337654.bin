<link rel="stylesheet" href="/s-18v2lq.css"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://vexcura.com/"},{"@type":"ListItem","position":2,"name":"Kaplan score report study plan","item":"https://vexcura.com/kaplan-score-report-study-plan"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"HowTo","name":"How to turn your Kaplan score report into an NCLEX study plan in Vexcura","step":[{"@type":"HowToStep","position":1,"name":"Open Bring your scores","text":"Sign in to Vexcura and choose Bring your scores from My Chart (Summary), Results (Exams) or the Menu.","url":"https://vexcura.com/kaplan-score-report-study-plan#how"},{"@type":"HowToStep","position":2,"name":"Choose who made the test","text":"Pick ATI, HESI, Kaplan, UWorld or another test maker. Vexcura only uses the name to label your result.","url":"https://vexcura.com/kaplan-score-report-study-plan#how"},{"@type":"HowToStep","position":3,"name":"Bring in the report","text":"Upload the score report PDF, take a photo of it, or type the results. A PDF is read in your own browser. A photo stays on your screen beside the form so you can type from it; Vexcura doesn't read text from photos.","url":"https://vexcura.com/kaplan-score-report-study-plan#how"},{"@type":"HowToStep","position":4,"name":"Check what Vexcura found","text":"Confirm the test name, date, overall score or proficiency level, and each topic to review. Every topic is matched to a Vexcura study topic under one of the 8 NCLEX-RN client needs categories, and Vexcura asks you to pick when a match is uncertain. Fix anything that's wrong before you save.","url":"https://vexcura.com/kaplan-score-report-study-plan#how"},{"@type":"HowToStep","position":5,"name":"Get your study plan","text":"Targeted topic drills, study guides, EHR practice where a topic has a matching clinical activity, and a checkpoint quiz go on your Vexcura worklist, starting today.","url":"https://vexcura.com/kaplan-score-report-study-plan#how"},{"@type":"HowToStep","position":6,"name":"Add your next score","text":"When you take the next test, add it the same way. Vexcura shows the new result next to the previous one, along with your practice accuracy in your weak topics.","url":"https://vexcura.com/kaplan-score-report-study-plan#how"}],"description":"Bring an outside score report (Kaplan) into Vexcura and get a study plan built from the topics it lists. Takes about a minute.","totalTime":"PT2M","tool":[{"@type":"HowToTool","name":"Your score report (PDF, photo, or the printed results)"}],"url":"https://vexcura.com/kaplan-score-report-study-plan"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which Kaplan tests can I bring in?","acceptedAnswer":{"@type":"Answer","text":"Any Kaplan result you can see as a report or type in, such as an Integrated test or a predictor. Vexcura saves the test name you enter, the date, the overall result and the topics or areas flagged."}},{"@type":"Question","name":"Does Vexcura need my Kaplan login?","acceptedAnswer":{"@type":"Answer","text":"No. Vexcura never asks for your Kaplan username or password, and its server refuses requests that contain login fields. Upload the report, take a photo to type from, or type the results in."}},{"@type":"Question","name":"Is my report uploaded?","acceptedAnswer":{"@type":"Answer","text":"No, not unless you tick \"Keep a copy\", which is off by default. A PDF is read in your own browser, and only the details you confirm are saved: the test name, date, overall result and topic names with their scores."}},{"@type":"Question","name":"Does this replace Kaplan or my program's remediation?","acceptedAnswer":{"@type":"Answer","text":"No. Vexcura doesn't give, score or replace Kaplan exams or materials. Do what your program requires first; Vexcura adds practice on the topics your report lists."}},{"@type":"Question","name":"How much does it cost?","acceptedAnswer":{"@type":"Answer","text":"Nothing for students. Vexcura is licensed to nursing schools, and students and instructors use it free through their school."}}]}</script></head><body><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><style>@property --vxa{syntax:"<color>";inherits:true;initial-value:#4b4f86}@property --vxb{syntax:"<color>";inherits:true;initial-value:#d77a6a}@property --vxc{syntax:"<color>";inherits:true;initial-value:#f8c27a}@property --vxrb{syntax:"<color>";inherits:true;initial-value:#f8c27a}@property --vxrc{syntax:"<color>";inherits:true;initial-value:#d77a6a}:root{--vxa:#4b4f86;--vxb:#d77a6a;--vxc:#f8c27a;--vxrb:#f8c27a;--vxrc:#d77a6a;transition:--vxa 4s ease,--vxb 4s ease,--vxc 4s ease,--vxrb 4s ease,--vxrc 4s ease}html[data-vxscene="dawn"]{--vxa:#7e6a8e;--vxb:#d9826f;--vxc:#eaa874;--vxrb:#fbd3c0;--vxrc:#f2a98e}html[data-vxscene="morning"]{--vxa:#1d5670;--vxb:#3f8fae;--vxc:#e2a648;--vxrb:#bfe3f1;--vxrc:#ffe2a0}html[data-vxscene="midday"]{--vxa:#1d5670;--vxb:#2f85a8;--vxc:#56acd3;--vxrb:#a9dcf1;--vxrc:#6fbfe6}html[data-vxscene="afternoon"]{--vxa:#356f8f;--vxb:#c99a3e;--vxc:#b8642c;--vxrb:#f6e2bc;--vxrc:#e8b45a}html[data-vxscene="sunset"]{--vxa:#4b4f86;--vxb:#d77a6a;--vxc:#f8c27a;--vxrb:#f8c27a;--vxrc:#d77a6a}html[data-vxscene="night"]{--vxa:#1d3557;--vxb:#4b6a9a;--vxc:#d9b25a;--vxrb:#c9d6ea;--vxrc:#ffd77a}@media (prefers-reduced-motion:reduce){:root{transition:none}}</style><script>(function(){var h=new Date().getHours(),k=h<5?"night":h<8?"dawn":h<11?"morning":h<14?"midday":h<17?"afternoon":h<20?"sunset":"night";document.documentElement.setAttribute("data-vxscene",k)})()</script><defs><linearGradient id="sxrW" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:var(--vxa);stop-opacity:1"/