if(i.checked)li.classList.add("no");if(i.checked){pick++;if(c)right++;else bad++}});ok=pick>0&&bad===0&&right===q.querySelectorAll('li[data-c="1"]').length;if(!pick)ok=null}var r=q.querySelector(".res");if(ok===null){r.textContent="Choose an answer first.";r.className="res";return}r.textContent=ok?"Correct.":"Not quite. Review the rationale below.";r.className="res "+(ok?"ok":"no");var d=q.querySelector("details");if(d)d.open=true;try{navigator.sendBeacon&&0}catch(e){}}document.addEventListener("click",function(e){var b=e.target.closest(".chk");if(b){e.preventDefault();f(b.closest(".q"))}var s=e.target.closest("[data-share]");if(s){e.preventDefault();var u=location.href.split("?")[0],tt=document.title;if(navigator.share){navigator.share({title:tt,url:u}).catch(function(){})}else if(navigator.clipboard){navigator.clipboard.writeText(u).then(function(){s.textContent="Link copied"})}}});if(/[?&]daily=1/.test(location.search)){var d=document.querySelector(".daily");if(d)d.style.display="block"}})();</script><script src="/vxs-1bt75x.js" defer></script><script>(function(){try{var k="vx.src",q=new URLSearchParams(location.search),u={us:q.get("utm_source")||"",um:q.get("utm_medium")||"",uc:q.get("utm_campaign")||""},o=null;try{o=JSON.parse(localStorage.getItem(k)||"null")}catch(e){}if(!o||(!o.us&&u.us)){var r="";try{r=document.referrer?new URL(document.referrer).hostname:""}catch(e){}if(r===location.hostname)r="";localStorage.setItem(k,JSON.stringify({lp:location.pathname,ref:r,us:u.us,um:u.um,uc:u.uc,at:Date.now()}))}}catch(e){}document.addEventListener("click",function(e){var a=e.target.closest&&e.target.closest("[data-cta]");if(a)try{sessionStorage.setItem("vx.cta",a.getAttribute("data-cta")+"@"+location.pathname)}catch(x){}})})();</script></body></html>