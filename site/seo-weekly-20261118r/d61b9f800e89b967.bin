</style><script type="application/ld+json">{"@context":"https://schema.org","@type":"Quiz","name":"Management of Care NCLEX practice questions","url":"https://vexcura.com/nclex-practice-questions/management-of-care","about":{"@type":"Thing","name":"NCLEX-RN"},"educationalLevel":"Nursing licensure exam preparation","inLanguage":"en-US","isAccessibleForFree":true,"hasPart":[{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which client care task can the RN delegate to an LPN?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-009","acceptedAnswer":{"@type":"Answer","text":"Administering a scheduled oral antibiotic to a stable client","answerExplanation":{"@type":"Comment","text":"LPNs can give scheduled medications to stable clients. First-dose IV drugs for new admissions, care planning, and triage require RN assessment and judgment."}},"suggestedAnswer":[{"@type":"Answer","text":"Giving the first dose of IV vancomycin to a newly admitted client"},{"@type":"Answer","text":"Triaging clients who walk into the clinic"},{"@type":"Answer","text":"Developing the plan of care for a client with new heart failure"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which client should the nurse in the psychiatric unit see first?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-004","acceptedAnswer":{"@type":"Answer","text":"A client who says the voices are telling him to hurt his roommate","answerExplanation":{"@type":"Comment","text":"Command hallucinations directing harm to others are a safety emergency. The other clients have needs but no immediate danger."}},"suggestedAnswer":[{"@type":"Answer","text":"A client who refuses to attend group therapy"},{"@type":"Answer","text":"A client with depression who is tearful after a phone call"},{"@type":"Answer","text":"A client asking for a snack"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which client should the nurse in a pediatric clinic see first?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-005","acceptedAnswer":{"@type":"Answer","text":"A 3-year-old who is drooling, sitting forward, and has muffled speech","answerExplanation":{"@type":"Comment","text":"Drooling, tripod positioning, and a muffled voice suggest epiglottitis or another upper airway obstruction, an emergency."}},"suggestedAnswer":[{"@type":"Answer","text":"A 7-year-old needing a school physical"},{"@type":"Answer","text":"A 5-year-old with an ear infection and a temperature of 101°F (38.3°C)"},{"@type":"Answer","text":"A 2-year-old with a diaper rash"}]},{"@type":"Question","eduQuestionType":"Checkbox","text":"The RN is caring for clients with an LPN and AP. Which tasks are appropriate to delegate to the AP? Select all that apply.","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-011","acceptedAnswer":[{"@type":"Answer","text":"Helping a client with a hip fracture use the bedpan","answerExplanation":{"@type":"Comment","text":"Routine measurements, toileting help, and recording intake are within the AP role for stable clients. Monitoring response to a first opioid dose and teaching require nursing assessment."}},{"@type":"Answer","text":"Recording a client's food intake","answerExplanation":{"@type":"Comment","text":"Routine measurements, toileting help, and recording intake are within the AP role for stable clients. Monitoring response to a first opioid dose and teaching require nursing assessment."}},{"@type":"Answer","text":"Measuring vital signs on a stable client after a cholecystectomy","answerExplanation":{"@type":"Comment","text":"Routine measurements, toileting help, and recording intake are within the AP role for stable clients. Monitoring response to a first opioid dose and teaching require nursing assessment."}}],"suggestedAnswer":[{"@type":"Answer","text":"Teaching a client to use an insulin pen"},{"@type":"Answer","text":"Monitoring a client who just received the first dose of a new opioid"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which event is considered a sentinel event?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-019","acceptedAnswer":{"@type":"Answer","text":"A client dies after receiving an incompatible blood transfusion","answerExplanation":{"@type":"Comment","text":"A sentinel event is a client safety event resulting in death, permanent harm, or severe temporary harm. Hemolytic transfusion reactions involving major blood group incompatibility are on The Joint Commission list."}},"suggestedAnswer":[{"@type":"Answer","text":"A client's IV infiltrates without injury"},{"@type":"Answer","text":"A client has mild nausea after a new medication"},{"@type":"Answer","text":"A client refuses breakfast"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Which client in a long-term care facility should the nurse see first?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-006","acceptedAnswer":{"@type":"Answer","text":"A resident with a new onset of confusion and a temperature of 100.8°F (38.2°C)","answerExplanation":{"@type":"Comment","text":"Acute confusion with fever in an older adult may signal sepsis or another acute illness and needs prompt assessment."}},"suggestedAnswer":[{"@type":"Answer","text":"A resident whose family wants an update on weight"},{"@type":"Answer","text":"A resident who wants to change rooms"},{"@type":"Answer","text":"A resident with chronic knee pain asking for a scheduled analgesic"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Under Medicare, which client is most likely to qualify for home health services?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-018","acceptedAnswer":{"@type":"Answer","text":"A homebound client who needs skilled nursing for wound care","answerExplanation":{"@type":"Comment","text":"Medicare home health requires that the client be homebound and need intermittent skilled services such as nursing or therapy under a plan of care."}},"suggestedAnswer":[{"@type":"Answer","text":"A client who needs only meal delivery"},{"@type":"Answer","text":"A client who needs only transportation to appointments"},{"@type":"Answer","text":"A client who drives to work daily and wants help with cleaning"}]},{"@type":"Question","eduQuestionType":"Multiple choice","text":"Four clients have new lab results. Which result requires immediate action?","url":"https://vexcura.com/nclex-practice-questions/management-of-care#moc4-007","acceptedAnswer":{"@type":"Answer","text":"Glucose of 42 mg/dL in a client receiving insulin","answerExplanation":{"@type":"Comment","text":"Severe hypoglycemia can cause seizures and brain injury and needs immediate treatment. The others need follow-up but aren't emergencies; an INR of 2.6 is therapeutic for atrial fibrillation."}},"suggestedAnswer":[{"@type":"Answer","text":"Cholesterol of 238 mg/dL in a client on a statin"},{"@type":"Answer","text":"INR of 2.6 in a client taking warfarin for atrial fibrillation"},{"@type":"Answer","text":"Hemoglobin A1C of 7.8% in a client with type 2 diabetes"}]}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://vexcura.com/"},{"@type":"ListItem","position":2,"name":"Practice questions","item":"https://vexcura.com/nclex-practice-questions"},{"@type":"ListItem","position":3,"name":"Management of Care","item":"https://vexcura.com/nclex-practice-questions/management-of-care"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Management of Care the largest NCLEX-RN category?","acceptedAnswer":{"@type":"Answer","text":"Yes. It's 15% to 21% of the exam in the 2026 test plan, the highest of the 8 categories."}},{"@type":"Question","name":"How many Management of Care questions are on the NCLEX-RN?","acceptedAnswer":{"@type":"Answer","text":"About 13 to 18 on an 85-question exam, and about 23 to 32 on a 150-question exam."}},{"@type":"Question","name":"Is it the most failed NCLEX category?","acceptedAnswer":{"@type":"Answer","text":"No one knows for sure. NCSBN doesn't publish failure rates by category. It is the largest category, so it deserves the most study time."}},{"@type":"Question","name":"What does it cover?","acceptedAnswer":{"@type":"Answer","text":"Prioritizing, delegation, assignment, advocacy, handoffs, teamwork, referrals, consent, advance directives, confidentiality, and legal and ethical rights."}}]}</script></head><body class="v26"><header class="top"><div class="w"><a class="brand" href="/" aria-label="Vexcura home"><svg class="vxw" viewBox="-2 -86 472 96" aria-hidden="true"><defs><linearGradient id="sxlW" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:var(--vxa);stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlWr" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="227.0" y2="0"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset=".5" style="stop-color:var(--vxrb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxrc);stop-opacity:1"/></linearGradient><linearGradient id="sxlB" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offset="0" style="stop-color:var(--vxb);stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxc);stop-opacity:1"/></linearGradient><linearGradient id="sxlBr" gradientUnits="userSpaceOnUse" x1="16" y1="-72" x2="27" y2="4"><stop offset="0" style="stop-color:#ffffff;stop-opacity:1"/><stop offset="1" style="stop-color:var(--vxrc);stop-opacity:1"/></linearGradient><linearGradient id="sxlF" gradientUnits="userSpaceOn