 for(var i=0;i<=CST.i&&i<N;i++){var S=C.stages[i],Q=S.q,P=S._p||[],multi=Q.type==="multi";
  h+='<div class="cs-st" id="cs-st-'+i+'"><p class="cs-l">Stage '+(i+1)+' of '+N+(S.label?" · "+esc(S.label.replace(/^stage [0-9]+ *[:.–-]? */i,"")):"")+'</p><p>'+esc(S.story)+'</p>';
  if(S.data&&S.data.length)h+='<ul class="cs-d">'+S.data.map(function(x){return '<li><b>'+esc(x[0])+'</b> '+esc(x[1])+'</li>'}).join("")+'</ul>';
  h+='<p class="cs-q">'+esc(Q.stem)+(multi&&String(Q.stem).toLowerCase().indexOf("select all")<0?' <span>Select all that apply.</span>':'')+'</p><div class="cs-o" role="group">'+Q.options.map(function(o,k){var on=P.indexOf(k)>=0,cl=S._done?(Q.answer.indexOf(k)>=0?"ok":on?"bad":""):on?"on":"";return '<button type="button" data-o="'+k+'" class="'+cl+'"'+(S._done?" disabled":"")+' aria-pressed="'+on+'">'+esc(o)+'</button>'}).join("")+'</div>';
  if(!S._done)h+='<p><button type="button" class="cs-go" data-cs="check"'+(P.length?"":" disabled")+'>Check answer</button></p>';
  else{h+='<p class="cs-why"><b>'+(S._ok?"Correct.":"Not quite.")+'</b> '+esc(String(Q.why).split("**").join("").replace(/ ?[(]sources? [0-9, and]+[)]/gi,""))+csSrc(Q.src)+'</p>';if(i===CST.i&&i<N-1)h+='<p><button type="button" class="cs-go" data-cs="next">Next stage</button></p>'}
  h+='</div>'}
 var last=C.stages[N-1];if(CST.i===N-1&&last._done)h+='<div class="cs-end"><p class="cs-sc">You got '+CST.sc+' of '+N+' right.</p>'+(C.teach?'<p><b>Takeaway:</b> '+esc(C.teach)+'</p>':'')+'<p class="cs-btns"><button type="button" class="cs-go" data-cs="again">Build another case</button><a class="btn" href="/app#signup" data-cta="ask-case-signup">Practice full cases in the EHR, free</a></p></div>';
 h+='<p class="ai-lab">An AI-built practice case about a made-up client, written from Vexcura’s study guides and NIH sources and checked by a second AI pass. It can still be wrong: check the linked sources. No medication doses. Not medical advice. Nothing you answer here is saved.</p>';c.innerHTML=h}
